        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How dark a wallpaper or live background is: dim evenly, bright on the right away from the text, or bright everywhere."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto scurire uno sfondo statico o animato: in modo uniforme, lasciando luminoso il lato destro lontano dal testo oppure lasciando tutto luminoso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’assombrissement d’un fond d’écran ou d’un arrière-plan animé : sombre uniformément, clair à droite loin du texte, ou clair partout."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie dunkel ein Hintergrundbild oder Live-Hintergrund ist: gleichmäßig abgedunkelt, rechts abseits vom Text hell oder überall hell."
