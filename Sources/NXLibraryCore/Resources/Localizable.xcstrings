            "value": "Dieses Spiel verwendet einen eigenen Spielstandort. Verwalte ihn außerhalb dieses Bereichs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este juego usa una ubicación personalizada para las partidas guardadas. Gestiónala fuera de este panel."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este jogo usa um local personalizado de dados salvos. Gerencie-o fora deste painel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此游戏使用自定义的存档位置。请在此面板之外管理。"
          }
        }
      }
    },
    "This is the game": {
      "comment": "DetailsBands.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the game"
          }
        },
        "it": {
          "stringUnit": {
