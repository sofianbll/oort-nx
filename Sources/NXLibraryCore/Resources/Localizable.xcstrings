    "The engine's profile does not match these files": {
      "comment": "PortingFailureReason.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The engine's profile does not match these files"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il profilo del motore non corrisponde a questi file"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le profil du moteur ne correspond pas à ces fichiers"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Profil der Engine passt nicht zu diesen Dateien"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El perfil del motor no coincide con estos archivos"
          }
        },
        "pt-BR": {
