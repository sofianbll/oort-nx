    }},
    "The primary user and device saves and their copies in the chosen folder.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"The primary user and device saves and their copies in the chosen folder."}}, "fr": {"stringUnit":{"state":"translated","value":"Sauvegardes de l’utilisateur principal et de l’appareil, et leurs copies dans le dossier choisi."}}, "it": {"stringUnit":{"state":"translated","value":"Salvataggi dell’utente principale e del dispositivo, e loro copie nella cartella scelta."}}, "de": {"stringUnit":{"state":"translated","value":"Spielstände des Hauptbenutzers und Geräts sowie deren Kopien im gewählten Ordner."}}, "es": {"stringUnit":{"state":"translated","value":"Partidas del usuario principal y del dispositivo, y sus copias en la carpeta elegida."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Dados salvos do usuário principal e do dispositivo, e suas cópias na pasta escolhida."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"主要用户存档、设备存档及其在所选文件夹中的副本。"}}
    }},
    "The engine reads and writes save copies in that folder, separate from game archives.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"The engine reads and writes save copies in that folder, separate from game archives."}}, "fr": {"stringUnit":{"state":"translated","value":"Le moteur lit et écrit des copies des sauvegardes dans ce dossier, à part des archives de jeux."}}, "it": {"stringUnit":{"state":"translated","value":"Il motore legge e scrive le copie dei salvataggi in quella cartella, separata dagli archivi di gioco."}}, "de": {"stringUnit":{"state":"translated","value":"Die Engine liest und schreibt Spielstandkopien in diesem Ordner, getrennt von Spielearchiven."}}, "es": {"stringUnit":{"state":"translated","value":"El motor lee y escribe copias de partidas en esa carpeta, separada de los archivos de juegos."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"O motor lê e grava cópias dos dados salvos nessa pasta, separadas dos arquivos de jogos."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"引擎在该文件夹中读写存档副本，与游戏归档分开。"}}
    }},
    "macOS handles iCloud Drive sync; another folder depends on its sync client.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"macOS handles iCloud Drive sync; another folder depends on its sync client."}}, "fr": {"stringUnit":{"state":"translated","value":"macOS gère la synchronisation d’iCloud Drive ; pour un autre dossier, cela dépend de son logiciel de synchronisation."}}, "it": {"stringUnit":{"state":"translated","value":"macOS gestisce la sincronizzazione di iCloud Drive; le altre cartelle dipendono dal proprio client di sincronizzazione."}}, "de": {"stringUnit":{"state":"translated","value":"macOS übernimmt den iCloud-Drive-Abgleich; andere Ordner hängen vom jeweiligen Sync-Client ab."}}, "es": {"stringUnit":{"state":"translated","value":"macOS gestiona la sincronización de iCloud Drive; otra carpeta depende de su cliente de sincronización."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"O macOS gerencia a sincronização do iCloud Drive; outra pasta depende de seu cliente de sincronização."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"macOS 负责同步 iCloud Drive，其他文件夹则取决于其同步客户端。"}}
    }},
