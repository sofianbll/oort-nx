    "Arcane is personal software released under the MIT license. nxnative, Ryujinx, SPIR-V Cross, LibHac and the other dependencies retain their own licenses through the engine.": {
      "comment": "SettingsAboutSection.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arcane is personal software released under the MIT license. nxnative, Ryujinx, SPIR-V Cross, LibHac and the other dependencies retain their own licenses through the engine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Arcane è un software personale distribuito con licenza MIT. nxnative, Ryujinx, SPIR-V Cross, LibHac e le altre dipendenze mantengono le proprie licenze tramite il motore."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arcane est un logiciel personnel publié sous licence MIT. nxnative, Ryujinx, SPIR-V Cross, LibHac et les autres dépendances conservent leurs propres licences via le moteur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arcane ist persönliche Software unter der MIT-Lizenz. nxnative, Ryujinx, SPIR-V Cross, LibHac und die übrigen Abhängigkeiten behalten über die Engine ihre eigenen Lizenzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arcane es software personal distribuido bajo la licencia MIT. nxnative, Ryujinx, SPIR-V Cross, LibHac y las demás dependencias conservan sus propias licencias a través del motor."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Arcane é um software pessoal disponibilizado sob a licença MIT. nxnative, Ryujinx, SPIR-V Cross, LibHac e as demais dependências mantêm suas próprias licenças por meio da engine."
          }
        },
        "zh-Hans": {
          "stringUnit": {
