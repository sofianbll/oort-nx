      "en": {"stringUnit":{"state":"translated","value":"Every controller plays for the selected profile."}}, "fr": {"stringUnit":{"state":"translated","value":"Toutes les manettes jouent pour le profil choisi."}}, "it": {"stringUnit":{"state":"translated","value":"Tutti i controller giocano per il profilo scelto."}}, "de": {"stringUnit":{"state":"translated","value":"Alle Controller spielen für das ausgewählte Profil."}}, "es": {"stringUnit":{"state":"translated","value":"Todos los mandos juegan con el perfil seleccionado."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Todos os controles jogam pelo perfil escolhido."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"所有手柄均由选定的个人资料使用。"}}
    }},
