          "stringUnit": {
            "state": "translated",
            "value": "引擎的游戏配置与这些文件不匹配"
          }
        }
      }
    },
    "The engine's profile for %@ expects other shaders than these files hold: either they are another version or update than the one the profile supports, or the engine now reads them differently and the profile is not updated yet.": {
      "comment": "PortingFailureReason.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The engine's profile for %@ expects other shaders than these files hold: either they are another version or update than the one the profile supports, or the engine now reads them differently and the profile is not updated yet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il profilo del motore per %@ si aspetta shader diversi da quelli di questi file: o sono un'altra versione o un altro update rispetto a quelli supportati dal profilo, o il motore ora li legge in modo diverso e il profilo non è ancora aggiornato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le profil du moteur pour %@ attend d’autres shaders que ceux de ces fichiers : soit ce sont une autre version ou une autre mise à jour que celle prise en charge par le profil, soit le moteur les lit désormais autrement et le profil n’est pas encore à jour."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Profil der Engine für %@ erwartet andere Shader, als diese Dateien enthalten: Entweder sind es eine andere Version oder ein anderes Update als vom Profil unterstützt, oder die Engine liest sie jetzt anders und das Profil ist noch nicht aktualisiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El perfil del motor para %@ espera otros shaders que los de estos archivos: o son otra versión o actualización distinta de la que admite el perfil, o el motor ahora los lee de otra forma y el perfil aún no está actualizado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O perfil da engine para %@ espera outros shaders além dos destes arquivos: ou eles são outra versão ou atualização diferente da que o perfil suporta, ou a engine agora os lê de outro jeito e o perfil ainda não foi atualizado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "引擎为 %@ 准备的游戏配置所需的着色器与这些文件不同：要么这些文件的版本或更新与配置支持的不同，要么引擎现在以不同方式读取它们，而配置尚未更新。"
          }
        }
      }
    },
    "The library's tiles fly in with the boot sound when the app opens.": {
      "comment": "SettingsCatalog.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The library's tiles fly in with the boot sound when the app opens."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "All’apertura dell’app le tessere della libreria entrano in volo, con il suono di avvio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À l’ouverture de l’app, les tuiles de la bibliothèque arrivent en vol, avec le son de démarrage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Öffnen der App fliegen die Kacheln der Bibliothek mit dem Startklang herein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al abrir la app, los mosaicos de la biblioteca entran volando con el sonido de arranque."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao abrir o app, os blocos da biblioteca entram voando com o som de inicialização."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 App 时，游戏库的磁贴会随开机音效飞入。"
          }
        }
      }
    },
    "The selected NUP program no longer matches this game. Choose the source again.": {
      "comment": "NUP program identity or local multiuser save scope; cloud still covers the primary user and device only.",
      "localizations": {
        "en": {
