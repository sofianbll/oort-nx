    "Dim applies an even shade; Bright on the right keeps the left dim for text.": {
      "comment": "SettingsLookSection.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dim applies an even shade; Bright on the right keeps the left dim for text."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scuro applica un’ombreggiatura uniforme; Luminoso a destra mantiene scura la parte sinistra per il testo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sombre applique un voile uniforme ; Clair à droite garde la gauche sombre pour le texte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Abgedunkelt“ dunkelt gleichmäßig ab; „Rechts hell“ lässt die linke Seite für Text dunkel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenue aplica una sombra uniforme; Brillo a la derecha mantiene el lado izquierdo oscuro para el texto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escurecido aplica uma sombra uniforme; Claro à direita mantém o lado esquerdo escuro para o texto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“暗淡”均匀加深；“右侧明亮”让左侧保持暗淡以便阅读文字。"
          }
        }
      }
    },
