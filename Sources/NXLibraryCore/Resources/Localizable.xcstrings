    "Arcane could not run rclone. Choose a working rclone executable.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Arcane could not run rclone. Choose a working rclone executable."}},
        "it": {"stringUnit": {"state": "translated", "value": "Arcane non ha potuto avviare rclone. Scegli un eseguibile funzionante."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Arcane n’a pas pu lancer rclone. Choisissez un exécutable rclone valide."}},
        "de": {"stringUnit": {"state": "translated", "value": "Arcane konnte rclone nicht starten. Wähle ein funktionsfähiges rclone-Programm."}},
        "es": {"stringUnit": {"state": "translated", "value": "Arcane no pudo ejecutar rclone. Elige un ejecutable que funcione."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "O Arcane não conseguiu iniciar o rclone. Escolha um executável válido."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "Arcane 无法运行 rclone。请选择可正常运行的 rclone 可执行文件。"}}
      }
    },
    "Arcane could not read the rclone configuration. Check access to the login keychain and try again.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Arcane could not read the rclone configuration. Check access to the login keychain and try again."}},
        "it": {"stringUnit": {"state": "translated", "value": "Arcane non ha potuto leggere la configurazione di rclone. Verifica l'accesso al portachiavi di login e riprova."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Arcane n’a pas pu lire la configuration rclone. Vérifiez l’accès au trousseau de session, puis réessayez."}},
        "de": {"stringUnit": {"state": "translated", "value": "Arcane konnte die rclone-Konfiguration nicht lesen. Prüfe den Zugriff auf den Anmeldeschlüsselbund und versuche es erneut."}},
        "es": {"stringUnit": {"state": "translated", "value": "Arcane no pudo leer la configuración de rclone. Comprueba el acceso al llavero de inicio de sesión y vuelve a intentarlo."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "O Arcane não conseguiu ler a configuração do rclone. Verifique o acesso às Chaves de início de sessão e tente novamente."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "Arcane 无法读取 rclone 配置。请检查登录钥匙串的访问权限后重试。"}}
      }
    },
    "Arcane could not encrypt the rclone configuration with the login keychain.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Arcane could not encrypt the rclone configuration with the login keychain."}},
        "it": {"stringUnit": {"state": "translated", "value": "Arcane non ha potuto cifrare la configurazione di rclone con il portachiavi di login."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Arcane n’a pas pu chiffrer la configuration rclone à l’aide du trousseau de session."}},
        "de": {"stringUnit": {"state": "translated", "value": "Arcane konnte die rclone-Konfiguration nicht mit dem Anmeldeschlüsselbund verschlüsseln."}},
        "es": {"stringUnit": {"state": "translated", "value": "Arcane no pudo cifrar la configuración de rclone con el llavero de inicio de sesión."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "O Arcane não conseguiu criptografar a configuração do rclone usando as Chaves de início de sessão."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "Arcane 无法使用登录钥匙串加密 rclone 配置。"}}
      }
    },
    "Google Drive could not be connected. Check your credentials and try again.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Google Drive could not be connected. Check your credentials and try again."}},
        "it": {"stringUnit": {"state": "translated", "value": "Impossibile collegare Google Drive. Verifica le credenziali e riprova."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Impossible de connecter Google Drive. Vérifiez vos identifiants, puis réessayez."}},
        "de": {"stringUnit": {"state": "translated", "value": "Google Drive konnte nicht verbunden werden. Prüfe deine Zugangsdaten und versuche es erneut."}},
        "es": {"stringUnit": {"state": "translated", "value": "No se pudo conectar Google Drive. Comprueba tus credenciales y vuelve a intentarlo."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Não foi possível conectar o Google Drive. Verifique suas credenciais e tente novamente."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法连接 Google Drive。请检查凭据后重试。"}}
      }
    },
    "Arcane could not list the cloud folder. Check the folder name and your access.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Arcane could not list the cloud folder. Check the folder name and your access."}},
        "it": {"stringUnit": {"state": "translated", "value": "Arcane non ha potuto leggere la cartella nel cloud. Verifica il nome della cartella e i permessi."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Arcane n’a pas pu lire le dossier dans le cloud. Vérifiez son nom et vos droits d’accès."}},
        "de": {"stringUnit": {"state": "translated", "value": "Arcane konnte den Cloud-Ordner nicht auflisten. Prüfe den Ordnernamen und deine Zugriffsrechte."}},
        "es": {"stringUnit": {"state": "translated", "value": "Arcane no pudo leer la carpeta en la nube. Comprueba el nombre y tus permisos."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "O Arcane não conseguiu listar a pasta na nuvem. Verifique o nome da pasta e suas permissões."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "Arcane 无法列出云端文件夹的内容。请检查文件夹名称和访问权限。"}}
      }
    },
