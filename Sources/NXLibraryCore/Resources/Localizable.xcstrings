            "value": "La cartella sviluppatore selezionata è quella dei Command Line Tools, che non possono compilare l’app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier de développement sélectionné est celui des Command Line Tools, qui ne permettent pas de compiler l’app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als Entwicklerordner sind die Command Line Tools ausgewählt. Damit lässt sich die App nicht erstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta de desarrollo seleccionada es la de Command Line Tools, que no permite compilar la app."
          }
