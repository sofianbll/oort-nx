          "stringUnit": {
            "state": "translated",
            "value": "此备份会恢复所有本地用户及其注册信息。"
          }
        }
      }
    },
    "This older backup restores only the primary user and device save. Other local users will be kept.": {
      "comment": "NUP program identity or local multiuser save scope; cloud still covers the primary user and device only.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This older backup restores only the primary user and device save. Other local users will be kept."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo vecchio backup ripristina solo i salvataggi dell’utente principale e del dispositivo. Gli altri utenti locali verranno conservati."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette ancienne sauvegarde ne restaure que l’utilisateur principal et la sauvegarde de l’appareil. Les autres utilisateurs locaux seront conservés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses ältere Backup stellt nur den Hauptbenutzer- und den Gerätespielstand wieder her. Andere lokale Benutzer bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta copia antigua solo restaura las partidas del usuario principal y del dispositivo. Los demás usuarios locales se conservarán."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este backup antigo restaura apenas os salvamentos do usuário principal e do dispositivo. Os outros usuários locais serão mantidos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此旧版备份仅恢复主用户和设备存档。其他本地用户会保留。"
          }
        }
      }
    },
