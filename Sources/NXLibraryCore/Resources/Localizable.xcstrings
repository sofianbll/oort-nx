          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un fichier de codes de triche .txt, ou un dossier organisé comme une carte SD. Vous pouvez aussi les déposer ici."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine .txt-Cheat-Datei oder ein Ordner mit SD-Kartenstruktur. Du kannst sie auch hier ablegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un archivo de trucos .txt o una carpeta con la estructura de una tarjeta SD. También puedes arrastrarlos aquí."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um arquivo de trapaças .txt ou uma pasta com a estrutura de um cartão SD. Você também pode soltá-los aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个 .txt 金手指文件，或采用 SD 卡结构的文件夹。也可以直接拖到这里。"
          }
        }
      }
    },
