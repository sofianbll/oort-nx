    "Download %@ from your cloud and replace %@ on this Mac? The previous app will be kept.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Download %@ from your cloud and replace %@ on this Mac? The previous app will be kept."}},
        "it": {"stringUnit": {"state": "translated", "value": "Scaricare %1$@ dal cloud personale e sostituire %2$@ su questo Mac? L’app precedente verrà conservata."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Télécharger %1$@ depuis votre cloud et remplacer %2$@ sur ce Mac ? L’app précédente sera conservée."}},
        "de": {"stringUnit": {"state": "translated", "value": "%1$@ aus Ihrer Cloud laden und %2$@ auf diesem Mac ersetzen? Die bisherige App bleibt erhalten."}},
        "es": {"stringUnit": {"state": "translated", "value": "¿Descargar %1$@ de su nube y reemplazar %2$@ en este Mac? Se conservará la app anterior."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Baixar %1$@ da sua nuvem e substituir %2$@ neste Mac? O app anterior será mantido."}},
