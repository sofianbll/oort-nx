        "de": {"stringUnit": {"state": "translated", "value": "Datei-Mods können den Online-Tausch blockieren. Unter Mods wieder einschalten."}},
        "es": {"stringUnit": {"state": "translated", "value": "Los mods de archivos pueden impedir los intercambios en línea. Reactívalos en Mods."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Mods de arquivos podem impedir trocas online. Reative-os em Mods."}},
