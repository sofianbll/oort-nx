    "A cloud save download did not finish. Play the game once so it can put this Mac's save back, then try again.": {
      "comment": "SaveLocation.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A cloud save download did not finish. Play the game once so it can put this Mac's save back, then try again."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un download del salvataggio dal cloud non è terminato. Avvia il gioco una volta perché rimetta a posto il salvataggio di questo Mac, poi riprova."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un téléchargement de la sauvegarde depuis le cloud ne s’est pas terminé. Lancez le jeu une fois pour qu’il remette en place la sauvegarde de ce Mac, puis réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Download des Cloud-Spielstands wurde nicht abgeschlossen. Starte das Spiel einmal, damit es den Spielstand dieses Macs wiederherstellt, und versuche es dann erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una descarga de la partida guardada desde la nube no terminó. Inicia el juego una vez para que restaure la partida de este Mac y vuelve a intentarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um download do salvamento da nuvem não terminou. Abra o jogo uma vez para que ele restaure o salvamento deste Mac e tente de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云存档下载未完成。请先运行一次游戏，以便恢复这台 Mac 上的存档，然后再试。"
          }
        }
      }
    },
