    "The moonlight's beam and motes move and a live background plays; off, they hold still.": {
      "comment": "SettingsCatalog.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The moonlight's beam and motes move and a live background plays; off, they hold still."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il fascio di luce lunare e le particelle si muovono e lo sfondo animato viene riprodotto; se disattivato, restano fermi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le faisceau du clair de lune et les particules bougent, et l’arrière-plan animé est lu ; désactivé, ils restent immobiles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mondlichtstrahl und die Partikel bewegen sich und ein Live-Hintergrund wird abgespielt; deaktiviert bleiben sie still."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El haz y las partículas de luz de luna se mueven y el fondo animado se reproduce; al desactivarlo, quedan inmóviles."
          }
