    "Check these installations in Steam, then refresh this source. Only recognized native Mac games appear in the library.": {
      "comment": "Steam source management and native Mac library presentation.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check these installations in Steam, then refresh this source. Only recognized native Mac games appear in the library."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla queste installazioni in Steam, poi aggiorna la fonte. Nella libreria compaiono solo i giochi Mac nativi riconosciuti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez ces installations dans Steam, puis actualisez cette source. Seuls les jeux Mac natifs reconnus apparaissent dans la bibliothèque."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe diese Installationen in Steam und aktualisiere dann diese Quelle. Nur erkannte native Mac-Spiele erscheinen in der Bibliothek."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa estas instalaciones en Steam y después actualiza esta fuente. Solo aparecen en la biblioteca los juegos nativos de Mac reconocidos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique estas instalações no Steam e atualize esta fonte. Apenas jogos nativos para Mac reconhecidos aparecem na biblioteca."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 Steam 中检查这些安装，然后刷新此来源。只有被识别的原生 Mac 游戏会出现在游戏库中。"
          }
        }
      }
    },
