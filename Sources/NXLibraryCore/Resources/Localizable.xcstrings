    "Close the game before managing its saves. Keep it closed until this operation finishes.": {
      "comment": "SaveLocation.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close the game before managing its saves. Keep it closed until this operation finishes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudi il gioco prima di gestirne i salvataggi. Tienilo chiuso fino al termine dell’operazione."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermez le jeu avant de gérer ses sauvegardes. Gardez-le fermé jusqu’à la fin de cette opération."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beende das Spiel, bevor du seine Spielstände verwaltest. Lass es geschlossen, bis der Vorgang abgeschlossen ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra el juego antes de gestionar sus partidas guardadas. Mantenlo cerrado hasta que termine esta operación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encerre o jogo antes de gerenciar seus dados salvos. Mantenha-o fechado até o término desta operação."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "管理存档前请先关闭游戏。在此操作完成前请保持关闭。"
          }
        }
      }
    },
