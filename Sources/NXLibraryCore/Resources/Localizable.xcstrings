        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你本周玩过的游戏。"
          }
        }
      }
    },
    "When Play opens Steam, it starts quietly. The waiting screen stays visible while the game starts. Steam comes forward if it needs input or the game takes too long.": {
      "comment": "SettingsSourcesSection.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When Play opens Steam, it starts quietly. The waiting screen stays visible while the game starts. Steam comes forward if it needs input or the game takes too long."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando Gioca apre Steam, lo avvia in background. La schermata di attesa resta visibile mentre parte il gioco. Steam viene in primo piano se serve una risposta o se il gioco tarda ad avviarsi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand Jouer ouvre Steam, il démarre en arrière-plan. L’écran d’attente reste visible pendant le lancement du jeu. Steam passe au premier plan s’il attend une réponse ou si le jeu tarde à démarrer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn „Spielen“ Steam öffnet, startet es im Hintergrund. Der Wartebildschirm bleibt beim Spielstart sichtbar. Steam kommt nach vorne, wenn eine Eingabe nötig ist oder der Start zu lange dauert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando Jugar abre Steam, lo inicia en segundo plano. La pantalla de espera sigue visible mientras se inicia el juego. Steam pasa al primer plano si necesita una respuesta o si el juego tarda demasiado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando Jogar abre o Steam, ele inicia em segundo plano. A tela de espera continua visível enquanto o jogo inicia. O Steam vem para a frente se precisar de uma resposta ou se o jogo demorar para iniciar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“开始游戏”打开 Steam 时会静默启动。游戏启动期间等待画面保持显示。如果 Steam 需要输入或游戏启动时间过长，Steam 会显示在前台。"
          }
        }
      }
    },
    "When you close a game, a card shows how long you played this time and in total.": {
      "comment": "SettingsCatalog.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you close a game, a card shows how long you played this time and in total."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando chiudi un gioco, una scheda mostra quanto hai giocato nella sessione e in totale."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous fermez un jeu, une fiche indique le temps joué pendant cette session et au total."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du ein Spiel beendest, zeigt eine Karte deine Spielzeit dieser Sitzung und insgesamt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando cierras un juego, una tarjeta muestra cuánto has jugado en esta sesión y en total."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao encerrar um jogo, um cartão mostra por quanto tempo você jogou nesta sessão e no total."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭游戏时，会有一张卡片显示本次和总计的游戏时间。"
          }
        }
      }
    },
    "When you close a game, a card shows how long you played this time and in total. Sessions under 10 seconds show none.": {
      "comment": "SettingsGamesSection.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you close a game, a card shows how long you played this time and in total. Sessions under 10 seconds show none."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando chiudi un gioco, una scheda mostra quanto hai giocato nella sessione e in totale. Non appare per le sessioni inferiori a 10 secondi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous fermez un jeu, une fiche indique le temps joué pendant cette session et au total. Aucune fiche ne s’affiche pour les sessions de moins de 10 secondes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du ein Spiel beendest, zeigt eine Karte deine Spielzeit dieser Sitzung und insgesamt. Bei Sitzungen unter 10 Sekunden erscheint keine Karte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando cierras un juego, una tarjeta muestra cuánto has jugado en esta sesión y en total. No se muestra para sesiones de menos de 10 segundos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao encerrar um jogo, um cartão mostra por quanto tempo você jogou nesta sessão e no total. Sessões com menos de 10 segundos não exibem cartão."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭游戏时，会有一张卡片显示本次和总计的游戏时间。不足 10 秒的游戏时段不显示。"
          }
        }
      }
    },
