    "This game can start on your local network instead. Players on the VPN will not be reachable.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "This game can start on your local network instead. Players on the VPN will not be reachable."}},
        "it": {"stringUnit": {"state": "translated", "value": "Puoi avviare il gioco sulla rete locale. I giocatori sulla VPN non saranno raggiungibili."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Vous pouvez lancer le jeu sur le réseau local. Les joueurs sur le VPN ne seront pas joignables."}},
        "de": {"stringUnit": {"state": "translated", "value": "Du kannst das Spiel im lokalen Netzwerk starten. Spieler im VPN sind nicht erreichbar."}},
        "es": {"stringUnit": {"state": "translated", "value": "Puedes iniciar el juego en la red local. No podrás conectar con los jugadores de la VPN."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Você pode iniciar o jogo na rede local. Os jogadores na VPN não estarão acessíveis."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "可以改为在本地网络启动游戏，但无法连接 VPN 上的玩家。"}}
      }
    },
