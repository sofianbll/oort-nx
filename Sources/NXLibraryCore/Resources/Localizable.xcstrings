      }
    },
    "Choose a path on the same cloud service. No files are moved.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Choose a path on the same cloud service. No files are moved."}},
        "it": {"stringUnit": {"state": "translated", "value": "Scegli un percorso sullo stesso servizio cloud. Nessun file viene spostato."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Indique un chemin sur le même service cloud. Aucun fichier n’est déplacé."}},
        "de": {"stringUnit": {"state": "translated", "value": "Wähle einen Pfad auf demselben Clouddienst. Es werden keine Dateien verschoben."}},
        "es": {"stringUnit": {"state": "translated", "value": "Elige una ruta en el mismo servicio en la nube. No se mueve ningún archivo."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Escolha um caminho no mesmo serviço de nuvem. Nenhum arquivo é movido."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "在同一云服务上选择路径。不会移动任何文件。"}}
      }
    },
    "Checking the old folder…": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Checking the old folder…"}},
        "it": {"stringUnit": {"state": "translated", "value": "Controllo della vecchia cartella…"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Vérification de l’ancien dossier…"}},
        "de": {"stringUnit": {"state": "translated", "value": "Alter Ordner wird geprüft…"}},
        "es": {"stringUnit": {"state": "translated", "value": "Comprobando la carpeta anterior…"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Verificando a pasta anterior…"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "正在检查原文件夹…"}}
      }
    },
    "Could not check the old folder.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Could not check the old folder."}},
        "it": {"stringUnit": {"state": "translated", "value": "Impossibile controllare la vecchia cartella."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Impossible de vérifier l’ancien dossier."}},
        "de": {"stringUnit": {"state": "translated", "value": "Der alte Ordner konnte nicht geprüft werden."}},
        "es": {"stringUnit": {"state": "translated", "value": "No se pudo comprobar la carpeta anterior."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Não foi possível verificar a pasta anterior."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法检查原文件夹。"}}
      }
    },
    "Moving games…": {
