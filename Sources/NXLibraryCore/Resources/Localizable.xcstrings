    "A cloud transfer is in progress": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "A cloud transfer is in progress"}},
        "it": {"stringUnit": {"state": "translated", "value": "È in corso un trasferimento cloud"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Un transfert cloud est en cours"}},
        "de": {"stringUnit": {"state": "translated", "value": "Eine Cloud-Übertragung läuft"}},
        "es": {"stringUnit": {"state": "translated", "value": "Hay una transferencia en la nube en curso"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Há uma transferência na nuvem em andamento"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "正在进行云端传输"}}
      }
    },
    "Quitting stops the transfer. Your files and cloud copies stay intact. The next time you open Arcane, confirm uploads again from the game pages.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Quitting stops the transfer. Your files and cloud copies stay intact. The next time you open Arcane, confirm uploads again from the game pages."}},
        "it": {"stringUnit": {"state": "translated", "value": "Uscire interrompe il trasferimento. I tuoi file e le copie nel cloud restano intatti. Al prossimo avvio, conferma di nuovo gli invii dalle schede dei giochi."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Quitter arrête le transfert. Vos fichiers et vos copies cloud restent intacts. Au prochain lancement, confirmez à nouveau les envois depuis les fiches des jeux."}},
        "de": {"stringUnit": {"state": "translated", "value": "Beim Beenden wird die Übertragung gestoppt. Deine Dateien und Cloud-Kopien bleiben erhalten. Bestätige beim nächsten Start die Uploads erneut auf den jeweiligen Spielseiten."}},
        "es": {"stringUnit": {"state": "translated", "value": "Salir detiene la transferencia. Tus archivos y las copias en la nube se conservan. Al volver a abrir Arcane, vuelve a confirmar las subidas desde las fichas de los juegos."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Sair interrompe a transferência. Seus arquivos e as cópias na nuvem ficam intactos. Ao abrir o Arcane novamente, confirme os envios novamente nas páginas dos jogos."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "退出会停止传输。文件和云端副本不会丢失。下次打开 Arcane 时，请在各游戏页面重新确认上传。"}}
      }
    },
    "Stay": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Stay"}},
        "it": {"stringUnit": {"state": "translated", "value": "Resta"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Rester"}},
        "de": {"stringUnit": {"state": "translated", "value": "Bleiben"}},
        "es": {"stringUnit": {"state": "translated", "value": "Quedarse"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Ficar"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "留在 Arcane"}}
      }
    },
    "A game file differs from its cloud copy. No existing copy is replaced.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "A game file differs from its cloud copy. No existing copy is replaced."}},
        "it": {"stringUnit": {"state": "translated", "value": "Un file del gioco differisce dalla copia nel cloud. Nessuna copia esistente viene sostituita."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Un fichier du jeu diffère de sa copie dans le cloud. Aucune copie existante n’est remplacée."}},
        "de": {"stringUnit": {"state": "translated", "value": "Eine Spieldatei weicht von ihrer Cloud-Kopie ab. Keine vorhandene Kopie wird ersetzt."}},
        "es": {"stringUnit": {"state": "translated", "value": "Un archivo del juego difiere de su copia en la nube. No se reemplaza ninguna copia existente."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Um arquivo do jogo difere da cópia na nuvem. Nenhuma cópia existente é substituída."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "游戏文件与其云端副本不同。不会替换现有副本。"}}
      }
    },
    "Arcane checks the cloud for missing game files.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Arcane checks the cloud for missing game files."}},
        "it": {"stringUnit": {"state": "translated", "value": "Arcane cerca i file del gioco mancanti nel cloud."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Arcane cherche les fichiers du jeu manquants dans le cloud."}},
        "de": {"stringUnit": {"state": "translated", "value": "Arcane sucht in der Cloud nach fehlenden Spieldateien."}},
        "es": {"stringUnit": {"state": "translated", "value": "Arcane busca en la nube los archivos del juego que faltan."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "O Arcane procura na nuvem os arquivos do jogo que faltam."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "Arcane 会在云端查找缺失的游戏文件。"}}
      }
    },
    "Game source files": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Game files"}},
        "it": {"stringUnit": {"state": "translated", "value": "File del gioco"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Fichiers du jeu"}},
        "de": {"stringUnit": {"state": "translated", "value": "Spieldateien"}},
        "es": {"stringUnit": {"state": "translated", "value": "Archivos del juego"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Arquivos do jogo"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "游戏源文件"}}
      }
    },
    "Different in the cloud. Nothing is overwritten.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Different in the cloud. Nothing is overwritten."}},
        "it": {"stringUnit": {"state": "translated", "value": "Diversi nel cloud: non viene sovrascritto nulla."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Différent dans le cloud, rien n’est écrasé."}},
        "de": {"stringUnit": {"state": "translated", "value": "In der Cloud abweichend. Nichts wird überschrieben."}},
        "es": {"stringUnit": {"state": "translated", "value": "Son distintos en la nube. No se sobrescribe nada."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Diferentes na nuvem. Nada é sobrescrito."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "与云端副本不同。不会覆盖任何文件。"}}
      }
    },
    "Moves to the Trash. Empty it to reclaim space. Everything stays available to download.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Moves to the Trash. Empty it to reclaim space. Everything stays available to download."}},
        "it": {"stringUnit": {"state": "translated", "value": "Va nel Cestino. Svuotalo per recuperare spazio. Tutto resta scaricabile."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les éléments sélectionnés sont placés dans la Corbeille. Videz-la pour libérer de l’espace. Tout reste téléchargeable."}},
        "de": {"stringUnit": {"state": "translated", "value": "Kommt in den Papierkorb. Leere ihn, um Speicherplatz freizugeben. Alles bleibt zum Download verfügbar."}},
        "es": {"stringUnit": {"state": "translated", "value": "Va a la papelera. Vacíala para recuperar espacio. Todo sigue disponible para descargar."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Vai para o Lixo. Esvazie-o para liberar espaço. Tudo continua disponível para baixar."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "移到废纸篓。清倒废纸篓后可释放空间。所有内容仍可下载。"}}
      }
    },
    "On this Mac: %@ to move to the Trash.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "On this Mac: %@ to move to the Trash."}},
        "it": {"stringUnit": {"state": "translated", "value": "Su questo Mac: %@ da spostare nel Cestino."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Sur ce Mac : %@ à mettre à la Corbeille."}},
        "de": {"stringUnit": {"state": "translated", "value": "Auf diesem Mac: %@ für den Papierkorb."}},
        "es": {"stringUnit": {"state": "translated", "value": "En este Mac: %@ para mover a la papelera."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Neste Mac: %@ para mover para o Lixo."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "此 Mac 上将移到废纸篓的内容：%@。"}}
      }
    },
    "Trash on this Mac: total size unknown.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Trash on this Mac: total size unknown."}},
        "it": {"stringUnit": {"state": "translated", "value": "Cestino di questo Mac: dimensione totale sconosciuta."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Taille totale inconnue · Corbeille de ce Mac."}},
        "de": {"stringUnit": {"state": "translated", "value": "Papierkorb auf diesem Mac: Gesamtgröße unbekannt."}},
        "es": {"stringUnit": {"state": "translated", "value": "Papelera de este Mac: tamaño total desconocido."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Lixo deste Mac: tamanho total desconhecido."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "此 Mac 上将移到废纸篓的内容：总大小未知。"}}
      }
    },
    "No items selected.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "No items selected."}},
        "it": {"stringUnit": {"state": "translated", "value": "Nessun elemento selezionato."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Aucun élément sélectionné."}},
        "de": {"stringUnit": {"state": "translated", "value": "Keine Elemente ausgewählt."}},
        "es": {"stringUnit": {"state": "translated", "value": "No hay elementos seleccionados."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Nenhum item selecionado."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "未选择任何项目。"}}
      }
    },
    "Your verified copy stays available in your personal cloud. Your saves are unchanged. Empty the Trash to reclaim space.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Your verified copy stays available in your personal cloud. Your saves are unchanged. Empty the Trash to reclaim space."}},
        "it": {"stringUnit": {"state": "translated", "value": "La copia verificata resta disponibile nel cloud personale. I salvataggi non cambiano. Svuotare il Cestino per recuperare spazio."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Votre copie vérifiée reste disponible dans votre cloud personnel. Vos sauvegardes restent intactes. Videz la Corbeille pour récupérer l’espace."}},
        "de": {"stringUnit": {"state": "translated", "value": "Ihre geprüfte Kopie bleibt in Ihrer persönlichen Cloud verfügbar. Ihre Spielstände bleiben unverändert. Leeren Sie den Papierkorb, um Speicherplatz freizugeben."}},
        "es": {"stringUnit": {"state": "translated", "value": "Su copia verificada sigue disponible en su nube personal. Sus partidas guardadas no cambian. Vacíe la papelera para recuperar espacio."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Sua cópia verificada continua disponível na nuvem pessoal. Seus jogos salvos não são alterados. Esvazie o Lixo para recuperar espaço."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "您可以继续从个人云端下载已验证的副本。您的存档不会更改。清倒废纸篓后可释放空间。"}}
      }
    },
