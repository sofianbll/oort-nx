      "en": {"stringUnit":{"state":"translated","value":"Sign-in, online play and, when enabled, presence and current game to Nextendo."}}, "fr": {"stringUnit":{"state":"translated","value":"Connexion, jeu en ligne et, si activés, présence et jeu en cours à Nextendo."}}, "it": {"stringUnit":{"state":"translated","value":"Accesso, gioco online e, se attivi, presenza e gioco in corso a Nextendo."}}, "de": {"stringUnit":{"state":"translated","value":"Anmeldung, Online-Spiel und, falls aktiviert, Präsenz und aktuelles Spiel an Nextendo."}}, "es": {"stringUnit":{"state":"translated","value":"Inicio de sesión, juego en línea y, si están activos, presencia y juego actual a Nextendo."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Login, jogo online e, quando ativados, presença e jogo atual para o Nextendo."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"向 Nextendo 发送登录和在线游戏信息；启用后也会发送在线状态和当前游戏。"}}
