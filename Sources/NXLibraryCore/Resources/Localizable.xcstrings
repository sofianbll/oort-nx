    }},
    "Keep supported game saves in iCloud Drive or in a folder you choose.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"Keep supported game saves in iCloud Drive or in a folder you choose."}}, "fr": {"stringUnit":{"state":"translated","value":"Conservez les sauvegardes compatibles dans iCloud Drive ou dans le dossier de votre choix."}}, "it": {"stringUnit":{"state":"translated","value":"Conserva i salvataggi compatibili in iCloud Drive o in una cartella che scegli."}}, "de": {"stringUnit":{"state":"translated","value":"Unterstützte Spielstände in iCloud Drive oder einem eigenen Ordner speichern."}}, "es": {"stringUnit":{"state":"translated","value":"Guarda las partidas compatibles en iCloud Drive o en una carpeta que elijas."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Guarde dados salvos compatíveis no iCloud Drive ou em uma pasta que escolher."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"将受支持的游戏存档保存在 iCloud Drive 或所选文件夹。"}}
    }},
