        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Multiplicateur de retour haptique par défaut (0 : désactivé, 1 : léger, 2 : standard, 3 : intense) transmis aux compilations prenant en charge les vibrations des manettes sous macOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmultiplikator für haptisches Feedback (0: aus, 1: dezent, 2: normal, 3: stark). Wird an Spiele-Builds übergeben, die macOS-Controller-Haptik unterstützen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Multiplicador de respuesta háptica predeterminado (0: desactivada, 1: sutil, 2: normal, 3: intensa) que se pasa a las compilaciones compatibles con la vibración de mandos de macOS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Multiplicador padrão da resposta tátil (0: sem vibração, 1: sutil, 2: padrão, 3: intensa), enviado às compilações de jogos compatíveis com resposta tátil de controles no macOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认触觉反馈强度（0：静音，1：轻微，2：标准，3：强烈），传递给支持 macOS 手柄触觉反馈的游戏构建。"
          }
        }
      }
    },
