            "value": "Arcane konnte deine Bibliothek nicht speichern. Daher können beim Beenden die letzten Änderungen verloren gehen: "
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arcane no ha podido guardar la biblioteca, por lo que los cambios recientes podrían perderse al salir: "
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Arcane não conseguiu salvar sua biblioteca. Por isso, as alterações recentes podem ser perdidas quando o app for encerrado: "
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Arcane 无法保存你的游戏库，因此退出时可能会丢失最近的更改："
          }
        }
      }
    },
