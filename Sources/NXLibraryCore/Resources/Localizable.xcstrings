        "it": {"stringUnit": {"state": "translated", "value": "Serve una cache di compilazione verificata."}},
        "fr": {"stringUnit": {"state": "translated", "value": "La compilation nécessite un cache de compilation vérifié."}},
        "de": {"stringUnit": {"state": "translated", "value": "Für die Kompilierung ist ein geprüfter Build-Cache nötig."}},
        "es": {"stringUnit": {"state": "translated", "value": "La compilación necesita una caché de compilación verificada."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "A compilação precisa de um cache de compilação verificado."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "需要经过验证的编译缓存才能构建。"}}
      }
