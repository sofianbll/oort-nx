    "Steam may need you. Check Steam, the game starts after.": {
      "comment": "CatalogSteamInfo.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam may need you. Check Steam, the game starts after."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam potrebbe aver bisogno di te. Controlla Steam, poi il gioco si avvia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam a peut-être besoin de vous. Vérifiez Steam, le jeu démarrera ensuite."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam braucht dich vielleicht. Sieh in Steam nach, danach startet das Spiel."
          }
        },
        "es": {
