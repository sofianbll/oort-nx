        "es": {"stringUnit": {"state": "translated", "value": "Conserva una copia de la caché de este Mac."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Mantém uma cópia do cache deste Mac."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "保留此 Mac 上的缓存作为备份。"}}
      }
    },
    "The cloud cache differs from this Mac’s cache.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "The cloud cache differs from this Mac’s cache."}},
        "it": {"stringUnit": {"state": "translated", "value": "La cache nel cloud è diversa da quella di questo Mac."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Le cache du cloud diffère de celui de ce Mac."}},
        "de": {"stringUnit": {"state": "translated", "value": "Der Cloud-Cache unterscheidet sich vom Cache dieses Mac."}},
        "es": {"stringUnit": {"state": "translated", "value": "La caché de la nube difiere de la de este Mac."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "O cache da nuvem difere do cache deste Mac."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "云端缓存与此 Mac 上的缓存不同。"}}
      }
    },
    "There’s no verified copy of the cloud cache on this Mac.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "There’s no verified copy of the cloud cache on this Mac."}},
        "it": {"stringUnit": {"state": "translated", "value": "Su questo Mac non c’è una copia verificata della cache cloud."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Ce Mac n’a pas de copie vérifiée du cache du cloud."}},
        "de": {"stringUnit": {"state": "translated", "value": "Auf diesem Mac gibt es keine geprüfte Kopie des Cloud-Caches."}},
        "es": {"stringUnit": {"state": "translated", "value": "No hay una copia verificada de la caché de la nube en este Mac."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Não há uma cópia verificada do cache da nuvem neste Mac."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "此 Mac 上没有经验证的云端缓存副本。"}}
      }
    },
    "Arcane couldn’t verify the cloud cache.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Arcane couldn’t verify the cloud cache."}},
        "it": {"stringUnit": {"state": "translated", "value": "Arcane non ha potuto verificare la cache cloud."}},
