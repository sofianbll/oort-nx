        "de": {"stringUnit": {"state": "translated", "value": "%d Spiele (%@) nach %@ verschieben?"}},
        "es": {"stringUnit": {"state": "translated", "value": "¿Mover %d juegos (%@) a %@?"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Mover %d jogos (%@) para %@?"}},
