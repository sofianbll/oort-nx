    "Your library could not be read. Its files have been kept. Open the library folder, then try again.": {
      "comment": "Catalog activation and recovery",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your library could not be read. Its files have been kept. Open the library folder, then try again."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile leggere la libreria. I file sono stati conservati. Apri la cartella della libreria, poi riprova."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire votre bibliothèque. Ses fichiers ont été conservés. Ouvrez le dossier de la bibliothèque, puis réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Bibliothek konnte nicht gelesen werden. Die Dateien wurden aufbewahrt. Öffne den Bibliotheksordner und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer tu biblioteca. Sus archivos se han conservado. Abre la carpeta de la biblioteca y vuelve a intentarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler sua biblioteca. Os arquivos foram preservados. Abra a pasta da biblioteca e tente novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取你的游戏库。其文件已保留。请打开游戏库文件夹，然后重试。"
          }
        }
      }
    },
    "Your library could not be read. Restore its backup or open the library folder to review the files.": {
      "comment": "Catalog activation and recovery",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your library could not be read. Restore its backup or open the library folder to review the files."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile leggere la libreria. Ripristina il backup oppure apri la cartella della libreria per controllare i file."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire votre bibliothèque. Restaurez sa sauvegarde ou ouvrez son dossier pour examiner les fichiers."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Bibliothek konnte nicht gelesen werden. Stelle die Sicherung wieder her oder öffne den Bibliotheksordner, um die Dateien zu prüfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer tu biblioteca. Restaura su copia de seguridad o abre la carpeta de la biblioteca para revisar los archivos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler sua biblioteca. Restaure o backup ou abra a pasta da biblioteca para verificar os arquivos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取你的游戏库。请恢复其备份，或打开游戏库文件夹检查文件。"
