    "No access. Share this folder as Viewer with the Google account connected here.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "No access. Share this folder as Viewer with the Google account connected here."}},
        "it": {"stringUnit": {"state": "translated", "value": "Nessun accesso. Condividi la cartella come Visualizzatore con l’account Google collegato qui."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Demandez au propriétaire un accès en lecture pour le compte Google connecté ici."}},
        "de": {"stringUnit": {"state": "translated", "value": "Kein Zugriff. Gib diesen Ordner für das verbundene Google-Konto als Betrachter frei."}},
        "es": {"stringUnit": {"state": "translated", "value": "Sin acceso. Comparte la carpeta como Lector con la cuenta de Google conectada aquí."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Sem acesso. Compartilhe a pasta como Leitor com a conta Google conectada aqui."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "无权访问。请将此文件夹共享给此处连接的 Google 账号，并设为查看者。"}}
      }
    },
