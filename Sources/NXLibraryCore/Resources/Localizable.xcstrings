          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia di %@ di Arcane viene spostata nel Cestino: puoi ripristinarla da lì. Il file originale resta dov’è."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
