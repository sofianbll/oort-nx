    "Keeps this Mac’s cache as a backup.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Keeps this Mac’s cache as a backup."}},
        "it": {"stringUnit": {"state": "translated", "value": "Conserva una copia della cache di questo Mac."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Conserve une copie du cache de ce Mac."}},
