    },
    "Keep the game closed, including launches from Finder, until the operation finishes.": {
      "comment": "Save safety and presentation; user content stays unchanged.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the game closed, including launches from Finder, until the operation finishes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni il gioco chiuso, anche evitando avvii dal Finder, finché l’operazione non termina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez le jeu fermé, y compris depuis le Finder, jusqu’à la fin de l’opération."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass das Spiel geschlossen und starte es auch nicht im Finder, bis der Vorgang abgeschlossen ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén el juego cerrado, también al abrirlo desde Finder, hasta que termine la operación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha o jogo fechado, sem iniciá-lo pelo Finder, até a operação terminar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在操作完成前，请保持游戏关闭，包括不要从访达启动。"
          }
        }
      }
    },
    "Keep the games and sources in Arcane. The older app's changes will be archived separately, without merging the libraries.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the games and sources in Arcane. The older app's changes will be archived separately, without merging the libraries."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni i giochi e le fonti di Arcane. Le modifiche della vecchia app saranno archiviate separatamente, senza unire le librerie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservez les jeux et les sources d’Arcane. Les modifications de l’ancienne app seront archivées séparément, sans fusionner les bibliothèques."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Spiele und Quellen in Arcane bleiben erhalten. Änderungen aus der älteren App werden separat archiviert, ohne die Mediatheken zusammenzuführen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva los juegos y las fuentes de Arcane. Los cambios de la app anterior se archivarán por separado, sin combinar las bibliotecas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha os jogos e as fontes do Arcane. As alterações do app antigo serão arquivadas separadamente, sem mesclar as bibliotecas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Arcane 中保留游戏和来源。旧版 App 的更改会单独存档，不会合并游戏库。"
          }
        }
      }
    },
