    "Your console's prod.keys, which unlock your own games. They stay on this Mac.": {
      "comment": "SetupCheck.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your console's prod.keys, which unlock your own games. They stay on this Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file prod.keys della tua console, che sblocca i tuoi giochi. Resta su questo Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier prod.keys de votre console, qui permet de déchiffrer vos propres jeux. Les clés restent sur ce Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die prod.keys deiner Konsole zum Entschlüsseln deiner eigenen Spiele. Sie bleiben auf diesem Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
