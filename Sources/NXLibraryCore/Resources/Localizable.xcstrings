        "zh-Hans": {"stringUnit": {"state": "translated", "value": "更改游戏文件夹？"}}
      }
    },
    "Use %@ as the Game files folder. No files will move.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Use %@ as the Game files folder. No files will move."}},
        "it": {"stringUnit": {"state": "translated", "value": "Usa %@ come cartella dei file di gioco. Nessun file viene spostato."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Utiliser %@ comme dossier des fichiers de jeu. Aucun fichier ne sera déplacé."}},
        "de": {"stringUnit": {"state": "translated", "value": "%@ als Ordner für Spieldateien verwenden. Es werden keine Dateien verschoben."}},
        "es": {"stringUnit": {"state": "translated", "value": "Usar %@ como carpeta de archivos de juego. No se moverá ningún archivo."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Usar %@ como pasta de arquivos de jogos. Nenhum arquivo será movido."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "将 %@ 用作游戏文件夹。不会移动任何文件。"}}
      }
    },
    "Keys missing: import them to identify this file": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Keys missing: import them to identify this file"}},
        "it": {"stringUnit": {"state": "translated", "value": "Chiavi mancanti: importale per identificare questo file"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Clés manquantes : importez-les pour identifier ce fichier"}},
        "de": {"stringUnit": {"state": "translated", "value": "Schlüssel fehlen: Importiere sie, um diese Datei zu identifizieren"}},
        "es": {"stringUnit": {"state": "translated", "value": "Faltan las claves: impórtalas para identificar este archivo"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Chaves ausentes: importe-as para identificar este arquivo"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "缺少密钥：请导入密钥以识别此文件"}}
      }
    },
    "Sort %@ selected files?": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Sort %@ selected files?"}},
