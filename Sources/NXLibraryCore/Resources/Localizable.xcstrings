        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa posizione dei salvataggi contiene un collegamento o un percorso non sicuro. Gestiscila nel Finder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet emplacement de sauvegarde contient un lien ou un chemin non sûr. Gérez-le dans le Finder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Spielstandort enthält einen Link oder einen unsicheren Pfad. Verwalte ihn im Finder."
