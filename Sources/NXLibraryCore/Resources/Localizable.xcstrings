    "The source changed during the scan. Refresh it again.": {
      "comment": "Steam source management and native Mac library presentation.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source changed during the scan. Refresh it again."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La fonte è cambiata durante la scansione. Aggiornala di nuovo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La source a changé pendant l’analyse. Actualisez-la à nouveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Quelle hat sich während der Suche geändert. Aktualisiere sie erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
