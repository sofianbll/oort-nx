    " This build cache is also used by %@; their next rebuilds may take longer too.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": " This build cache is also used by %@; their next rebuilds may take longer too."}},
        "it": {"stringUnit": {"state": "translated", "value": " Anche %@ usa questa cache di compilazione; le relative ricompilazioni potrebbero richiedere più tempo."}},
        "fr": {"stringUnit": {"state": "translated", "value": " Ce cache de compilation est aussi utilisé par %@ ; leurs prochaines recompilations peuvent prendre plus de temps."}},
        "de": {"stringUnit": {"state": "translated", "value": " Auch %@ verwendet diesen Build-Cache; der nächste Build dieser Spiele kann ebenfalls länger dauern."}},
        "es": {"stringUnit": {"state": "translated", "value": " %@ también utiliza esta caché de compilación; sus próximas recompilaciones pueden tardar más."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": " %@ também usa este cache de compilação; as próximas recompilações podem demorar mais."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": " %@ 也使用此编译缓存；它们下次重新构建可能会更久。"}}
      }
