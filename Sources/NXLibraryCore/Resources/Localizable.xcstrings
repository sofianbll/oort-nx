      "en": {"stringUnit":{"state":"translated","value":"%lld of %lld digits entered"}}, "it": {"stringUnit":{"state":"translated","value":"%lld cifre inserite su %lld"}}, "fr": {"stringUnit":{"state":"translated","value":"%lld chiffres saisis sur %lld"}}, "de": {"stringUnit":{"state":"translated","value":"%lld von %lld Ziffern eingegeben"}}, "es": {"stringUnit":{"state":"translated","value":"%lld de %lld dígitos introducidos"}}, "pt-BR": {"stringUnit":{"state":"translated","value":"%lld de %lld dígitos digitados"}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"已输入 %lld 位数字，共 %lld 位"}}
