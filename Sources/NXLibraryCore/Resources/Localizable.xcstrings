    "Follow a shared Google Drive folder in read-only mode.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Follow a shared Google Drive folder in read-only mode."}},
        "it": {"stringUnit": {"state": "translated", "value": "Segui una cartella condivisa di Google Drive in sola lettura."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Suivre un dossier Google Drive partagé en lecture seule."}},
        "de": {"stringUnit": {"state": "translated", "value": "Einem freigegebenen Google-Drive-Ordner schreibgeschützt folgen."}},
        "es": {"stringUnit": {"state": "translated", "value": "Sigue una carpeta compartida de Google Drive en modo de solo lectura."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Siga uma pasta compartilhada do Google Drive no modo somente leitura."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "以只读方式关注共享的 Google 云端硬盘文件夹。"}}
      }
    },
    "You follow this folder in read-only mode. Your library is not shared in return. Readers can download apps, caches and game files that Google Drive lets them see.\n\nWhen sharing, use a dedicated folder without keys or saves.": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Sie folgen diesem Ordner schreibgeschützt. Ihre Bibliothek wird dabei nicht freigegeben. Personen mit Lesezugriff können Apps, Caches und Spieldateien herunterladen, auf die sie in Google Drive Zugriff haben.\n\nVerwenden Sie zum Teilen einen eigenen Ordner ohne Schlüssel oder Spielstände."}},
        "en": {"stringUnit": {"state": "translated", "value": "You follow this folder in read-only mode. Your library is not shared in return. Readers can download apps, caches and game files that Google Drive lets them see.\n\nWhen sharing, use a dedicated folder without keys or saves."}},
        "es": {"stringUnit": {"state": "translated", "value": "Este seguimiento es de solo lectura y no comparte su biblioteca a cambio. Los lectores pueden descargar las aplicaciones, cachés y archivos de juego que Google Drive les permite ver.\n\nPara compartir, utilice una carpeta específica sin claves ni partidas guardadas."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Vous suivez ce dossier en lecture seule, sans partager votre bibliothèque en retour. Les lecteurs peuvent télécharger les apps, caches et fichiers de jeu auxquels Google Drive leur donne accès.\n\nPour partager, utilisez un dossier dédié, sans clés ni sauvegardes."}},
        "it": {"stringUnit": {"state": "translated", "value": "La cartella viene seguita in sola lettura e la propria libreria non viene condivisa. I lettori possono scaricare le app, le cache e i file di gioco che Google Drive consente loro di vedere.\n\nPer condividere, usare una cartella dedicata senza chiavi né salvataggi."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Você segue esta pasta em modo somente leitura. Sua biblioteca não é compartilhada em troca. Os leitores podem baixar os apps, caches e arquivos de jogos que o Google Drive permite que vejam.\n\nPara compartilhar, use uma pasta dedicada, sem chaves nem jogos salvos."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "你以只读方式关注此文件夹，你的游戏库不会因此共享给对方。查看者可以下载 Google 云端硬盘允许其查看的应用、缓存和游戏文件。\n\n共享时，请使用不含密钥或游戏存档的专用文件夹。"}}
      }
    },
    "Google Drive folder link or ID": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Google Drive folder link or ID"}},
        "it": {"stringUnit": {"state": "translated", "value": "Link o ID della cartella Google Drive"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Lien ou ID du dossier Google Drive"}},
        "de": {"stringUnit": {"state": "translated", "value": "Link oder ID des Google-Drive-Ordners"}},
        "es": {"stringUnit": {"state": "translated", "value": "Enlace o ID de la carpeta de Google Drive"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Link ou ID da pasta do Google Drive"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "Google 云端硬盘文件夹链接或 ID"}}
      }
    },
    "Enter a Google Drive folder link or a valid folder ID.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Enter a Google Drive folder link or a valid folder ID."}},
        "it": {"stringUnit": {"state": "translated", "value": "Inserisci un link a una cartella di Google Drive o un ID valido."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Saisissez un lien de dossier Google Drive ou un ID valide."}},
        "de": {"stringUnit": {"state": "translated", "value": "Gib einen Google-Drive-Ordnerlink oder eine gültige Ordner-ID ein."}},
        "es": {"stringUnit": {"state": "translated", "value": "Introduce un enlace a una carpeta de Google Drive o un ID válido."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Insira o link de uma pasta do Google Drive ou um ID válido."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "请输入 Google 云端硬盘文件夹链接或有效的文件夹 ID。"}}
      }
