        "fr": {"stringUnit": {"state": "translated", "value": "Utilisez ZeroTier en Communication locale, en LAN ou en Automatique si le VPN est activé. Nextendo ne change pas."}},
        "de": {"stringUnit": {"state": "translated", "value": "Nutze ZeroTier für lokale Kommunikation, LAN oder Automatisch mit aktivem VPN. Nextendo bleibt unverändert."}},
        "es": {"stringUnit": {"state": "translated", "value": "Usa ZeroTier en Comunicación local, LAN o Automático con la VPN activada. Nextendo no cambia."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Use ZeroTier em Comunicação local, LAN ou Automático com VPN ativada. O Nextendo não muda."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "在本地通信、LAN 或已开启 VPN 的自动模式下使用 ZeroTier。不影响 Nextendo。"}}
      }
    },
