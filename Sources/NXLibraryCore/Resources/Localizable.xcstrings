    "Keep playing to reveal it.": {
      "comment": "AchievementSummary.swift: a hidden achievement's description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep playing to reveal it."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua a giocare per scoprirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuez à jouer pour le découvrir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiel weiter, um ihn freizulegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue jugando para descubrirlo."
          }
        },
        "pt-BR": {
