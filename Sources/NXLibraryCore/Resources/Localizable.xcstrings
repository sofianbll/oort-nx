        "es": {"stringUnit": {"state": "translated", "value": "Arcane no pudo comprobar el manifiesto en la nube. Comprueba rclone y vuelve a intentarlo."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "O Arcane não conseguiu verificar o manifesto na nuvem. Verifique o rclone e tente novamente."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "Arcane 无法检查云端清单。请检查 rclone 后重试。"}}
      }
