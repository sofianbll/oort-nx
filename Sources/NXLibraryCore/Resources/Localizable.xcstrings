    "File mods may block online trades. Re-enable them in Mods.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "File mods may block online trades. Re-enable them in Mods."}},
        "it": {"stringUnit": {"state": "translated", "value": "Le mod dei file possono bloccare gli scambi online. Riattivale in Mod."}},
