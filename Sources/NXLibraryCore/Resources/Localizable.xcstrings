      }
    },
    "Choose a personal folder outside the followed reference. Neither can contain the other.": {"localizations": {
      "en": {"stringUnit": {"state": "translated", "value": "Choose a personal folder outside the followed reference. Neither can contain the other."}},
      "fr": {"stringUnit": {"state": "translated", "value": "Choisissez un dossier personnel distinct de la référence suivie. Aucun des deux ne peut contenir l’autre."}},
      "it": {"stringUnit": {"state": "translated", "value": "Scegli una cartella personale distinta dal riferimento seguito. Nessuna delle due può contenere l’altra."}},
      "de": {"stringUnit": {"state": "translated", "value": "Wähle einen eigenen Ordner außerhalb der verfolgten Referenz. Keiner der beiden darf den anderen enthalten."}},
      "es": {"stringUnit": {"state": "translated", "value": "Elige una carpeta personal distinta de la referencia que sigues. Ninguna puede contener a la otra."}},
      "pt-BR": {"stringUnit": {"state": "translated", "value": "Escolha uma pasta pessoal separada da referência seguida. Nenhuma pode conter a outra."}},
      "zh-Hans": {"stringUnit": {"state": "translated", "value": "请选择与已关注的参考库分开的个人文件夹。两者不能互相包含。"}}
    }},
    "Move paused. Close this window and choose Retry in Activity.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Move paused. Close this window and choose Retry in Activity."}},
        "it": {"stringUnit": {"state": "translated", "value": "Spostamento in pausa. Chiudi questa finestra e scegli Riprova in Attività."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Déplacement en pause. Fermez cette fenêtre, puis choisissez Réessayer dans Activité."}},
        "de": {"stringUnit": {"state": "translated", "value": "Verschieben pausiert. Schließe dieses Fenster und wähle in Aktivitäten „Erneut versuchen“."}},
        "es": {"stringUnit": {"state": "translated", "value": "Traslado en pausa. Cierra esta ventana y selecciona Reintentar en Actividad."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Transferência em pausa. Feche esta janela e selecione Tentar de novo em Atividade."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "移动已暂停。请关闭此窗口，然后在活动中心选择重试。"}}
      }
    },
    "The saved library move cannot be read. Cloud transfers are paused.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "The saved library move cannot be read. Cloud transfers are paused."}},
        "it": {"stringUnit": {"state": "translated", "value": "Impossibile leggere lo spostamento salvato. I trasferimenti cloud sono in pausa."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Le déplacement enregistré est illisible. Les transferts cloud sont en pause."}},
        "de": {"stringUnit": {"state": "translated", "value": "Der gespeicherte Verschiebevorgang kann nicht gelesen werden. Cloud-Übertragungen sind pausiert."}},
        "es": {"stringUnit": {"state": "translated", "value": "No se puede leer el traslado guardado. Las transferencias en la nube están en pausa."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Não foi possível ler a transferência salva. As transferências na nuvem estão em pausa."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法读取已保存的移动记录。云端传输已暂停。"}}
      }
    },
    "Could not finish moving games. Try again to move the remaining files.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Could not finish moving games. Try again to move the remaining files."}},
        "it": {"stringUnit": {"state": "translated", "value": "Spostamento incompleto. Riprova per spostare i file rimasti."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Déplacement incomplet. Réessayez pour déplacer les fichiers restants."}},
        "de": {"stringUnit": {"state": "translated", "value": "Verschieben fehlgeschlagen. Versuche es erneut, um die übrigen Dateien zu verschieben."}},
        "es": {"stringUnit": {"state": "translated", "value": "No se completó el traslado. Vuelve a intentarlo para mover los archivos restantes."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Não foi possível concluir a transferência. Tente de novo para mover os arquivos restantes."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "未能完成游戏移动。请重试以移动其余文件。"}}
      }
    },
    "Remote play": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Remote play"}},
        "it": {"stringUnit": {"state": "translated", "value": "Gioco a distanza"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Jeu à distance"}},
        "de": {"stringUnit": {"state": "translated", "value": "Spielen aus der Ferne"}},
        "es": {"stringUnit": {"state": "translated", "value": "Juego a distancia"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Jogo a distância"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "远程游玩"}}
      }
    },
    "Remote play via ZeroTier": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Remote play via ZeroTier"}},
        "it": {"stringUnit": {"state": "translated", "value": "Gioco a distanza tramite ZeroTier"}},
