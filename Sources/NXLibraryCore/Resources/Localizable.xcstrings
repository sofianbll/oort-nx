    }},
    "Applies the next time you start a game.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"Applies the next time you start a game."}}, "it": {"stringUnit":{"state":"translated","value":"Vale dal prossimo avvio del gioco."}}, "fr": {"stringUnit":{"state":"translated","value":"S’applique au prochain lancement du jeu."}}, "de": {"stringUnit":{"state":"translated","value":"Gilt beim nächsten Spielstart."}}, "es": {"stringUnit":{"state":"translated","value":"Se aplica la próxima vez que inicies un juego."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Vale na próxima vez que você iniciar um jogo."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"下次启动游戏时生效。"}}
    }},
    "Rebuild this game to play online without sharing its title.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"Rebuild this game to play online without sharing its title."}}, "it": {"stringUnit":{"state":"translated","value":"Ricompila il gioco per giocare online senza condividerne il titolo."}}, "fr": {"stringUnit":{"state":"translated","value":"Recompilez ce jeu pour jouer en ligne sans afficher son titre."}}, "de": {"stringUnit":{"state":"translated","value":"Erstelle dieses Spiel neu, um online zu spielen, ohne seinen Titel zu teilen."}}, "es": {"stringUnit":{"state":"translated","value":"Vuelve a compilar este juego para jugar en línea sin mostrar su título."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Recompile este jogo para jogar online sem mostrar o título."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"重新构建此游戏，即可在线游玩而不显示游戏名称。"}}
    }},
    "Play as guest?": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"Play as guest?"}}, "it": {"stringUnit":{"state":"translated","value":"Giocare come ospite?"}}, "fr": {"stringUnit":{"state":"translated","value":"Jouer en tant qu’invité ?"}}, "de": {"stringUnit":{"state":"translated","value":"Als Gast spielen?"}}, "es": {"stringUnit":{"state":"translated","value":"¿Jugar como invitado?"}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Jogar como convidado?"}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"以访客身份游玩？"}}
    }},
    "End guest session?": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"End guest session?"}}, "it": {"stringUnit":{"state":"translated","value":"Terminare la sessione ospite?"}}, "fr": {"stringUnit":{"state":"translated","value":"Terminer la session invité ?"}}, "de": {"stringUnit":{"state":"translated","value":"Gastsitzung beenden?"}}, "es": {"stringUnit":{"state":"translated","value":"¿Finalizar la sesión de invitado?"}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Encerrar a sessão de convidado?"}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"结束访客会话？"}}
    }},
    "End the guest session before restarting.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"End the guest session before restarting."}}, "it": {"stringUnit":{"state":"translated","value":"Termina la sessione ospite prima di riavviare."}}, "fr": {"stringUnit":{"state":"translated","value":"Terminez la session invité avant de redémarrer."}}, "de": {"stringUnit":{"state":"translated","value":"Beende die Gastsitzung vor dem Neustart."}}, "es": {"stringUnit":{"state":"translated","value":"Finaliza la sesión de invitado antes de reiniciar."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Encerre a sessão de convidado antes de reiniciar."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"请先结束访客会话，再重新启动。"}}
    }},
    "Switch profile?": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"Switch profile?"}}, "it": {"stringUnit":{"state":"translated","value":"Cambiare profilo?"}}, "fr": {"stringUnit":{"state":"translated","value":"Changer de profil ?"}}, "de": {"stringUnit":{"state":"translated","value":"Profil wechseln?"}}, "es": {"stringUnit":{"state":"translated","value":"¿Cambiar de perfil?"}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Trocar de perfil?"}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"切换个人资料？"}}
    }},
    "Unsaved progress will be lost when the game closes.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"Unsaved progress will be lost when the game closes."}}, "it": {"stringUnit":{"state":"translated","value":"I progressi non salvati andranno persi alla chiusura del gioco."}}, "fr": {"stringUnit":{"state":"translated","value":"La progression non enregistrée sera perdue à la fermeture du jeu."}}, "de": {"stringUnit":{"state":"translated","value":"Ungespeicherter Fortschritt geht beim Schließen des Spiels verloren."}}, "es": {"stringUnit":{"state":"translated","value":"Se perderá el progreso no guardado al cerrar el juego."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"O progresso não salvo será perdido ao fechar o jogo."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"关闭游戏后，未保存的进度将丢失。"}}
    }},
    "Close any Steam games yourself before switching.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"Close any Steam games yourself before switching."}}, "it": {"stringUnit":{"state":"translated","value":"Chiudi i giochi Steam prima di cambiare profilo."}}, "fr": {"stringUnit":{"state":"translated","value":"Fermez vous-même les jeux Steam avant de changer de profil."}}, "de": {"stringUnit":{"state":"translated","value":"Schließe laufende Steam-Spiele vor dem Wechsel selbst."}}, "es": {"stringUnit":{"state":"translated","value":"Cierra los juegos de Steam antes de cambiar de perfil."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Feche os jogos do Steam antes de trocar de perfil."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"切换前请手动关闭 Steam 游戏。"}}
    }},
    "Guests play Switch games offline with separate saves. A future guest cannot resume this session.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"Guests play Switch games offline with separate saves. A future guest cannot resume this session."}}, "it": {"stringUnit":{"state":"translated","value":"Gli ospiti giocano offline ai giochi Switch con salvataggi separati. Un altro ospite non può riprendere la sessione."}}, "fr": {"stringUnit":{"state":"translated","value":"Les invités jouent hors ligne aux jeux Switch, avec des sauvegardes séparées. Un autre invité ne pourra pas reprendre cette session."}}, "de": {"stringUnit":{"state":"translated","value":"Gäste spielen Switch-Spiele offline mit getrennten Spielständen. Ein späterer Gast kann diese Sitzung nicht fortsetzen."}}, "es": {"stringUnit":{"state":"translated","value":"Los invitados juegan a juegos de Switch sin conexión y con partidas separadas. Otro invitado no podrá reanudar esta sesión."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Convidados jogam títulos de Switch offline, com dados salvos separados. Outro convidado não pode retomar esta sessão."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"访客以离线模式游玩 Switch 游戏，使用独立存档。其他访客无法继续此会话。"}}
    }},
    "The guest cannot resume this session. Its saves are kept separately on this Mac.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"The guest cannot resume this session. Its saves are kept separately on this Mac."}}, "it": {"stringUnit":{"state":"translated","value":"L’ospite non può riprendere la sessione. I salvataggi restano separati su questo Mac."}}, "fr": {"stringUnit":{"state":"translated","value":"L’invité ne pourra pas reprendre cette session. Ses sauvegardes restent séparées sur ce Mac."}}, "de": {"stringUnit":{"state":"translated","value":"Der Gast kann diese Sitzung nicht fortsetzen. Seine Spielstände bleiben getrennt auf diesem Mac."}}, "es": {"stringUnit":{"state":"translated","value":"El invitado no podrá reanudar esta sesión. Sus partidas se guardan por separado en este Mac."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"O convidado não poderá retomar esta sessão. Os dados salvos ficam separados neste Mac."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"访客无法继续此会话，存档将单独保留在这台 Mac 上。"}}
    }},
    "Waiting for the game to close…": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"Waiting for the game to close…"}}, "it": {"stringUnit":{"state":"translated","value":"Attendo la chiusura del gioco…"}}, "fr": {"stringUnit":{"state":"translated","value":"En attente de la fermeture du jeu…"}}, "de": {"stringUnit":{"state":"translated","value":"Warte auf das Schließen des Spiels …"}}, "es": {"stringUnit":{"state":"translated","value":"Esperando a que se cierre el juego…"}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Aguardando o jogo fechar…"}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"正在等待游戏关闭…"}}
    }},
