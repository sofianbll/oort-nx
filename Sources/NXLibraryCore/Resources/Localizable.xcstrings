      "es": {"stringUnit":{"state":"translated","value":"Usar la carpeta «%@» (%d juegos)"}},
      "pt-BR": {"stringUnit":{"state":"translated","value":"Usar a pasta “%@” (%d jogos)"}},
      "zh-Hans": {"stringUnit":{"state":"translated","value":"使用“%@”文件夹（%d 个游戏）"}}
    }},
    "Use folder “%@”": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"Use the folder “%@”"}},
      "it": {"stringUnit":{"state":"translated","value":"Usa la cartella «%@»"}},
      "fr": {"stringUnit":{"state":"translated","value":"Utiliser le dossier « %@ »"}},
      "de": {"stringUnit":{"state":"translated","value":"Ordner „%@“ verwenden"}},
      "es": {"stringUnit":{"state":"translated","value":"Usar la carpeta «%@»"}},
      "pt-BR": {"stringUnit":{"state":"translated","value":"Usar a pasta “%@”"}},
      "zh-Hans": {"stringUnit":{"state":"translated","value":"使用“%@”文件夹"}}
    }},
    "Your cloud games will appear in Library → Cloud.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"Your cloud games will appear in Library → Cloud."}},
      "it": {"stringUnit":{"state":"translated","value":"I tuoi giochi nel cloud appariranno in Libreria → Cloud."}},
      "fr": {"stringUnit":{"state":"translated","value":"Vos jeux à télécharger apparaîtront dans Bibliothèque → Cloud."}},
      "de": {"stringUnit":{"state":"translated","value":"Deine Cloud-Spiele erscheinen unter Bibliothek → Cloud."}},
      "es": {"stringUnit":{"state":"translated","value":"Tus juegos en la nube aparecerán en Biblioteca → Nube."}},
      "pt-BR": {"stringUnit":{"state":"translated","value":"Seus jogos na nuvem aparecerão em Biblioteca → Nuvem."}},
      "zh-Hans": {"stringUnit":{"state":"translated","value":"您的云端游戏将显示在「游戏库 → 云端」中。"}}
    }},
    "Unplanned archive in the old folder: %@. Pause uploads from other Macs and move this file outside the old folder without deleting it before retrying.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Unplanned archive in the old folder: %@. Pause uploads from other Macs and move this file outside the old folder without deleting it before retrying."}},
        "it": {"stringUnit": {"state": "translated", "value": "Archivio non previsto nella vecchia cartella: %@. Sospendi gli invii dagli altri Mac e sposta il file fuori dalla vecchia cartella senza eliminarlo prima di riprovare."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Archive hors du plan dans l’ancien dossier : %@. Mettez en pause les envois des autres Mac et déplacez ce fichier hors de l’ancien dossier sans le supprimer, puis réessayez."}},
        "de": {"stringUnit": {"state": "translated", "value": "Nicht eingeplantes Archiv im alten Ordner: %@. Pausiere Uploads anderer Macs und verschiebe die Datei aus dem alten Ordner, ohne sie zu löschen. Versuche es dann erneut."}},
        "es": {"stringUnit": {"state": "translated", "value": "Archivo no previsto en la carpeta anterior: %@. Pausa las subidas de otros Mac y mueve el archivo fuera de la carpeta anterior sin eliminarlo antes de reintentar."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Arquivo não previsto na pasta antiga: %@. Pause os envios de outros Macs e mova o arquivo para fora da pasta antiga sem excluí-lo antes de tentar novamente."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "旧文件夹中有计划之外的归档：%@。请暂停其他 Mac 的上传，将此文件移出旧文件夹但不要删除，然后重试。"}}
      }
    },
    "The destination no longer matches the confirmed archives. Restore the missing or changed files before retrying.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "The destination no longer matches the confirmed archives. Restore the missing or changed files before retrying."}},
        "it": {"stringUnit": {"state": "translated", "value": "La destinazione non corrisponde più agli archivi confermati. Ripristina i file mancanti o modificati prima di riprovare."}},
        "fr": {"stringUnit": {"state": "translated", "value": "La destination ne correspond plus aux archives confirmées. Restaurez les fichiers manquants ou modifiés avant de réessayer."}},
        "de": {"stringUnit": {"state": "translated", "value": "Das Ziel entspricht nicht mehr den bestätigten Archiven. Stelle fehlende oder geänderte Dateien vor dem nächsten Versuch wieder her."}},
        "es": {"stringUnit": {"state": "translated", "value": "El destino ya no coincide con los archivos confirmados. Restaura los archivos que falten o hayan cambiado antes de reintentarlo."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "O destino não corresponde mais aos arquivos confirmados. Restaure os arquivos ausentes ou alterados antes de tentar novamente."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "目标文件夹与已确认的归档不再一致。请恢复缺失或已更改的文件后重试。"}}
      }
    },
    "Library files conflict. Keep both copies until you have reconciled them, then retry.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Library files conflict. Keep both copies until you have reconciled them, then retry."}},
        "it": {"stringUnit": {"state": "translated", "value": "Conflitto tra i file della libreria. Conserva entrambe le copie finché non le hai riconciliate, poi riprova."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Des fichiers sont en conflit. Conservez les deux copies le temps de les comparer, puis réessayez."}},
        "de": {"stringUnit": {"state": "translated", "value": "Bibliotheksdateien stehen in Konflikt. Behalte beide Kopien bis zum Abgleich und versuche es erneut."}},
        "es": {"stringUnit": {"state": "translated", "value": "Hay conflictos en los archivos de la biblioteca. Conserva ambas copias hasta conciliarlas y vuelve a intentarlo."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Há conflitos nos arquivos da biblioteca. Mantenha as duas cópias até conciliá-las e tente novamente."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "资料库文件存在冲突。请保留两个副本，核对后重试。"}}
      }
    },
    "The saved library move cannot be read or lacks Drive identities. Cloud transfers are paused. Keep this recovery record: %@.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "The saved library move cannot be read or lacks Drive identities. Cloud transfers are paused. Keep this recovery record: %@."}},
        "it": {"stringUnit": {"state": "translated", "value": "Lo spostamento salvato è illeggibile o privo degli ID Drive. I trasferimenti cloud sono in pausa. Conserva il registro di ripristino: %@."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Le déplacement enregistré est illisible ou ne contient pas les identifiants Drive. Les transferts cloud sont en pause. Conservez ce journal de récupération : %@."}},
        "de": {"stringUnit": {"state": "translated", "value": "Die gespeicherte Verschiebung ist unlesbar oder enthält keine Drive-IDs. Cloud-Übertragungen sind pausiert. Behalte dieses Wiederherstellungsprotokoll: %@."}},
        "es": {"stringUnit": {"state": "translated", "value": "El traslado guardado no se puede leer o carece de identificadores de Drive. Las transferencias se han pausado. Conserva este registro: %@."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "A mudança salva não pode ser lida ou não contém os IDs do Drive. As transferências na nuvem estão pausadas. Guarde este registro de recuperação: %@."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法读取已保存的移动记录，或记录缺少 Drive 标识。云端传输已暂停。请保留此恢复记录：%@。"}}
      }
    },
    "Confirm “%@” as the game files folder for this library?": {"localizations": {
      "en": {"stringUnit": {"state": "translated", "value": "Confirm “%@” as the game files folder for this library?"}},
      "fr": {"stringUnit": {"state": "translated", "value": "Confirmer « %@ » comme dossier des fichiers de jeu pour cette bibliothèque ?"}},
      "it": {"stringUnit": {"state": "translated", "value": "Confermare «%@» come cartella dei file di gioco per questa libreria?"}},
      "de": {"stringUnit": {"state": "translated", "value": "„%@“ als Spieldateiordner für diese Bibliothek bestätigen?"}},
      "es": {"stringUnit": {"state": "translated", "value": "¿Confirmar «%@» como carpeta de archivos de juego para esta biblioteca?"}},
      "pt-BR": {"stringUnit": {"state": "translated", "value": "Confirmar “%@” como pasta de arquivos de jogos desta biblioteca?"}},
      "zh-Hans": {"stringUnit": {"state": "translated", "value": "确认将“%@”用作此游戏库的游戏文件夹吗？"}}
    }},
    "Confirm the game files folder": {"localizations": {
      "en": {"stringUnit": {"state": "translated", "value": "Confirm the game files folder"}},
      "it": {"stringUnit": {"state": "translated", "value": "Conferma la cartella dei file di gioco"}},
      "fr": {"stringUnit": {"state": "translated", "value": "Confirmer le dossier des fichiers de jeu"}},
      "de": {"stringUnit": {"state": "translated", "value": "Ordner für Spieldateien bestätigen"}},
      "es": {"stringUnit": {"state": "translated", "value": "Confirma la carpeta de archivos del juego"}},
      "pt-BR": {"stringUnit": {"state": "translated", "value": "Confirme a pasta de arquivos dos jogos"}},
      "zh-Hans": {"stringUnit": {"state": "translated", "value": "确认游戏文件夹"}}
    }},
    "Keep “%@” for game files in this library, or use its default folder?": {"localizations": {
      "en": {"stringUnit": {"state": "translated", "value": "Keep “%@” for game files in this library, or use its default folder?"}},
      "it": {"stringUnit": {"state": "translated", "value": "Vuoi tenere «%@» per i file di gioco di questa libreria o usare la sua cartella predefinita?"}},
      "fr": {"stringUnit": {"state": "translated", "value": "Garder « %@ » pour les fichiers de jeu de cette bibliothèque ou utiliser son dossier par défaut ?"}},
      "de": {"stringUnit": {"state": "translated", "value": "„%@“ für die Spieldateien dieser Bibliothek behalten oder ihren Standardordner verwenden?"}},
      "es": {"stringUnit": {"state": "translated", "value": "¿Conservar «%@» para los archivos de juego de esta biblioteca o usar su carpeta predeterminada?"}},
      "pt-BR": {"stringUnit": {"state": "translated", "value": "Manter “%@” para os arquivos de jogos desta biblioteca ou usar a pasta padrão dela?"}},
      "zh-Hans": {"stringUnit": {"state": "translated", "value": "为此游戏库保留“%@”作为游戏文件夹，还是使用其默认文件夹？"}}
    }},
    "Keep this folder": {"localizations": {
