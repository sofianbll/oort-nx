    "Deletes only the source files named in this game and its app-owned workspace. The app and saves stay.": {
      "comment": "GameOptionsPresentation.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletes only the source files named in this game and its app-owned workspace. The app and saves stay."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina solo i file sorgente indicati in questo gioco e la sua area di lavoro gestita dall’app. L’app e i salvataggi restano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime uniquement les fichiers sources référencés pour ce jeu et son espace de travail géré par l’app. L’app et les sauvegardes restent en place."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht nur die diesem Spiel zugeordneten Quelldateien und sein app-eigenes Arbeitsverzeichnis. App und Spielstände bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina solo los archivos de origen indicados en este juego y su espacio de trabajo propiedad de la app. La app y las partidas guardadas se conservan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apaga apenas os arquivos de origem indicados neste jogo e sua área de trabalho pertencente ao app. O app e os dados salvos são mantidos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只删除此游戏中列出的源文件及其 App 专属工作区。App 和存档会保留。"
          }
        }
      }
    },
