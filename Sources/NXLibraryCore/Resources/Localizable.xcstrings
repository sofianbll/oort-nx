    "Now: %@. Your choice applies to every game at its next launch. Nothing is deleted.": {
      "comment": "AppViewModel+GameActions.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Now: %@. Your choice applies to every game at its next launch. Nothing is deleted."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ora: %@. La scelta vale per tutti i giochi dal prossimo avvio. Non viene eliminato nulla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Actuellement : %@. Votre choix vaut pour tous les jeux à leur prochain lancement. Rien n’est supprimé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt: %@. Deine Auswahl gilt für alle Spiele ab dem nächsten Start. Nichts wird gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora: %@. La elección se aplica a todos los juegos en su próximo inicio. No se elimina nada."
