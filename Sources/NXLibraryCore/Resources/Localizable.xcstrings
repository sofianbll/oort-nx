    "Choose a folder with your %@. Existing apps play without these files. Change it later in Settings → Porting → Game folders.": {
      "comment": "GameFoldersCopy.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a folder with your %@. Existing apps play without these files. Change it later in Settings → Porting → Game folders."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una cartella con i tuoi %@. Le app esistenti funzionano senza questi file. Puoi cambiarla in seguito in Impostazioni → Porting → Cartelle dei giochi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un dossier contenant vos %@. Les apps existantes fonctionnent sans ces fichiers. Vous pourrez modifier ce choix dans Réglages → Porting → Dossiers de jeux."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Ordner mit deinen %@. Vorhandene Apps lassen sich ohne diese Dateien spielen. Du kannst den Ordner später unter Einstellungen → Porting → Spieleordner ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una carpeta con tus %@. Las apps existentes se pueden ejecutar sin estos archivos. Puedes cambiarlo más tarde en Ajustes → Porting → Carpetas de juegos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma pasta com seus %@. Apps existentes funcionam sem esses arquivos. Altere depois em Ajustes → Porting → Pastas de jogos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择存放你的%@的文件夹。现有的 App 无需这些文件即可游玩。以后可在“设置”→“移植”→“游戏文件夹”中更改。"
          }
        }
      }
    },
    "Choose where to keep your game apps. Put any existing nxnative games (.app) here. Change it later in Settings → Porting → Game folders.": {
      "comment": "GameFoldersCopy.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose where to keep your game apps. Put any existing nxnative games (.app) here. Change it later in Settings → Porting → Game folders."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli dove conservare le app dei giochi. Inserisci qui eventuali giochi nxnative (.app) esistenti. Puoi cambiarla in seguito in Impostazioni → Porting → Cartelle dei giochi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez où conserver vos apps de jeux. Placez-y vos jeux nxnative existants (.app). Vous pourrez modifier ce choix dans Réglages → Porting → Dossiers de jeux."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle, wo deine Spiele-Apps gespeichert werden. Lege hier auch vorhandene nxnative-Spiele (.app) ab. Du kannst den Ordner später unter Einstellungen → Porting → Spieleordner ändern."
          }
