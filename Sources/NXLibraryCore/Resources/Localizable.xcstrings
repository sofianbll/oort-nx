    "Backups capture the local committed save, which may differ from a save not yet received from the cloud.": {
      "comment": "Save safety and presentation; user content stays unchanged.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups capture the local committed save, which may differ from a save not yet received from the cloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I backup copiano il salvataggio locale completato, che può essere diverso da uno non ancora ricevuto dal cloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sauvegardes copient les données locales enregistrées, qui peuvent différer de celles pas encore reçues du cloud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups erfassen den lokal abgeschlossenen Spielstand. Dieser kann von einem noch nicht aus der Cloud empfangenen Spielstand abweichen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las copias de seguridad guardan la partida local confirmada, que puede diferir de otra aún no recibida de la nube."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os backups copiam os dados salvos e confirmados localmente, que podem ser diferentes dos ainda não recebidos da nuvem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份保存的是本地已提交的存档，可能与尚未从云端收到的存档不同。"
          }
        }
      }
    },
