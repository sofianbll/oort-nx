    "Oort NX will reconnect “%@” and keep “%@” as its game files folder.": {"localizations": {
      "en": {"stringUnit": {"state": "translated", "value": "Oort NX will reconnect “%@” and keep “%@” as its game files folder."}},
      "fr": {"stringUnit": {"state": "translated", "value": "Oort NX reconnectera « %@ » et gardera « %@ » comme dossier des fichiers de jeu."}},
      "it": {"stringUnit": {"state": "translated", "value": "Oort NX riconnetterà «%@» e manterrà «%@» come cartella dei file di gioco."}},
      "de": {"stringUnit": {"state": "translated", "value": "Oort NX verbindet „%@“ erneut und behält „%@“ als Spieldateiordner bei."}},
      "es": {"stringUnit": {"state": "translated", "value": "Oort NX reconectará «%@» y conservará «%@» como carpeta de archivos de juego."}},
      "pt-BR": {"stringUnit": {"state": "translated", "value": "Oort NX reconectará “%@” e manterá “%@” como pasta de arquivos de jogos."}},
      "zh-Hans": {"stringUnit": {"state": "translated", "value": "Oort NX 将重新连接“%@”，并保留“%@”作为其游戏文件夹。"}}
    }},
    "New connections request full Google Drive access. Google does not limit that permission to the folders you choose here.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "New connections request full Google Drive access. Google does not limit that permission to the folders you choose here."}},
        "it": {"stringUnit": {"state": "translated", "value": "Le nuove connessioni richiedono l'accesso completo a Google Drive. Google non limita l'accesso alle cartelle che scegli qui."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Une nouvelle connexion demande un accès complet à Google Drive. Google ne limite pas cet accès aux dossiers que vous choisissez ici."}},
        "de": {"stringUnit": {"state": "translated", "value": "Neue Verbindungen benötigen Vollzugriff auf Google Drive. Google beschränkt diesen Zugriff nicht auf die hier gewählten Ordner."}},
        "es": {"stringUnit": {"state": "translated", "value": "Las conexiones nuevas solicitan acceso completo a Google Drive. Google no limita ese acceso a las carpetas que eliges aquí."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Novas conexões solicitam acesso total ao Google Drive. O Google não limita esse acesso às pastas que você escolhe aqui."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "新连接会请求 Google Drive 的完整访问权限。Google 不会将此权限限制在你在此处选择的文件夹内。"}}
      }
    },
