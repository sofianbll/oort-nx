    "Builds are recorded as untested and the untested-toolchain override stays on. ": {
      "comment": "NewestEngine.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Builds are recorded as untested and the untested-toolchain override stays on. "
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compilazioni sono registrate come non testate e il controllo della toolchain non testata resta ignorato. "
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les compilations sont enregistrées comme non testées et la dérogation pour chaîne d’outils non testée reste activée. "
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Builds werden als ungetestet erfasst und die Ausnahme für ungetestete Toolchains bleibt aktiv. "
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las compilaciones se registran como no probadas y la excepción para cadenas de herramientas no probadas se mantiene activada. "
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As compilações são registradas como não testadas e a permissão para conjunto de ferramentas não testado permanece ativada. "
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "构建将被记录为未经测试，“未测试工具链覆盖”将保持开启。"
          }
        }
      }
    },
