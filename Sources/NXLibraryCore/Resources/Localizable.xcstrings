    "Arcane reads Steam and your Game apps folder without changing anything. You can open the library now and add sources later in Settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arcane reads Steam and your Game apps folder without changing anything. You can open the library now and add sources later in Settings."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Arcane legge Steam e la cartella delle app dei giochi senza cambiare nulla. Puoi aprire subito la libreria e aggiungere le fonti dopo, dalle Impostazioni."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arcane lit Steam et le dossier des apps de jeux sans rien modifier. Vous pouvez ouvrir la bibliothèque maintenant et ajouter les sources plus tard dans les réglages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arcane liest Steam und den Spiele-App-Ordner, ohne etwas zu ändern. Du kannst die Mediathek jetzt öffnen und Quellen später in den Einstellungen hinzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arcane lee Steam y la carpeta de apps de juegos sin cambiar nada. Puedes abrir la biblioteca ahora y añadir las fuentes más tarde en Ajustes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Arcane lê o Steam e a pasta de apps de jogos sem alterar nada. Você pode abrir a biblioteca agora e adicionar as fontes depois, nos Ajustes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Arcane 会读取 Steam 和你的“游戏 App”文件夹，但不会做任何更改。你现在就可以打开游戏库，以后再在“设置”中添加来源。"
          }
        }
      }
    },
