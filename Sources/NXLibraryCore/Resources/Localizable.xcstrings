    "Off keeps every cheat from running, whatever is switched on.": {
      "comment": "CheatsPanel.swift:284",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off keeps every cheat from running, whatever is switched on."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se disattivato, impedisce l’esecuzione di tutti i trucchi, anche di quelli attivi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé empêche l’exécution de tous les codes de triche, quels que soient ceux activés individuellement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Aus“ verhindert die Ausführung aller Cheats, unabhängig davon, welche einzeln aktiviert sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado impide ejecutar cualquier truco, aunque esté activado individualmente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado impede a execução de todas as trapaças, independentemente das que estiverem ativadas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“关”会阻止所有金手指运行，无论开启了哪些。"
          }
        }
      }
    },
