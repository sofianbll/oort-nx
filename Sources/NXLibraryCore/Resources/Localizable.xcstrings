      }
    },
    "Only app and build cache archives move. Game files stay where they are.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Only app and build cache archives move. Game files stay where they are."}},
        "it": {"stringUnit": {"state": "translated", "value": "Si spostano solo gli archivi delle app e delle cache di build. I file del gioco restano dove sono."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Seules les archives des apps et des caches de compilation sont déplacées. Les fichiers du jeu restent en place."}},
        "de": {"stringUnit": {"state": "translated", "value": "Nur App- und Build-Cache-Archive werden verschoben. Spieldateien bleiben unverändert am selben Ort."}},
        "es": {"stringUnit": {"state": "translated", "value": "Solo se mueven los archivos de las apps y las cachés de compilación. Los archivos del juego se quedan donde están."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Só os arquivos compactados dos apps e dos caches de compilação são movidos. Os arquivos do jogo ficam onde estão."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "仅移动应用和构建缓存的归档。游戏文件保留在原处。"}}
      }
    },
    "Pause uploads on other Macs. Drive cannot lock both folders; uploads during or after the final check may be missed.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Pause uploads on other Macs. Drive cannot lock both folders; uploads during or after the final check may be missed."}},
        "it": {"stringUnit": {"state": "translated", "value": "Sospendi gli invii sugli altri Mac. Drive non può bloccare entrambe le cartelle: gli invii durante o dopo l’ultima verifica potrebbero sfuggire."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Mettez en pause les envois des autres Mac. Drive ne peut pas verrouiller les deux dossiers : des envois pendant ou après la dernière vérification peuvent lui échapper."}},
        "de": {"stringUnit": {"state": "translated", "value": "Pausiere Uploads auf anderen Macs. Drive kann nicht beide Ordner sperren. Uploads während oder nach der letzten Prüfung können unentdeckt bleiben."}},
        "es": {"stringUnit": {"state": "translated", "value": "Pausa las subidas de otros Mac. Drive no puede bloquear ambas carpetas: las subidas durante o después de la última comprobación podrían pasar inadvertidas."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Pause os envios nos outros Macs. O Drive não pode bloquear as duas pastas; envios durante ou após a última verificação podem passar despercebidos."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "请暂停其他 Mac 上的上传。Drive 无法锁定两个文件夹，最终检查期间或之后的上传可能不会被发现。"}}
      }
    },
    "Verifying the move…": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Verifying the move…"}},
        "it": {"stringUnit": {"state": "translated", "value": "Verifica dello spostamento…"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Vérification du déplacement…"}},
        "de": {"stringUnit": {"state": "translated", "value": "Verschiebung wird geprüft…"}},
        "es": {"stringUnit": {"state": "translated", "value": "Verificando el traslado…"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Verificando a mudança…"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "正在验证移动结果…"}}
      }
    },
    "The account and folders for this move could not be verified. No new files were moved. Keep the recovery record.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "The account and folders for this move could not be verified. No new files were moved. Keep the recovery record."}},
        "it": {"stringUnit": {"state": "translated", "value": "Impossibile verificare l’account e le cartelle dello spostamento. Conserva il registro di ripristino."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Impossible de vérifier le compte et les dossiers de ce déplacement. Aucun nouveau fichier n’a été déplacé. Conservez le journal de récupération."}},
        "de": {"stringUnit": {"state": "translated", "value": "Konto und Ordner konnten nicht geprüft werden. Es wurden keine weiteren Dateien verschoben. Behalte das Wiederherstellungsprotokoll."}},
        "es": {"stringUnit": {"state": "translated", "value": "No se pudieron verificar la cuenta y las carpetas. No se movieron archivos nuevos. Conserva el registro de recuperación."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Não foi possível verificar a conta e as pastas. Nenhum arquivo novo foi movido. Guarde o registro de recuperação."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法验证此次移动的账号和文件夹。未移动新文件。请保留恢复记录。"}}
      }
    },
    "This move belongs to another Drive account. Reconnect the original account before retrying.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "This move belongs to another Drive account. Reconnect the original account before retrying."}},
        "it": {"stringUnit": {"state": "translated", "value": "Lo spostamento appartiene a un altro account Drive. Ricollega l’account originale prima di riprovare."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Ce déplacement est lié à un autre compte Drive. Reconnectez le compte d’origine avant de réessayer."}},
        "de": {"stringUnit": {"state": "translated", "value": "Diese Verschiebung gehört zu einem anderen Drive-Konto. Verbinde vor dem nächsten Versuch das ursprüngliche Konto."}},
        "es": {"stringUnit": {"state": "translated", "value": "Este traslado pertenece a otra cuenta de Drive. Vuelve a conectar la cuenta original antes de reintentarlo."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Esta mudança pertence a outra conta do Drive. Reconecte a conta original antes de tentar novamente."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "此次移动属于另一个 Drive 账号。请重新连接原账号后重试。"}}
      }
    },
    "A library folder was replaced, renamed or cannot be read. Restore the original folders at their original paths before retrying.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "A library folder was replaced, renamed or cannot be read. Restore the original folders at their original paths before retrying."}},
        "it": {"stringUnit": {"state": "translated", "value": "Una cartella della libreria è stata sostituita, rinominata o non è leggibile. Ripristina le cartelle originali nei loro percorsi prima di riprovare."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Un dossier de la bibliothèque a été remplacé, renommé ou est illisible. Remettez les dossiers d’origine à leur emplacement avant de réessayer."}},
        "de": {"stringUnit": {"state": "translated", "value": "Ein Bibliotheksordner wurde ersetzt, umbenannt oder ist nicht lesbar. Stelle vor dem nächsten Versuch die ursprünglichen Ordner an ihren Pfaden wieder her."}},
        "es": {"stringUnit": {"state": "translated", "value": "Se sustituyó o renombró una carpeta de la biblioteca, o no se puede leer. Restaura las carpetas originales en sus rutas antes de reintentarlo."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Uma pasta foi substituída, renomeada ou não pode ser lida. Restaure as pastas originais nos caminhos originais antes de tentar novamente."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "资料库文件夹已被替换、重命名或无法读取。请将原文件夹恢复到原路径后重试。"}}
      }
    },
    "Archives still exist in the old folder. Pause uploads from other Macs and reconcile those archives before retrying. The library folder was not switched.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Pause uploads from other Macs. Move the remaining app and build cache archives and their manifests from the old library folder to a separate backup folder. Keep their paths and do not overwrite anything. Then retry. The active folder has not changed."}},
        "it": {"stringUnit": {"state": "translated", "value": "Sospendi gli invii dagli altri Mac. Sposta gli archivi delle app e delle cache di compilazione rimasti, con i loro manifesti, dalla vecchia libreria a una cartella di backup separata. Mantieni i percorsi e non sovrascrivere nulla. Poi riprova. La cartella attiva non è cambiata."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Mettez en pause les envois des autres Mac. Placez les archives d’apps et de caches de compilation restantes, avec leurs manifestes, de l’ancienne bibliothèque dans un dossier de sauvegarde séparé. Gardez leurs chemins sans rien écraser, puis réessayez. Le dossier actif n’a pas changé."}},
        "de": {"stringUnit": {"state": "translated", "value": "Pausiere Uploads anderer Macs. Verschiebe die verbliebenen App- und Build-Cache-Archive samt Manifesten aus der alten Bibliothek in einen separaten Sicherungsordner. Behalte die Pfade bei und überschreibe nichts. Versuche es erneut. Der aktive Ordner blieb unverändert."}},
        "es": {"stringUnit": {"state": "translated", "value": "Pausa las subidas de otros Mac. Mueve los archivos de apps y cachés de compilación que queden, con sus manifiestos, de la biblioteca anterior a una carpeta de respaldo separada. Conserva sus rutas y no sobrescribas nada. Vuelve a intentarlo. La carpeta activa no ha cambiado."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Pause os envios de outros Macs. Mova os arquivos de apps e caches de compilação restantes, com seus manifestos, da biblioteca antiga para uma pasta de backup separada. Mantenha os caminhos e não sobrescreva nada. Depois, tente de novo. A pasta ativa não mudou."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "请暂停其他 Mac 的上传。将旧游戏库文件夹中剩余的应用归档、构建缓存归档及其清单移至单独的备份文件夹。保留路径，不要覆盖任何文件，然后重试。当前使用的文件夹未更改。"}}
      }
    },
    "Move app and build cache archives?": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"Move app and build cache archives?"}},
      "it": {"stringUnit":{"state":"translated","value":"Spostare gli archivi delle app e delle cache di compilazione?"}},
      "fr": {"stringUnit":{"state":"translated","value":"Déplacer les archives d’apps et de caches de compilation ?"}},
      "de": {"stringUnit":{"state":"translated","value":"App- und Build-Cache-Archive verschieben?"}},
      "es": {"stringUnit":{"state":"translated","value":"¿Mover los archivos de apps y cachés de compilación?"}},
      "pt-BR": {"stringUnit":{"state":"translated","value":"Mover os arquivos de apps e caches de compilação?"}},
      "zh-Hans": {"stringUnit":{"state":"translated","value":"移动应用和构建缓存归档？"}}
    }},
    "Destination: “%@” · %@. Game files stay where they are.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"Destination: “%@” · %@. Game files stay where they are."}},
      "it": {"stringUnit":{"state":"translated","value":"Destinazione: «%@» · %@. I file dei giochi restano dove sono."}},
      "fr": {"stringUnit":{"state":"translated","value":"Destination : « %@ » · %@. Les fichiers de jeu restent à leur place."}},
      "de": {"stringUnit":{"state":"translated","value":"Ziel: „%@“ · %@. Die Spieldateien bleiben an ihrem Ort."}},
      "es": {"stringUnit":{"state":"translated","value":"Destino: «%@» · %@. Los archivos de juego no se mueven."}},
      "pt-BR": {"stringUnit":{"state":"translated","value":"Destino: “%@” · %@. Os arquivos dos jogos ficam onde estão."}},
      "zh-Hans": {"stringUnit":{"state":"translated","value":"目标文件夹：“%@” · %@。游戏文件保持原位。"}}
    }},
    "Use folder “%@” (%d game)": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"Use the folder “%@” (%d game)"}},
      "it": {"stringUnit":{"state":"translated","value":"Usa la cartella «%@» (%d gioco)"}},
