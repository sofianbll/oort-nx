    "Another version changed your previous library. Both versions have been kept. Close the other copy and review the library folder.": {
      "comment": "Catalog activation and recovery",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another version changed your previous library. Both versions have been kept. Close the other copy and review the library folder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’altra versione ha modificato la libreria precedente. Entrambe le versioni sono state conservate. Chiudi l’altra copia e controlla la cartella della libreria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une autre version a modifié votre ancienne bibliothèque. Les deux versions ont été conservées. Fermez l’autre copie et examinez le dossier de la bibliothèque."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine andere Version hat deine bisherige Bibliothek geändert. Beide Versionen wurden aufbewahrt. Schließe die andere Kopie und prüfe den Bibliotheksordner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otra versión ha modificado tu biblioteca anterior. Se han conservado ambas versiones. Cierra la otra copia y revisa la carpeta de la biblioteca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outra versão alterou sua biblioteca anterior. Ambas as versões foram preservadas. Feche a outra cópia e verifique a pasta da biblioteca."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一个版本修改了你之前的游戏库。两个版本都已保留。请关闭另一个副本，并检查游戏库文件夹。"
