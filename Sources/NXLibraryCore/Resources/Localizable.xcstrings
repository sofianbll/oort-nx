    "Choose how this game connects.": {
      "comment": "nxnative launcher.json: Network note",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Wähle, wie sich dieses Spiel verbindet."}},
        "en": {"stringUnit": {"state": "translated", "value": "Choose how this game connects."}},
        "es": {"stringUnit": {"state": "translated", "value": "Elige cómo se conecta este juego."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Choisissez comment ce jeu se connecte."}},
        "it": {"stringUnit": {"state": "translated", "value": "Scegli come si connette questo gioco."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Escolha como este jogo se conecta."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "选择此游戏的连接方式。"}}
      }
    },
    "No network. Code mods work.": {
      "comment": "nxnative launcher.json: Offline note",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Kein Netzwerk. Code-Mods funktionieren."}},
        "en": {"stringUnit": {"state": "translated", "value": "No network. Code mods work."}},
        "es": {"stringUnit": {"state": "translated", "value": "Sin red. Los mods de código funcionan."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Aucun réseau. Les mods de code fonctionnent."}},
        "it": {"stringUnit": {"state": "translated", "value": "Nessuna rete. Le mod di codice funzionano."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Sem rede. Os mods de código funcionam."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "不使用网络。代码模组可用。"}}
      }
    },
    "Like nearby play on Switch: play with Macs or iPhones on the same Wi-Fi.": {
      "comment": "nxnative launcher.json: Local communication note",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Wie lokales Spielen auf der Switch: Spiele mit Macs oder iPhones im selben WLAN."}},
        "en": {"stringUnit": {"state": "translated", "value": "Like nearby play on Switch: play with Macs or iPhones on the same Wi-Fi."}},
        "es": {"stringUnit": {"state": "translated", "value": "Como el juego local en Switch: juega con Mac o iPhone en la misma red Wi-Fi."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Comme le jeu en proximité sur Switch : jouez avec des Mac ou iPhone sur le même Wi-Fi."}},
        "it": {"stringUnit": {"state": "translated", "value": "Come il gioco in locale su Switch: gioca con Mac o iPhone sulla stessa rete Wi-Fi."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Como jogar com pessoas por perto no Switch: jogue com Macs ou iPhones na mesma rede Wi-Fi."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "类似 Switch 的近距离游玩：与同一 Wi‑Fi 下的 Mac 或 iPhone 一起玩。"}}
      }
    },
    "The game's LAN mode, if it has one: devices on the same network.": {
      "comment": "nxnative launcher.json: LAN mode note",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Der LAN-Modus des Spiels, falls verfügbar: Geräte im selben Netzwerk."}},
        "en": {"stringUnit": {"state": "translated", "value": "The game's LAN mode, if it has one: devices on the same network."}},
        "es": {"stringUnit": {"state": "translated", "value": "El modo LAN del juego, si lo tiene: dispositivos en la misma red."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Le mode LAN du jeu, s'il en a un : appareils branchés sur le même réseau."}},
        "it": {"stringUnit": {"state": "translated", "value": "La modalità LAN del gioco, se disponibile: dispositivi sulla stessa rete."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "O modo LAN do jogo, se disponível: dispositivos na mesma rede."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "使用游戏的 LAN 模式（如有）：设备需在同一网络中。"}}
      }
    },
    "Internet through Nextendo, account required. Code mods are turned off.": {
      "comment": "nxnative launcher.json: Online (Nextendo) note",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Internet über Nextendo, Konto erforderlich. Code-Mods sind deaktiviert."}},
        "en": {"stringUnit": {"state": "translated", "value": "Internet through Nextendo, account required. Code mods are turned off."}},
        "es": {"stringUnit": {"state": "translated", "value": "Internet a través de Nextendo; se requiere una cuenta. Los mods de código se desactivan."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Internet via Nextendo, compte requis. Les mods de code sont désactivés."}},
        "it": {"stringUnit": {"state": "translated", "value": "Internet tramite Nextendo, account obbligatorio. Le mod di codice sono disattivate."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Internet via Nextendo; é preciso ter uma conta. Os mods de código são desativados."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "通过 Nextendo 在互联网上游玩，需要账号。代码模组会关闭。"}}
      }
    },
    "Not a mod: needs romfs or exefs patches.": {
      "comment": "ModsPanel.swift",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Kein Mod: romfs oder exefs-Patches fehlen."}},
        "en": {"stringUnit": {"state": "translated", "value": "Not a mod: needs romfs or exefs patches."}},
        "es": {"stringUnit": {"state": "translated", "value": "No es un mod: necesita romfs o parches exefs."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Ce n’est pas un mod : il manque romfs ou des correctifs exefs."}},
        "it": {"stringUnit": {"state": "translated", "value": "Non è una mod: manca romfs o mancano le patch exefs."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Não é um mod: precisa de romfs ou patches exefs."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "不是有效的模组：需要 romfs 或 exefs 补丁。"}}
      }
    },
    "Open the mods folder to add RomFS mods, or import a code mod.": {
      "comment": "ModsPanel.swift",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Öffne den Mods-Ordner für RomFS-Mods oder importiere einen Code-Mod."}},
        "en": {"stringUnit": {"state": "translated", "value": "Open the mods folder to add RomFS mods, or import a code mod."}},
        "es": {"stringUnit": {"state": "translated", "value": "Abre la carpeta de mods para añadir mods RomFS o importa un mod de código."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Ouvrez le dossier des mods pour ajouter un mod RomFS, ou importez un mod de code."}},
        "it": {"stringUnit": {"state": "translated", "value": "Apri la cartella delle mod per aggiungere mod RomFS oppure importa una mod di codice."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Abra a pasta de mods para adicionar mods RomFS ou importe um mod de código."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "打开模组文件夹以添加 RomFS 模组，或导入代码模组。"}}
      }
    },
    "Rebuild to apply code mod changes.": {
      "comment": "ModsPanel.swift",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Baue das Spiel neu, um Änderungen an Code-Mods zu übernehmen."}},
        "en": {"stringUnit": {"state": "translated", "value": "Rebuild to apply code mod changes."}},
        "es": {"stringUnit": {"state": "translated", "value": "Vuelve a compilar para aplicar los cambios de los mods de código."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Recompilez le jeu pour appliquer les changements des mods de code."}},
        "it": {"stringUnit": {"state": "translated", "value": "Ricompila il gioco per applicare le modifiche alle mod di codice."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Recompile o jogo para aplicar as alterações nos mods de código."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "重新构建以应用代码模组的更改。"}}
      }
    },
    "Apply at the next launch.": {
      "comment": "ModsPanel.swift: RomFS section subtitle",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Apply at the next launch."}},
        "de": {"stringUnit": {"state": "translated", "value": "Gelten ab dem nächsten Start."}},
        "es": {"stringUnit": {"state": "translated", "value": "Se aplican en el próximo inicio."}},
        "fr": {"stringUnit": {"state": "translated", "value": "S’appliquent au prochain lancement."}},
        "it": {"stringUnit": {"state": "translated", "value": "Si applicano al prossimo avvio."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Valem na próxima inicialização."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "下次启动时生效。"}}
      }
    },
    "1 mod, off": {
      "comment": "ModsPanel.swift: summary for one installed, disabled mod",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "1 Mod, inaktiv"}},
        "en": {"stringUnit": {"state": "translated", "value": "1 mod, off"}},
        "es": {"stringUnit": {"state": "translated", "value": "1 mod desactivado"}},
        "fr": {"stringUnit": {"state": "translated", "value": "1 mod désactivé"}},
        "it": {"stringUnit": {"state": "translated", "value": "1 mod disattivata"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "1 mod desativado"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "1 个模组，未启用"}}
      }
    },
    "The selected engine cannot build code mods. Switch engines or turn them off.": {
      "comment": "BuildService.swift",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Die gewählte Engine kann keine Code-Mods bauen. Wechsle die Engine oder schalte die Mods aus."}},
        "en": {"stringUnit": {"state": "translated", "value": "The selected engine cannot build code mods. Switch engines or turn them off."}},
        "es": {"stringUnit": {"state": "translated", "value": "El motor seleccionado no compila mods de código. Cambia de motor o desactiva esos mods."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Le moteur sélectionné ne compile pas les mods de code. Changez de moteur ou désactivez-les."}},
        "it": {"stringUnit": {"state": "translated", "value": "Il motore selezionato non compila le mod di codice. Cambia motore o disattiva le mod."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "O motor selecionado não compila mods de código. Troque de motor ou desative os mods."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "所选引擎无法构建代码模组。请更换引擎或停用这些模组。"}}
      }
    },
    "This archive needs a romfs folder or an exefs folder with patches.": {
      "comment": "ModInstaller.swift",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Dieses Archiv benötigt einen romfs-Ordner oder einen exefs-Ordner mit Patches."}},
        "en": {"stringUnit": {"state": "translated", "value": "This archive needs a romfs folder or an exefs folder with patches."}},
        "es": {"stringUnit": {"state": "translated", "value": "Este archivo necesita una carpeta romfs o una carpeta exefs con parches."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Cette archive doit contenir un dossier romfs ou un dossier exefs avec des correctifs."}},
        "it": {"stringUnit": {"state": "translated", "value": "Questo archivio richiede una cartella romfs o una cartella exefs con patch."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Este arquivo precisa de uma pasta romfs ou de uma pasta exefs com patches."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "此归档需要包含 romfs 文件夹，或包含补丁的 exefs 文件夹。"}}
      }
    },
    "Use one mod for this game, with romfs and exefs side by side if it has both. Replacement code files aren't supported.": {
      "comment": "ModInstaller.swift",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Verwende einen einzelnen Mod für dieses Spiel, mit romfs und exefs nebeneinander, falls beide vorhanden sind. Ersatzdateien für Code werden nicht unterstützt."}},
        "en": {"stringUnit": {"state": "translated", "value": "Use one mod for this game, with romfs and exefs side by side if it has both. Replacement code files aren't supported."}},
        "es": {"stringUnit": {"state": "translated", "value": "Usa un solo mod para este juego, con romfs y exefs al mismo nivel si tiene ambos. No se admiten archivos que sustituyan código."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Utilisez un seul mod pour ce jeu, avec romfs et exefs au même niveau s’il contient les deux. Les fichiers qui remplacent le code ne sont pas pris en charge."}},
        "it": {"stringUnit": {"state": "translated", "value": "Usa una sola mod per questo gioco, con romfs ed exefs allo stesso livello se sono entrambe presenti. I file che sostituiscono il codice non sono supportati."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Use um único mod para este jogo, com romfs e exefs no mesmo nível se houver os dois. Arquivos que substituem código não são compatíveis."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "此游戏请使用一个模组；如果同时包含 romfs 和 exefs，请将两个文件夹并列放置。不支持替换用的代码文件。"}}
      }
    },
    "A free, open-source game library and launcher for Mac. Play installed games and port compatible Switch titles with nxnative.": {
      "comment": "SettingsAboutSection.swift",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine kostenlose Open-Source-Spielebibliothek mit Launcher für den Mac. Starte installierte Spiele und portiere kompatible Switch-Titel mit nxnative."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A free, open-source game library and launcher for Mac. Play installed games and port compatible Switch titles with nxnative."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una biblioteca y un lanzador de juegos gratuitos y de código abierto para Mac. Juega a tus juegos instalados y adapta títulos compatibles de Switch con nxnative."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une bibliothèque et un lanceur de jeux gratuits et open source pour Mac. Lancez vos jeux installés et portez les titres Switch compatibles avec nxnative."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una libreria e un launcher di giochi per Mac, gratuiti e open source. Avvia i giochi installati e converti i titoli Switch compatibili con nxnative."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma biblioteca e um inicializador de jogos gratuitos e de código aberto para Mac. Abra os jogos instalados e porte títulos compatíveis de Switch com nxnative."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费开源的 Mac 游戏库与启动器。游玩已安装的游戏，并用 nxnative 移植兼容的 Switch 游戏。"
          }
        }
      }
    },
    "All achievements": {
      "comment": "Achievements card on a game's page, under the tier's name when every achievement is unlocked.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All achievements"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti gli obiettivi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les succès"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Erfolge"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los logros"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as conquistas"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部成就"
          }
        }
      }
    },
    "%@, every achievement unlocked": {
      "comment": "VoiceOver label of the earned Arcane on the Achievements screen; %@ is the tier's name (Arcane).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, every achievement unlocked"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, tutti gli obiettivi sbloccati"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, tous les succès débloqués"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, alle Erfolge freigeschaltet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, todos los logros desbloqueados"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, todas as conquistas desbloqueadas"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，已解锁全部成就"
          }
        }
      }
    },
    "Applied before each game starts, including Off. Custom save-sync overrides are reported in Saves. Cloud sync covers only the primary user and device save.": {
      "comment": "NUP program identity or local multiuser save scope; cloud still covers the primary user and device only.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applied before each game starts, including Off. Custom save-sync overrides are reported in Saves. Cloud sync covers only the primary user and device save."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Applicato prima di ogni avvio, anche se disattivato. Le impostazioni personalizzate che prevalgono sulla sincronizzazione dei salvataggi sono indicate in Salvataggi. Il cloud sincronizza solo i salvataggi dell’utente principale e del dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appliqué avant chaque démarrage de jeu, y compris Désactivé. Les réglages personnalisés de synchronisation des sauvegardes sont signalés dans Sauvegardes. Le cloud ne synchronise que les sauvegardes de l’utilisateur principal et de l’appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird vor jedem Spielstart angewendet, auch „Aus“. Eigene Überschreibungen der Spielstandsynchronisierung werden unter „Spielstände“ angezeigt. Die Cloud synchronisiert nur den Spielstand des Hauptbenutzers und den Gerätespielstand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica antes de iniciar cada juego, también al desactivarlo. Las personalizaciones de sincronización de partidas se indican en Partidas guardadas. La nube solo sincroniza las partidas del usuario principal y del dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicado antes de cada jogo iniciar, inclusive Desativado. Substituições personalizadas da sincronização são informadas em Dados salvos. A nuvem sincroniza apenas os salvamentos do usuário principal e do dispositivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在每次游戏启动前应用，包括“关”。自定义的存档同步设置会在“存档”中显示。云同步仅涵盖主用户和设备存档。"
          }
        }
      }
    },
    "Arcane": {
      "comment": "Achievement tier (a violet crystal) for unlocking every achievement of a game, where PlayStation has Platinum.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arcane"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Arcano"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arcane"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkan"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arcano"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arcano"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Arcane"
          }
        }
      }
    },
    "If the base and update are the ones the engine supports for this game, nothing on this Mac needs fixing: wait for an engine update. Otherwise add the supported update and port again.": {
      "comment": "PortingFailureReason.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the base and update are the ones the engine supports for this game, nothing on this Mac needs fixing: wait for an engine update. Otherwise add the supported update and port again."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se base e update sono quelli supportati dal motore per questo gioco, su questo Mac non c'è nulla da correggere: attendi un aggiornamento del motore. Altrimenti aggiungi l'update supportato e crea di nuovo l'app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la base et la mise à jour sont celles que le moteur prend en charge pour ce jeu, rien n’est à corriger sur ce Mac : attendez une mise à jour du moteur. Sinon, ajoutez la mise à jour prise en charge et recréez l’app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Basis und Update die sind, die die Engine für dieses Spiel unterstützt, ist auf diesem Mac nichts zu beheben: Warte auf ein Engine-Update. Sonst füge das unterstützte Update hinzu und erstelle die App erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la base y la actualización son las que el motor admite para este juego, no hay nada que corregir en este Mac: espera una actualización del motor. Si no, añade la actualización compatible y vuelve a compilar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se a base e a atualização são as que a engine suporta para este jogo, não há nada a corrigir neste Mac: aguarde uma atualização da engine. Caso contrário, adicione a atualização suportada e compile de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果基础游戏和更新正是引擎为此游戏支持的版本，这台 Mac 上无需修复：请等待引擎更新。否则请添加受支持的更新，然后重新移植。"
          }
        }
      }
    },
    "Open Applications": {
      "comment": "AppShellView.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Applications"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Applicazioni"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir Applications"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Programme öffnen"
          }
        },
        "es": {
