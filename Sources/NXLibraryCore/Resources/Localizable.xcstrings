    "Selected local files and Drive folders; the reference library is read-only.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"Selected local files and Drive folders; the reference library is read-only."}}, "fr": {"stringUnit":{"state":"translated","value":"Fichiers locaux choisis et dossiers Drive ; la bibliothèque de référence est en lecture seule."}}, "it": {"stringUnit":{"state":"translated","value":"File locali scelti e cartelle Drive; la libreria di riferimento è in sola lettura."}}, "de": {"stringUnit":{"state":"translated","value":"Ausgewählte lokale Dateien und Drive-Ordner; die Referenzbibliothek ist schreibgeschützt."}}, "es": {"stringUnit":{"state":"translated","value":"Archivos locales seleccionados y carpetas de Drive; la biblioteca de referencia es de solo lectura."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Arquivos locais selecionados e pastas do Drive; a biblioteca de referência é somente leitura."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"选定的本地文件和 Drive 文件夹；参考库仅供读取。"}}
