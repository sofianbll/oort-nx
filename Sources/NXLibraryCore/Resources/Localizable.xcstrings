        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige dónde guardar tus apps de juegos. Coloca aquí tus juegos existentes de nxnative (.app). Puedes cambiarlo más tarde en Ajustes → Porting → Carpetas de juegos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
