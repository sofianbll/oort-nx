    "Renders about a quarter more pixels: a little slower and warmer.": {
      "comment": "Engine game setting presentation; never translate env keys or values.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Renders about a quarter more pixels: a little slower and warmer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Renderizza circa un quarto di pixel in più: leggermente più lento e più caldo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcule environ un quart de pixels en plus : un peu plus lent et plus chaud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendert etwa ein Viertel mehr Pixel: etwas langsamer und wärmer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Renderiza aproximadamente un cuarto más de píxeles: algo más lento y con más calor."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Renderiza cerca de um quarto a mais de pixels: um pouco mais lento e mais quente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "渲染的像素多约四分之一：速度稍慢，温度稍高。"
          }
        }
      }
    },
