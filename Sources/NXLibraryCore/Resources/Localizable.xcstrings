    "%@ needs an exefs folder with .pchtxt or .ips files only, without links.": {
      "comment": "AppViewModel+Mods.swift",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "%@ benötigt einen exefs-Ordner nur mit .pchtxt- oder .ips-Dateien, ohne Links."}},
        "en": {"stringUnit": {"state": "translated", "value": "%@ needs an exefs folder with .pchtxt or .ips files only, without links."}},
        "es": {"stringUnit": {"state": "translated", "value": "%@ necesita una carpeta exefs que solo contenga archivos .pchtxt o .ips, sin enlaces."}},
        "fr": {"stringUnit": {"state": "translated", "value": "%@ doit contenir un dossier exefs avec seulement des fichiers .pchtxt ou .ips, sans liens."}},
        "it": {"stringUnit": {"state": "translated", "value": "%@ richiede una cartella exefs con soli file .pchtxt o .ips, senza collegamenti."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "%@ precisa de uma pasta exefs com apenas arquivos .pchtxt ou .ips, sem links."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "%@ 需要 exefs 文件夹，其中只能包含 .pchtxt 或 .ips 文件，不能有链接。"}}
      }
    },
    "%@ of %@ on": {
