    "The game cannot keep the order for this controller.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"The game cannot keep the order for this controller."}}, "fr": {"stringUnit":{"state":"translated","value":"Le jeu ne peut pas conserver l’ordre pour cette manette."}}, "it": {"stringUnit":{"state":"translated","value":"Il gioco non può mantenere l’ordine per questo controller."}}, "de": {"stringUnit":{"state":"translated","value":"Das Spiel kann die Reihenfolge für diesen Controller nicht beibehalten."}}, "es": {"stringUnit":{"state":"translated","value":"El juego no puede mantener el orden para este mando."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"O jogo não consegue manter a ordem para este controle."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"游戏无法保留此手柄的顺序。"}}
    }},
    "The game does not read this controller.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"The game does not read this controller."}}, "fr": {"stringUnit":{"state":"translated","value":"Le jeu ne détecte pas cette manette."}}, "it": {"stringUnit":{"state":"translated","value":"Il gioco non rileva questo controller."}}, "de": {"stringUnit":{"state":"translated","value":"Das Spiel erkennt diesen Controller nicht."}}, "es": {"stringUnit":{"state":"translated","value":"El juego no detecta este mando."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"O jogo não detecta este controle."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"游戏无法读取此手柄。"}}
    }},
    "The game's env.txt could not be read.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"The game's env.txt could not be read."}}, "fr": {"stringUnit":{"state":"translated","value":"Le fichier env.txt du jeu n’a pas pu être lu."}}, "it": {"stringUnit":{"state":"translated","value":"Impossibile leggere il file env.txt del gioco."}}, "de": {"stringUnit":{"state":"translated","value":"Die env.txt des Spiels konnte nicht gelesen werden."}}, "es": {"stringUnit":{"state":"translated","value":"No se pudo leer el archivo env.txt del juego."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Não foi possível ler o env.txt do jogo."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"无法读取游戏的 env.txt。"}}
    }},
    "The game's env.txt sets this instead.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"The game's env.txt sets this instead."}}, "fr": {"stringUnit":{"state":"translated","value":"Le fichier env.txt du jeu fixe ce réglage."}}, "it": {"stringUnit":{"state":"translated","value":"Questo valore è impostato dal file env.txt del gioco."}}, "de": {"stringUnit":{"state":"translated","value":"Die env.txt des Spiels legt diesen Wert fest."}}, "es": {"stringUnit":{"state":"translated","value":"El archivo env.txt del juego determina este ajuste."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"O env.txt do jogo define este ajuste."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"此设置由游戏的 env.txt 决定。"}}
    }},
    "The game's keyboard setting takes this player slot.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"The game's keyboard setting takes this player slot."}}, "fr": {"stringUnit":{"state":"translated","value":"Le réglage clavier du jeu occupe cette place."}}, "it": {"stringUnit":{"state":"translated","value":"L’impostazione della tastiera del gioco occupa questo posto."}}, "de": {"stringUnit":{"state":"translated","value":"Die Tastatureinstellung des Spiels belegt diesen Spielerplatz."}}, "es": {"stringUnit":{"state":"translated","value":"El ajuste del teclado del juego ocupa esta plaza."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"O ajuste de teclado do jogo ocupa esta vaga."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"游戏键盘设置占用了此玩家位置。"}}
    }},
    "The game's own setting takes priority.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"The game's own setting takes priority."}}, "fr": {"stringUnit":{"state":"translated","value":"Le réglage du jeu est prioritaire."}}, "it": {"stringUnit":{"state":"translated","value":"L’impostazione del gioco ha la precedenza."}}, "de": {"stringUnit":{"state":"translated","value":"Die Einstellung des Spiels hat Vorrang."}}, "es": {"stringUnit":{"state":"translated","value":"El ajuste del juego tiene prioridad."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"O ajuste do jogo tem prioridade."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"游戏自身的设置优先。"}}
    }},
    "The player setup could not be read. Nothing was changed.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"The player setup could not be read. Nothing was changed."}}, "fr": {"stringUnit":{"state":"translated","value":"Impossible de lire les réglages des joueurs. Rien n’a changé."}}, "it": {"stringUnit":{"state":"translated","value":"Impossibile leggere le impostazioni dei giocatori. Nessuna modifica."}}, "de": {"stringUnit":{"state":"translated","value":"Die Spielereinstellungen konnten nicht gelesen werden. Es wurde nichts geändert."}}, "es": {"stringUnit":{"state":"translated","value":"No se pudieron leer los ajustes de jugadores. No se cambió nada."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Não foi possível ler os ajustes dos jogadores. Nada foi alterado."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"无法读取玩家设置。未作任何更改。"}}
    }},
    "The player setup could not be saved.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"The player setup could not be saved."}}, "fr": {"stringUnit":{"state":"translated","value":"Impossible d’enregistrer les réglages des joueurs."}}, "it": {"stringUnit":{"state":"translated","value":"Impossibile salvare le impostazioni dei giocatori."}}, "de": {"stringUnit":{"state":"translated","value":"Die Spielereinstellungen konnten nicht gespeichert werden."}}, "es": {"stringUnit":{"state":"translated","value":"No se pudieron guardar los ajustes de jugadores."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Não foi possível salvar os ajustes dos jogadores."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"无法保存玩家设置。"}}
    }},
    "The profile is still locked.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"The profile is still locked."}}, "fr": {"stringUnit":{"state":"translated","value":"Le profil est toujours verrouillé."}}, "it": {"stringUnit":{"state":"translated","value":"Il profilo è ancora bloccato."}}, "de": {"stringUnit":{"state":"translated","value":"Das Profil ist noch gesperrt."}}, "es": {"stringUnit":{"state":"translated","value":"El perfil sigue bloqueado."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"O perfil ainda está bloqueado."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"个人资料仍处于锁定状态。"}}
    }},
    "The profile name is used only offline and in local play. Online, Nextendo keeps its own name.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"The profile name is used only offline and in local play. Online, Nextendo keeps its own name."}}, "fr": {"stringUnit":{"state":"translated","value":"Le nom du profil sert uniquement hors ligne et en jeu local. En ligne, Nextendo garde son propre nom."}}, "it": {"stringUnit":{"state":"translated","value":"Il nome del profilo vale solo offline e in locale. Online, Nextendo mantiene il suo nome."}}, "de": {"stringUnit":{"state":"translated","value":"Der Profilname gilt nur offline und im lokalen Spiel. Online behält Nextendo seinen eigenen Namen."}}, "es": {"stringUnit":{"state":"translated","value":"El nombre del perfil solo se usa sin conexión o en local. En línea, Nextendo conserva su nombre."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"O nome do perfil só vale offline e no jogo local. Online, o Nextendo mantém o próprio nome."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"个人资料名称仅用于离线和本地游戏。在线时，Nextendo 保留自己的名称。"}}
    }},
    "These controllers look identical. Choose a player and press a button on the controller to assign it.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"These controllers look identical. Choose a player and press a button on the controller to assign it."}}, "fr": {"stringUnit":{"state":"translated","value":"Ces manettes se ressemblent. Choisissez un joueur, puis appuyez sur un bouton de sa manette pour l’attribuer."}}, "it": {"stringUnit":{"state":"translated","value":"Questi controller sembrano uguali. Scegli un giocatore e premi un tasto sul suo controller per assegnarlo."}}, "de": {"stringUnit":{"state":"translated","value":"Diese Controller sehen gleich aus. Wähle einen Spieler und drücke eine Taste an seinem Controller, um ihn zuzuweisen."}}, "es": {"stringUnit":{"state":"translated","value":"Estos mandos parecen idénticos. Elige un jugador y pulsa un botón de su mando para asignarlo."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Estes controles parecem iguais. Escolha um jogador e aperte um botão no controle dele para atribuí-lo."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"这些手柄看起来相同。请选择一名玩家，然后按下其手柄上的按钮进行分配。"}}
    }},
    "These controllers look identical. Your button press tells them apart.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"These controllers look identical. Your button press tells them apart."}}, "fr": {"stringUnit":{"state":"translated","value":"Ces manettes se ressemblent. Une pression permet de les distinguer."}}, "it": {"stringUnit":{"state":"translated","value":"Questi controller sembrano uguali. La pressione del tasto permette di distinguerli."}}, "de": {"stringUnit":{"state":"translated","value":"Diese Controller sehen gleich aus. Der Tastendruck unterscheidet sie."}}, "es": {"stringUnit":{"state":"translated","value":"Estos mandos parecen idénticos. Al pulsar un botón se distinguen."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Estes controles parecem iguais. A pressão do botão permite diferenciá-los."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"这些手柄看起来相同。按下按钮即可区分。"}}
    }},
    "This clears the player profiles and controller assignments.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"This clears the assignments in this list. Your profiles are kept."}}, "fr": {"stringUnit":{"state":"translated","value":"Les associations de cette liste seront effacées. Vos profils sont conservés."}}, "it": {"stringUnit":{"state":"translated","value":"Cancella le assegnazioni in questo elenco. I profili vengono conservati."}}, "de": {"stringUnit":{"state":"translated","value":"Löscht die Zuweisungen in dieser Liste. Deine Profile bleiben erhalten."}}, "es": {"stringUnit":{"state":"translated","value":"Se borrarán las asignaciones de esta lista. Tus perfiles se conservan."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"As atribuições desta lista serão apagadas. Seus perfis serão mantidos."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"这会清除此列表中的分配。你的个人资料会保留。"}}
    }},
    "This controller did not respond.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"This controller did not respond."}}, "fr": {"stringUnit":{"state":"translated","value":"Cette manette n’a pas répondu."}}, "it": {"stringUnit":{"state":"translated","value":"Questo controller non ha risposto."}}, "de": {"stringUnit":{"state":"translated","value":"Dieser Controller hat nicht reagiert."}}, "es": {"stringUnit":{"state":"translated","value":"Este mando no respondió."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Este controle não respondeu."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"此手柄未响应。"}}
    }},
    "This game's app can only combine controllers on player 1.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"This game's app can only combine controllers on player 1."}}, "fr": {"stringUnit":{"state":"translated","value":"L’application de ce jeu ne peut regrouper les manettes que sur le joueur 1."}}, "it": {"stringUnit":{"state":"translated","value":"L’app di questo gioco può riunire i controller solo sul giocatore 1."}}, "de": {"stringUnit":{"state":"translated","value":"Diese Spiel-App kann Controller nur für Spieler 1 bündeln."}}, "es": {"stringUnit":{"state":"translated","value":"La aplicación de este juego solo puede agrupar los mandos en el jugador 1."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"O app deste jogo só pode agrupar os controles no jogador 1."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"此游戏应用只能将手柄合并给玩家 1。"}}
    }},
    "This game's app is too old for this setting.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"This game's app is too old for this setting."}}, "fr": {"stringUnit":{"state":"translated","value":"L’application de ce jeu est trop ancienne pour ce réglage."}}, "it": {"stringUnit":{"state":"translated","value":"L’app di questo gioco è troppo vecchia per questa impostazione."}}, "de": {"stringUnit":{"state":"translated","value":"Diese Spiel-App ist für diese Einstellung zu alt."}}, "es": {"stringUnit":{"state":"translated","value":"La aplicación de este juego es demasiado antigua para este ajuste."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"O app deste jogo é antigo demais para este ajuste."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"此游戏应用的版本太旧，不支持此设置。"}}
    }},
    "This game's app is too old: rebuild it to keep the order.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"This game's app is too old: rebuild it to keep the order."}}, "fr": {"stringUnit":{"state":"translated","value":"L’application de ce jeu est trop ancienne : recompilez-la pour conserver l’ordre."}}, "it": {"stringUnit":{"state":"translated","value":"L’app di questo gioco è troppo vecchia: ricompilala per mantenere l’ordine."}}, "de": {"stringUnit":{"state":"translated","value":"Diese Spiel-App ist zu alt: Erstelle sie neu, um die Reihenfolge beizubehalten."}}, "es": {"stringUnit":{"state":"translated","value":"La aplicación de este juego es demasiado antigua: recompílala para mantener el orden."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"O app deste jogo é antigo demais: recompile-o para manter a ordem."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"此游戏应用的版本太旧：请重新构建以保留顺序。"}}
    }},
    "This profile name cannot be used in the game.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"This profile name cannot be used in the game."}}, "fr": {"stringUnit":{"state":"translated","value":"Ce nom de profil ne peut pas être utilisé dans le jeu."}}, "it": {"stringUnit":{"state":"translated","value":"Questo nome del profilo non si può usare nel gioco."}}, "de": {"stringUnit":{"state":"translated","value":"Dieser Profilname kann im Spiel nicht verwendet werden."}}, "es": {"stringUnit":{"state":"translated","value":"Este nombre de perfil no se puede usar en el juego."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Este nome de perfil não pode ser usado no jogo."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"无法在游戏中使用此个人资料名称。"}}
    }},
    "There’s not enough space for the copy. Free some space, then try again.": {"localizations": {
      "en":{"stringUnit":{"state":"translated","value":"There’s not enough space for the copy. Free some space, then try again."}},"fr":{"stringUnit":{"state":"translated","value":"Il n’y a pas assez de place pour la copie. Libérez de l’espace, puis réessayez."}},"it":{"stringUnit":{"state":"translated","value":"Non c’è abbastanza spazio per la copia. Libera spazio e riprova."}},"de":{"stringUnit":{"state":"translated","value":"Für die Kopie ist nicht genug Platz vorhanden. Gib Speicherplatz frei und versuche es erneut."}},"es":{"stringUnit":{"state":"translated","value":"No hay espacio para la copia. Libera espacio y vuelve a intentarlo."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não há espaço para a cópia. Libere espaço e tente novamente."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"空间不足，无法创建副本。请释放一些存储空间后重试。"}}
    }},
    "Checking the library copy…": {"localizations": {
      "en":{"stringUnit":{"state":"translated","value":"Checking the library copy…"}},"fr":{"stringUnit":{"state":"translated","value":"Préparation de la copie…"}},"it":{"stringUnit":{"state":"translated","value":"Preparazione della copia…"}},"de":{"stringUnit":{"state":"translated","value":"Kopie wird vorbereitet …"}},"es":{"stringUnit":{"state":"translated","value":"Preparando la copia…"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Preparando a cópia…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在准备副本…"}}
    }},
    "Before updating your library": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"Before updating your library"}}, "fr": {"stringUnit":{"state":"translated","value":"Avant de mettre à jour la bibliothèque"}}, "it": {"stringUnit":{"state":"translated","value":"Prima di aggiornare la libreria"}}, "de": {"stringUnit":{"state":"translated","value":"Vor dem Aktualisieren der Bibliothek"}}, "es": {"stringUnit":{"state":"translated","value":"Antes de actualizar la biblioteca"}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Antes de atualizar a biblioteca"}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"更新游戏库前"}}
    }},
    "A copy of your launcher data is ready. It doesn’t include games or saves.": {"localizations": {
      "en":{"stringUnit":{"state":"translated","value":"A copy of your launcher data is ready. It doesn’t include games or saves."}},"fr":{"stringUnit":{"state":"translated","value":"Une copie des données du lanceur est prête. Elle ne contient ni jeux ni sauvegardes."}},"it":{"stringUnit":{"state":"translated","value":"La copia dei dati del launcher è pronta. Non contiene giochi né salvataggi."}},"de":{"stringUnit":{"state":"translated","value":"Eine Kopie der Launcher-Daten ist bereit. Spiele und Spielstände sind nicht enthalten."}},"es":{"stringUnit":{"state":"translated","value":"La copia de los datos del lanzador está lista. No incluye juegos ni partidas guardadas."}},"pt-BR":{"stringUnit":{"state":"translated","value":"A cópia dos dados do inicializador está pronta. Ela não inclui jogos nem partidas salvas."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"启动器数据的副本已准备好，不包含游戏或存档。"}}
    }},
    "If you go back to Oort NX 0.3.0, it won’t show play time recorded by the new version. Finish cloud transfers before going back.": {"localizations": {
      "en":{"stringUnit":{"state":"translated","value":"If you go back to Oort NX 0.3.0, it won’t show play time recorded by the new version. Finish cloud transfers before going back."}},"fr":{"stringUnit":{"state":"translated","value":"Si vous revenez à Oort NX 0.3.0, le temps joué avec la nouvelle version ne s’affichera pas. Terminez les transferts cloud avant de revenir en arrière."}},"it":{"stringUnit":{"state":"translated","value":"Oort NX 0.3.0 non mostra il tempo di gioco registrato dalla nuova versione. Completa i trasferimenti cloud prima di tornare indietro."}},"de":{"stringUnit":{"state":"translated","value":"Oort NX 0.3.0 zeigt die mit der neuen Version erfasste Spielzeit nicht an. Schließe vor der Rückkehr alle Cloud-Übertragungen ab."}},"es":{"stringUnit":{"state":"translated","value":"Oort NX 0.3.0 no mostrará el tiempo de juego de la versión nueva. Termina las transferencias en la nube antes de volver."}},"pt-BR":{"stringUnit":{"state":"translated","value":"O Oort NX 0.3.0 não mostra o tempo de jogo da versão nova. Conclua as transferências na nuvem antes de voltar."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Oort NX 0.3.0 不会显示新版记录的游玩时长。回退前请先完成云端传输。"}}
    }},
    "Couldn’t make a copy": {"localizations": {
      "en":{"stringUnit":{"state":"translated","value":"Couldn’t make a copy"}},"fr":{"stringUnit":{"state":"translated","value":"Impossible de faire une copie"}},"it":{"stringUnit":{"state":"translated","value":"Impossibile fare una copia"}},"de":{"stringUnit":{"state":"translated","value":"Es konnte keine Kopie erstellt werden"}},"es":{"stringUnit":{"state":"translated","value":"No se pudo hacer una copia"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível fazer uma cópia"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法创建副本"}}
    }},
    "Try again, or open the app without a copy just this once.": {"localizations": {
      "en":{"stringUnit":{"state":"translated","value":"Try again, or open the app without a copy just this once."}},"fr":{"stringUnit":{"state":"translated","value":"Vous pouvez réessayer ou ouvrir l’application sans copie cette fois-ci."}},"it":{"stringUnit":{"state":"translated","value":"Riprova oppure apri l’app senza copia, solo per questa volta."}},"de":{"stringUnit":{"state":"translated","value":"Versuche es erneut oder öffne die App diesmal ohne Kopie."}},"es":{"stringUnit":{"state":"translated","value":"Vuelve a intentarlo o abre la aplicación sin copia solo esta vez."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Tente novamente ou abra o app sem uma cópia, só desta vez."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请重试，或仅在本次不创建副本就打开应用。"}}
    }},
    "Going back to Oort NX 0.3.0 without a copy may lose play time.": {"localizations": {
      "en":{"stringUnit":{"state":"translated","value":"Going back to Oort NX 0.3.0 without a copy may lose play time."}},"fr":{"stringUnit":{"state":"translated","value":"Sans copie, vous risquez de perdre du temps de jeu enregistré si vous revenez à Oort NX 0.3.0."}},"it":{"stringUnit":{"state":"translated","value":"Tornando a Oort NX 0.3.0 senza una copia, potresti perdere il tempo di gioco registrato."}},"de":{"stringUnit":{"state":"translated","value":"Wenn du ohne Kopie zu Oort NX 0.3.0 zurückkehrst, kann erfasste Spielzeit verloren gehen."}},"es":{"stringUnit":{"state":"translated","value":"Si vuelves a Oort NX 0.3.0 sin una copia, podrías perder tiempo de juego registrado."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Voltar ao Oort NX 0.3.0 sem uma cópia pode fazer você perder tempo de jogo registrado."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"没有副本就回退到 Oort NX 0.3.0，可能会丢失已记录的游玩时长。"}}
    }},
    "Continue without a copy": {"localizations": {
      "en":{"stringUnit":{"state":"translated","value":"Continue without a copy"}},"fr":{"stringUnit":{"state":"translated","value":"Continuer sans copie"}},"it":{"stringUnit":{"state":"translated","value":"Continua senza copia"}},"de":{"stringUnit":{"state":"translated","value":"Ohne Kopie fortfahren"}},"es":{"stringUnit":{"state":"translated","value":"Continuar sin copia"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Continuar sem cópia"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"不创建副本，继续"}}
    }},
    "Only part of your library was copied": {"localizations": {
      "en":{"stringUnit":{"state":"translated","value":"Only part of your library was copied"}},"fr":{"stringUnit":{"state":"translated","value":"La copie est partielle"}},"it":{"stringUnit":{"state":"translated","value":"La copia è parziale"}},"de":{"stringUnit":{"state":"translated","value":"Die Kopie ist unvollständig"}},"es":{"stringUnit":{"state":"translated","value":"La copia es parcial"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A cópia é parcial"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"只复制了部分游戏库数据"}}
    }},
    "The copy reached its 128 MiB limit. Not fully copied: %@.": {"localizations": {
      "en":{"stringUnit":{"state":"translated","value":"The copy reached its 128 MiB limit. Not fully copied: %@."}},"fr":{"stringUnit":{"state":"translated","value":"La copie est limitée à 128 Mio. Ces éléments n’ont pas tous été copiés : %@."}},"it":{"stringUnit":{"state":"translated","value":"La copia ha un limite di 128 MiB. Elementi non copiati per intero: %@."}},"de":{"stringUnit":{"state":"translated","value":"Die Kopie ist auf 128 MiB begrenzt. Nicht vollständig kopiert: %@."}},"es":{"stringUnit":{"state":"translated","value":"La copia tiene un límite de 128 MiB. Elementos que no se copiaron por completo: %@."}},"pt-BR":{"stringUnit":{"state":"translated","value":"A cópia tem limite de 128 MiB. Itens não copiados por completo: %@."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"副本上限为 128 MiB。未完整复制的内容：%@。"}}
    }},
    "play history": {"localizations": {
      "en":{"stringUnit":{"state":"translated","value":"play history"}},"fr":{"stringUnit":{"state":"translated","value":"historique de jeu"}},"it":{"stringUnit":{"state":"translated","value":"cronologia di gioco"}},"de":{"stringUnit":{"state":"translated","value":"Spielverlauf"}},"es":{"stringUnit":{"state":"translated","value":"historial de juego"}},"pt-BR":{"stringUnit":{"state":"translated","value":"histórico de jogo"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"游玩记录"}}
    }},
    "game list": {"localizations": {
      "en":{"stringUnit":{"state":"translated","value":"game list"}},"fr":{"stringUnit":{"state":"translated","value":"liste des jeux"}},"it":{"stringUnit":{"state":"translated","value":"elenco dei giochi"}},"de":{"stringUnit":{"state":"translated","value":"Spieleliste"}},"es":{"stringUnit":{"state":"translated","value":"lista de juegos"}},"pt-BR":{"stringUnit":{"state":"translated","value":"lista de jogos"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"游戏列表"}}
    }},
    "settings": {"localizations": {
      "en":{"stringUnit":{"state":"translated","value":"settings"}},"fr":{"stringUnit":{"state":"translated","value":"réglages"}},"it":{"stringUnit":{"state":"translated","value":"impostazioni"}},"de":{"stringUnit":{"state":"translated","value":"Einstellungen"}},"es":{"stringUnit":{"state":"translated","value":"ajustes"}},"pt-BR":{"stringUnit":{"state":"translated","value":"configurações"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"设置"}}
    }},
    "profiles": {"localizations": {
      "en":{"stringUnit":{"state":"translated","value":"profiles"}},"fr":{"stringUnit":{"state":"translated","value":"profils"}},"it":{"stringUnit":{"state":"translated","value":"profili"}},"de":{"stringUnit":{"state":"translated","value":"Profile"}},"es":{"stringUnit":{"state":"translated","value":"perfiles"}},"pt-BR":{"stringUnit":{"state":"translated","value":"perfis"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"个人资料"}}
    }},
    "transfer and build queues": {"localizations": {
      "en":{"stringUnit":{"state":"translated","value":"transfer and build queues"}},"fr":{"stringUnit":{"state":"translated","value":"files de transfert et de compilation"}},"it":{"stringUnit":{"state":"translated","value":"code dei trasferimenti e delle compilazioni"}},"de":{"stringUnit":{"state":"translated","value":"Warteschlangen für Übertragungen und Builds"}},"es":{"stringUnit":{"state":"translated","value":"colas de transferencias y compilaciones"}},"pt-BR":{"stringUnit":{"state":"translated","value":"filas de transferências e compilações"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"传输和构建队列"}}
    }},
    "cloud status and connection settings": {"localizations": {
      "en":{"stringUnit":{"state":"translated","value":"cloud status and connection settings"}},"fr":{"stringUnit":{"state":"translated","value":"état du cloud et réglages de connexion"}},"it":{"stringUnit":{"state":"translated","value":"stato del cloud e impostazioni di connessione"}},"de":{"stringUnit":{"state":"translated","value":"Cloud-Status und Verbindungseinstellungen"}},"es":{"stringUnit":{"state":"translated","value":"estado de la nube y ajustes de conexión"}},"pt-BR":{"stringUnit":{"state":"translated","value":"status da nuvem e configurações de conexão"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"云端状态和连接设置"}}
    }},
    "artwork and metadata choices": {"localizations": {
      "en":{"stringUnit":{"state":"translated","value":"artwork and metadata choices"}},"fr":{"stringUnit":{"state":"translated","value":"illustrations et infos personnalisées"}},"it":{"stringUnit":{"state":"translated","value":"immagini e metadati personalizzati"}},"de":{"stringUnit":{"state":"translated","value":"ausgewählte Bilder und Metadaten"}},"es":{"stringUnit":{"state":"translated","value":"imágenes y datos personalizados"}},"pt-BR":{"stringUnit":{"state":"translated","value":"imagens e informações personalizadas"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"自定义图片和游戏信息"}}
    }},
    "sound packs": {"localizations": {
      "en":{"stringUnit":{"state":"translated","value":"sound packs"}},"fr":{"stringUnit":{"state":"translated","value":"packs sonores"}},"it":{"stringUnit":{"state":"translated","value":"pacchetti sonori"}},"de":{"stringUnit":{"state":"translated","value":"Soundpakete"}},"es":{"stringUnit":{"state":"translated","value":"paquetes de sonidos"}},"pt-BR":{"stringUnit":{"state":"translated","value":"pacotes de sons"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"音效包"}}
    }},
    "Oort NX will use the configured cloud library again without moving your files.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"Oort NX will use the configured cloud library again without moving your files."}}, "fr": {"stringUnit":{"state":"translated","value":"Oort NX utilisera de nouveau la bibliothèque cloud configurée sans déplacer vos fichiers."}}, "it": {"stringUnit":{"state":"translated","value":"Oort NX userà di nuovo la libreria cloud configurata senza spostare i tuoi file."}}, "de": {"stringUnit":{"state":"translated","value":"Oort NX verwendet wieder die eingerichtete Cloud-Bibliothek, ohne deine Dateien zu verschieben."}}, "es": {"stringUnit":{"state":"translated","value":"Oort NX volverá a usar la biblioteca en la nube configurada sin mover tus archivos."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Oort NX voltará a usar a biblioteca na nuvem configurada sem mover seus arquivos."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"Oort NX 将重新使用已配置的云游戏库，不会移动你的文件。"}}
    }},
    "Oort NX will stop using the cloud library without moving your files.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"Oort NX will stop using the cloud library without moving your files."}}, "fr": {"stringUnit":{"state":"translated","value":"Oort NX cessera d’utiliser la bibliothèque cloud sans déplacer vos fichiers."}}, "it": {"stringUnit":{"state":"translated","value":"Oort NX smetterà di usare la libreria cloud senza spostare i tuoi file."}}, "de": {"stringUnit":{"state":"translated","value":"Oort NX verwendet die Cloud-Bibliothek nicht mehr, ohne deine Dateien zu verschieben."}}, "es": {"stringUnit":{"state":"translated","value":"Oort NX dejará de usar la biblioteca en la nube sin mover tus archivos."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Oort NX deixará de usar a biblioteca na nuvem sem mover seus arquivos."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"Oort NX 将停止使用云游戏库，不会移动你的文件。"}}
    }},
    "Games available only from this reference will leave your library, but no files will be deleted.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"Games available only from this reference will leave your library, but no files will be deleted."}}, "fr": {"stringUnit":{"state":"translated","value":"Les jeux disponibles uniquement dans cette référence disparaîtront de votre bibliothèque, mais aucun fichier ne sera supprimé."}}, "it": {"stringUnit":{"state":"translated","value":"I giochi disponibili solo in questo riferimento usciranno dalla tua libreria, ma nessun file verrà eliminato."}}, "de": {"stringUnit":{"state":"translated","value":"Spiele, die nur in dieser Referenz verfügbar sind, verschwinden aus deiner Bibliothek, aber keine Dateien werden gelöscht."}}, "es": {"stringUnit":{"state":"translated","value":"Los juegos disponibles solo en esta referencia desaparecerán de tu biblioteca, pero no se borrará ningún archivo."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Os jogos disponíveis apenas nesta referência sairão da sua biblioteca, mas nenhum arquivo será excluído."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"只在此参考库中可用的游戏将从你的游戏库移除，但不会删除任何文件。"}}
    }},
    "Future builds will require a tested toolchain again, but installed games will stay as they are.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"Future builds will require a tested toolchain again, but installed games will stay as they are."}}, "fr": {"stringUnit":{"state":"translated","value":"Les prochaines compilations exigeront de nouveau des outils testés, sans modifier les jeux installés."}}, "it": {"stringUnit":{"state":"translated","value":"Le prossime compilazioni richiederanno di nuovo una toolchain testata, senza modificare i giochi installati."}}, "de": {"stringUnit":{"state":"translated","value":"Künftige Builds benötigen wieder eine getestete Toolchain, installierte Spiele bleiben unverändert."}}, "es": {"stringUnit":{"state":"translated","value":"Las próximas compilaciones volverán a requerir herramientas probadas, sin modificar los juegos instalados."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"As próximas compilações voltarão a exigir ferramentas testadas, sem alterar os jogos instalados."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"今后的构建将重新要求使用经过测试的工具链，已安装的游戏不受影响。"}}
    }},
    "Future builds will use the tested engine (%@), but installed games will stay as they are.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"Future builds will use the tested engine (%@), but installed games will stay as they are."}}, "fr": {"stringUnit":{"state":"translated","value":"Les prochaines compilations utiliseront le moteur testé (%@), sans modifier les jeux installés."}}, "it": {"stringUnit":{"state":"translated","value":"Le prossime compilazioni useranno il motore testato (%@), senza modificare i giochi installati."}}, "de": {"stringUnit":{"state":"translated","value":"Künftige Builds verwenden die getestete Engine (%@), installierte Spiele bleiben unverändert."}}, "es": {"stringUnit":{"state":"translated","value":"Las próximas compilaciones usarán el motor probado (%@), sin modificar los juegos instalados."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"As próximas compilações usarão o motor testado (%@), sem alterar os jogos instalados."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"今后的构建将使用已测试的引擎（%@），已安装的游戏不受影响。"}}
    }},
    "Future builds will use the untested engine (%@), but installed games will stay as they are.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"Future builds will use the untested engine (%@), but installed games will stay as they are."}}, "fr": {"stringUnit":{"state":"translated","value":"Les prochaines compilations utiliseront le moteur non testé (%@), sans modifier les jeux installés."}}, "it": {"stringUnit":{"state":"translated","value":"Le prossime compilazioni useranno il motore non testato (%@), senza modificare i giochi installati."}}, "de": {"stringUnit":{"state":"translated","value":"Künftige Builds verwenden die ungetestete Engine (%@), installierte Spiele bleiben unverändert."}}, "es": {"stringUnit":{"state":"translated","value":"Las próximas compilaciones usarán el motor sin probar (%@), sin modificar los juegos instalados."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"As próximas compilações usarão o motor não testado (%@), sem alterar os jogos instalados."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"今后的构建将使用未经测试的引擎（%@），已安装的游戏不受影响。"}}
    }},
    "Local play will use the VPN setting “%@” and reset the adapter to Automatic without changing macOS network settings.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"Local play will use the VPN setting “%@” and reset the adapter to Automatic without changing macOS network settings."}}, "fr": {"stringUnit":{"state":"translated","value":"Le jeu local utilisera le réglage VPN « %@ » et remettra l’adaptateur sur Automatique, sans modifier le réseau de macOS."}}, "it": {"stringUnit":{"state":"translated","value":"Il gioco locale userà l’impostazione VPN «%@» e riporterà l’adattatore su Automatico, senza cambiare le impostazioni di rete di macOS."}}, "de": {"stringUnit":{"state":"translated","value":"Lokales Spielen nutzt die VPN-Einstellung „%@“ und stellt den Adapter auf Automatisch, ohne die macOS-Netzwerkeinstellungen zu ändern."}}, "es": {"stringUnit":{"state":"translated","value":"El juego local usará el ajuste de VPN «%@» y pondrá el adaptador en Automático sin cambiar la configuración de red de macOS."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"O jogo local usará a opção de VPN “%@” e voltará o adaptador para Automático, sem alterar a rede do macOS."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"本地联机将使用 VPN 设置“%@”，并将适配器恢复为自动，不会更改 macOS 的网络设置。"}}
    }},
    "The default will change to “%@” for future launches, but each game’s own choice will stay in place.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"The default will change to “%@” for future launches, but each game’s own choice will stay in place."}}, "fr": {"stringUnit":{"state":"translated","value":"Le réglage par défaut passera à « %@ » aux prochains lancements, sans remplacer les choix propres à chaque jeu."}}, "it": {"stringUnit":{"state":"translated","value":"Il valore predefinito sarà «%@» ai prossimi avvii, senza sostituire le scelte dei singoli giochi."}}, "de": {"stringUnit":{"state":"translated","value":"Bei künftigen Starts gilt standardmäßig „%@“, die Einstellungen einzelner Spiele bleiben unverändert."}}, "es": {"stringUnit":{"state":"translated","value":"El valor predeterminado será «%@» en los próximos inicios, sin sustituir las opciones de cada juego."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"O padrão para os próximos inícios será “%@”, sem substituir as opções de cada jogo."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"今后启动游戏时将默认使用“%@”，各游戏单独设置的选项不受影响。"}}
    }},
    "Future local games will prefer “%@” without changing macOS network settings.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"Future local games will prefer “%@” without changing macOS network settings."}}, "fr": {"stringUnit":{"state":"translated","value":"Les prochaines parties locales privilégieront le mode « %@ », sans modifier le réseau de macOS."}}, "it": {"stringUnit":{"state":"translated","value":"Le prossime partite locali daranno la precedenza a «%@», senza cambiare le impostazioni di rete di macOS."}}, "de": {"stringUnit":{"state":"translated","value":"Künftige lokale Partien bevorzugen „%@“, ohne die macOS-Netzwerkeinstellungen zu ändern."}}, "es": {"stringUnit":{"state":"translated","value":"Las próximas partidas locales preferirán «%@» sin cambiar la configuración de red de macOS."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"As próximas partidas locais darão preferência a “%@”, sem alterar a rede do macOS."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"今后的本地联机将优先使用“%@”，不会更改 macOS 的网络设置。"}}
    }},
    "Future local games will use the adapter setting “%@” without changing macOS network settings.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"Future local games will use the adapter setting “%@” without changing macOS network settings."}}, "fr": {"stringUnit":{"state":"translated","value":"Les prochaines parties locales utiliseront le réglage d’adaptateur « %@ », sans modifier le réseau de macOS."}}, "it": {"stringUnit":{"state":"translated","value":"Le prossime partite locali useranno l’impostazione dell’adattatore «%@», senza cambiare le impostazioni di rete di macOS."}}, "de": {"stringUnit":{"state":"translated","value":"Künftige lokale Partien nutzen die Adaptereinstellung „%@“, ohne die macOS-Netzwerkeinstellungen zu ändern."}}, "es": {"stringUnit":{"state":"translated","value":"Las próximas partidas locales usarán el ajuste de adaptador «%@» sin cambiar la configuración de red de macOS."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"As próximas partidas locais usarão a opção de adaptador “%@”, sem alterar a rede do macOS."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"今后的本地联机将使用适配器设置“%@”，不会更改 macOS 的网络设置。"}}
    }},
    "Multiplayer defaults will be restored without changing individual game choices or the Nextendo client ID.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"Multiplayer defaults will be restored without changing individual game choices or the Nextendo client ID."}}, "fr": {"stringUnit":{"state":"translated","value":"Les réglages multijoueur par défaut seront rétablis, sans modifier les choix propres à chaque jeu ni l’identifiant client Nextendo."}}, "it": {"stringUnit":{"state":"translated","value":"Le impostazioni multigiocatore predefinite saranno ripristinate, senza cambiare le scelte dei singoli giochi o l’ID client Nextendo."}}, "de": {"stringUnit":{"state":"translated","value":"Die Mehrspieler-Standardeinstellungen werden wiederhergestellt, ohne Einstellungen einzelner Spiele oder die Nextendo-Client-ID zu ändern."}}, "es": {"stringUnit":{"state":"translated","value":"Se restaurarán los ajustes multijugador predeterminados sin cambiar las opciones de cada juego ni el ID de cliente de Nextendo."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Os padrões de multijogador serão restaurados sem alterar as opções de cada jogo nem o ID do cliente Nextendo."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"多人游戏设置将恢复默认，各游戏的独立选项和 Nextendo 客户端 ID 不受影响。"}}
    }},
    "Import only sounds you have the right to use.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"Import only sounds you have the right to use."}}, "fr": {"stringUnit":{"state":"translated","value":"N’importez que des sons que vous avez le droit d’utiliser."}}, "it": {"stringUnit":{"state":"translated","value":"Importa solo suoni che hai il diritto di usare."}}, "de": {"stringUnit":{"state":"translated","value":"Importiere nur Klänge, die du verwenden darfst."}}, "es": {"stringUnit":{"state":"translated","value":"Importa solo sonidos que tengas derecho a usar."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Importe apenas sons que você tem o direito de usar."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"请仅导入你有权使用的声音。"}}
    }},
    "No sound for this event.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"No sound for this event."}}, "fr": {"stringUnit":{"state":"translated","value":"Aucun son pour cet événement."}}, "it": {"stringUnit":{"state":"translated","value":"Nessun suono per questo evento."}}, "de": {"stringUnit":{"state":"translated","value":"Kein Klang für dieses Ereignis."}}, "es": {"stringUnit":{"state":"translated","value":"No hay sonido para este evento."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Não há som para este evento."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"此事件没有声音。"}}
    }},
    "Sound to preview": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"Sound to preview"}}, "fr": {"stringUnit":{"state":"translated","value":"Son à écouter"}}, "it": {"stringUnit":{"state":"translated","value":"Suono da ascoltare"}}, "de": {"stringUnit":{"state":"translated","value":"Klang zum Anhören"}}, "es": {"stringUnit":{"state":"translated","value":"Sonido para escuchar"}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Som para ouvir"}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"选择试听声音"}}
    }},
    "Preview sound": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"Preview sound"}}, "fr": {"stringUnit":{"state":"translated","value":"Aperçu du son"}}, "it": {"stringUnit":{"state":"translated","value":"Anteprima audio"}}, "de": {"stringUnit":{"state":"translated","value":"Klangvorschau"}}, "es": {"stringUnit":{"state":"translated","value":"Vista previa del sonido"}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Prévia do som"}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"声音试听"}}
    }},
    "Return from game": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"Return from game"}}, "fr": {"stringUnit":{"state":"translated","value":"Retour du jeu"}}, "it": {"stringUnit":{"state":"translated","value":"Ritorno dal gioco"}}, "de": {"stringUnit":{"state":"translated","value":"Rückkehr vom Spiel"}}, "es": {"stringUnit":{"state":"translated","value":"Volver del juego"}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Voltar do jogo"}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"从游戏返回"}}
    }},
    "Put manifest.json and the listed WAV files at the root of the sound pack. Links and other files are not allowed.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"Put manifest.json and the listed WAV files at the root of the sound pack. Links and other files are not allowed."}}, "fr": {"stringUnit":{"state":"translated","value":"Placez manifest.json et les WAV indiqués à la racine du pack, sans lien ni autre fichier."}}, "it": {"stringUnit":{"state":"translated","value":"Metti manifest.json e i WAV elencati alla radice del pacchetto, senza link o altri file."}}, "de": {"stringUnit":{"state":"translated","value":"Lege manifest.json und die aufgeführten WAV-Dateien ins Hauptverzeichnis, ohne Links oder andere Dateien."}}, "es": {"stringUnit":{"state":"translated","value":"Coloca manifest.json y los WAV indicados en la raíz, sin enlaces ni otros archivos."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Coloque manifest.json e os WAV listados na raiz do pacote, sem links ou outros arquivos."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"请将 manifest.json 和列出的 WAV 文件放在包的根目录，不要包含链接或其他文件。"}}
    }},
    "The sound pack manifest is invalid. Check its format, details and event names.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"The sound pack manifest is invalid. Check its format, details and event names."}}, "fr": {"stringUnit":{"state":"translated","value":"Le manifeste est invalide. Vérifiez le format, les informations et les noms des événements."}}, "it": {"stringUnit":{"state":"translated","value":"Il manifest non è valido. Controlla formato, dati e nomi degli eventi."}}, "de": {"stringUnit":{"state":"translated","value":"Das Manifest ist ungültig. Prüfe Format, Angaben und Ereignisnamen."}}, "es": {"stringUnit":{"state":"translated","value":"El manifiesto no es válido. Revisa el formato, los datos y los nombres de eventos."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"O manifesto é inválido. Confira o formato, os dados e os nomes dos eventos."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"声音包清单无效。请检查格式、详情和事件名称。"}}
    }},
    "A sound is too loud, too long or not a supported WAV. Use 24 kHz, 16-bit mono PCM.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"A sound is too loud, too long or not a supported WAV. Use 24 kHz, 16-bit mono PCM."}}, "fr": {"stringUnit":{"state":"translated","value":"Un son est trop fort, trop long ou incompatible. Utilisez du WAV PCM mono 16 bits à 24 kHz."}}, "it": {"stringUnit":{"state":"translated","value":"Un suono è troppo forte, lungo o incompatibile. Usa WAV PCM mono a 24 kHz e 16 bit."}}, "de": {"stringUnit":{"state":"translated","value":"Ein Klang ist zu laut, zu lang oder inkompatibel. Verwende WAV PCM, Mono, 24 kHz, 16 Bit."}}, "es": {"stringUnit":{"state":"translated","value":"Un sonido es demasiado fuerte, largo o incompatible. Usa WAV PCM mono de 24 kHz y 16 bits."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Um som é muito alto, longo ou incompatível. Use WAV PCM mono de 24 kHz e 16 bits."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"有声音过响、过长或不受支持。请使用 24 kHz、16 位单声道 PCM WAV。"}}
    }},
    "This sound pack ZIP is invalid or uses an unsupported ZIP option.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"This sound pack ZIP is invalid or uses an unsupported ZIP option."}}, "fr": {"stringUnit":{"state":"translated","value":"Le ZIP est invalide ou utilise une option non prise en charge."}}, "it": {"stringUnit":{"state":"translated","value":"Lo ZIP non è valido o usa un’opzione non supportata."}}, "de": {"stringUnit":{"state":"translated","value":"Die ZIP-Datei ist ungültig oder nutzt eine nicht unterstützte Option."}}, "es": {"stringUnit":{"state":"translated","value":"El ZIP no es válido o usa una opción incompatible."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"O ZIP é inválido ou usa uma opção incompatível."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"ZIP 文件无效或包含不受支持的选项。"}}
    }},
    "This sound pack is too large. Use up to 40 files and 4 MB.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"This sound pack is too large. Use up to 40 files and 4 MB."}}, "fr": {"stringUnit":{"state":"translated","value":"Le pack est trop volumineux. Limites : 40 fichiers et 4 Mio."}}, "it": {"stringUnit":{"state":"translated","value":"Il pacchetto è troppo grande. Limiti: 40 file e 4 MiB."}}, "de": {"stringUnit":{"state":"translated","value":"Das Paket ist zu groß. Maximal 40 Dateien und 4 MiB."}}, "es": {"stringUnit":{"state":"translated","value":"El paquete es demasiado grande. Máximo: 40 archivos y 4 MiB."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"O pacote é grande demais. Limites: 40 arquivos e 4 MiB."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"声音包过大。最多 40 个文件，总大小不超过 4 MiB。"}}
    }},
    "This sound pack is unavailable.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"This sound pack is unavailable."}}, "fr": {"stringUnit":{"state":"translated","value":"Ce pack est indisponible."}}, "it": {"stringUnit":{"state":"translated","value":"Pacchetto non disponibile."}}, "de": {"stringUnit":{"state":"translated","value":"Dieses Soundpaket ist nicht verfügbar."}}, "es": {"stringUnit":{"state":"translated","value":"El paquete no está disponible."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"O pacote não está disponível."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"此声音包不可用。"}}
    }},
    "A sound pack with this ID is already installed. Remove the old copy before importing another.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"A sound pack with this ID is already installed. Remove the old copy before importing another."}}, "fr": {"stringUnit":{"state":"translated","value":"Un pack porte déjà cet identifiant. Retirez sa copie avant d’en importer une autre."}}, "it": {"stringUnit":{"state":"translated","value":"Esiste già un pacchetto con questo ID. Rimuovi la vecchia copia prima di importarne un’altra."}}, "de": {"stringUnit":{"state":"translated","value":"Diese ID ist bereits installiert. Entferne die Kopie vor dem erneuten Import."}}, "es": {"stringUnit":{"state":"translated","value":"Ya existe un paquete con este ID. Quita la copia anterior antes de importar otra."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Já existe um pacote com este ID. Remova a cópia anterior antes de importar outra."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"相同 ID 的声音包已存在。请移除旧副本再导入。"}}
    }},
    "Remove an imported sound pack before adding another. The limit is 12.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"Remove an imported sound pack before adding another. The limit is 12."}}, "fr": {"stringUnit":{"state":"translated","value":"Retirez un pack importé avant d’en ajouter un autre. Limite : 12 packs."}}, "it": {"stringUnit":{"state":"translated","value":"Rimuovi un pacchetto prima di aggiungerne un altro. Limite: 12."}}, "de": {"stringUnit":{"state":"translated","value":"Entferne vor einem neuen Import ein Paket. Limit: 12."}}, "es": {"stringUnit":{"state":"translated","value":"Quita un paquete antes de añadir otro. Límite: 12."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Remova um pacote antes de adicionar outro. Limite: 12."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"请先移除一个已导入的声音包。最多保留 12 个。"}}
    }},
    "Sound packs": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"Sound packs"}}, "fr": {"stringUnit":{"state":"translated","value":"Packs de sons"}}, "it": {"stringUnit":{"state":"translated","value":"Pacchetti audio"}}, "de": {"stringUnit":{"state":"translated","value":"Soundpakete"}}, "es": {"stringUnit":{"state":"translated","value":"Paquetes de sonido"}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Pacotes de som"}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"声音包"}}
    }},
    "Sound pack": {"localizations": {
