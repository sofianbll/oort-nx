        "es": {"stringUnit": {"state": "translated", "value": "Arcane no pudo verificar la caché de la nube."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "O Arcane não pôde verificar o cache da nuvem."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "Arcane 无法验证云端缓存。"}}
      }
    },
    "Build needs a verified build cache.": {
      "localizations": {
