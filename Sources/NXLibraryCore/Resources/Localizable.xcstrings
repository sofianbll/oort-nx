    "Check the player setup before trying again.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"Check the player setup before trying again."}}, "fr": {"stringUnit":{"state":"translated","value":"Vérifiez les réglages des joueurs avant de réessayer."}}, "it": {"stringUnit":{"state":"translated","value":"Controlla le impostazioni dei giocatori prima di riprovare."}}, "de": {"stringUnit":{"state":"translated","value":"Prüfe die Spielereinstellungen, bevor du es erneut versuchst."}}, "es": {"stringUnit":{"state":"translated","value":"Revisa los ajustes de jugadores antes de volver a intentarlo."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Confira os ajustes dos jogadores antes de tentar novamente."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"请先检查玩家设置，再重试。"}}
