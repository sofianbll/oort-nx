    "Not in the cloud": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Nicht in der Cloud"}},
        "en": {"stringUnit": {"state": "translated", "value": "Not in the cloud"}},
        "es": {"stringUnit": {"state": "translated", "value": "Sin copia en la nube"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Pas dans le cloud"}},
        "it": {"stringUnit": {"state": "translated", "value": "Nessuna copia nel cloud"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Sem cópia na nuvem"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "不在云端"}}
      }
    },
    "Cloud status unknown": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Cloud-Status unbekannt"}},
        "en": {"stringUnit": {"state": "translated", "value": "Cloud status unknown"}},
        "es": {"stringUnit": {"state": "translated", "value": "Estado de la nube desconocido"}},
        "fr": {"stringUnit": {"state": "translated", "value": "État cloud inconnu"}},
        "it": {"stringUnit": {"state": "translated", "value": "Stato cloud sconosciuto"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Status na nuvem desconhecido"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "云端状态未知"}}
      }
    },
    "Cloud operation failed": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Cloud-Vorgang fehlgeschlagen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Cloud operation failed"}},
        "es": {"stringUnit": {"state": "translated", "value": "Operación en la nube fallida"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Échec"}},
        "it": {"stringUnit": {"state": "translated", "value": "Operazione cloud non riuscita"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Falha na operação na nuvem"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "云端操作失败"}}
      }
    },
    "Free up space": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Speicher freigeben"}},
        "en": {"stringUnit": {"state": "translated", "value": "Free up space"}},
        "es": {"stringUnit": {"state": "translated", "value": "Liberar espacio"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Libérer de la place"}},
        "it": {"stringUnit": {"state": "translated", "value": "Libera spazio"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Liberar espaço"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "释放空间"}}
      }
    },
    "After verification, Arcane moves this app to the Trash. Download it again to play. Saves stay on this Mac.": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Nach der Prüfung legt Arcane die Spiel-App in den Papierkorb. Lade sie zum Spielen erneut. Spielstände bleiben auf diesem Mac."}},
        "en": {"stringUnit": {"state": "translated", "value": "After verification, Arcane moves this app to the Trash. Download it again to play. Saves stay on this Mac."}},
        "es": {"stringUnit": {"state": "translated", "value": "Tras verificar la copia, Arcane mueve la app a la Papelera. Descárgala de nuevo para jugar. Las partidas guardadas se quedan en este Mac."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Après vérification, Arcane met l’app à la Corbeille. Téléchargez-la de nouveau pour jouer. Les sauvegardes restent sur ce Mac."}},
        "it": {"stringUnit": {"state": "translated", "value": "Dopo la verifica, Arcane sposta l’app nel Cestino. Scaricala di nuovo per giocare. I salvataggi restano su questo Mac."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Após a verificação, Arcane move o app para o Lixo. Baixe-o de novo para jogar. Os dados salvos ficam neste Mac."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "验证后，Arcane 会将此应用移到废纸篓。要游玩，请重新下载。存档会保留在此 Mac 上。"}}
      }
    },
    "After verification, Arcane moves this build cache to the Trash. Game files and saves stay on this Mac.": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Nach der Prüfung legt Arcane diesen Build-Cache in den Papierkorb. Spieldateien und Spielstände bleiben auf diesem Mac."}},
        "en": {"stringUnit": {"state": "translated", "value": "After verification, Arcane moves this build cache to the Trash. Game files and saves stay on this Mac."}},
        "es": {"stringUnit": {"state": "translated", "value": "Tras verificar la copia, Arcane mueve la caché a la Papelera. Los archivos y las partidas guardadas se quedan en este Mac."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Après vérification, Arcane met le cache de compilation à la Corbeille. Les fichiers du jeu et les sauvegardes restent sur ce Mac."}},
        "it": {"stringUnit": {"state": "translated", "value": "Dopo la verifica, Arcane sposta la cache di compilazione nel Cestino. I file del gioco e i salvataggi restano su questo Mac."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Após a verificação, Arcane move o cache de compilação para o Lixo. Os arquivos do jogo e os dados salvos ficam neste Mac."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "验证后，Arcane 会将此构建缓存移到废纸篓。游戏文件和存档会保留在此 Mac 上。"}}
      }
    },
    "Free %@": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "%@ freigeben"}},
        "en": {"stringUnit": {"state": "translated", "value": "Free %@"}},
        "es": {"stringUnit": {"state": "translated", "value": "Liberar %@"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Libérer %@"}},
        "it": {"stringUnit": {"state": "translated", "value": "Libera %@"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Liberar %@"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "释放 %@"}}
      }
    },
    "Sent %@": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Hochgeladen %@"}},
        "en": {"stringUnit": {"state": "translated", "value": "Sent %@"}},
        "es": {"stringUnit": {"state": "translated", "value": "Enviado %@"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Envoyé %@"}},
        "it": {"stringUnit": {"state": "translated", "value": "Inviato %@"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Enviado %@"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "已发送 %@"}}
      }
    },
    "Transfer cancelled.": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Übertragung abgebrochen."}},
        "en": {"stringUnit": {"state": "translated", "value": "Transfer cancelled."}},
        "es": {"stringUnit": {"state": "translated", "value": "Transferencia cancelada."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Transfert annulé."}},
        "it": {"stringUnit": {"state": "translated", "value": "Trasferimento annullato."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Transferência cancelada."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "传输已取消。"}}
      }
    },
    "Import games from the cloud": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Spiele aus der Cloud importieren"}},
        "en": {"stringUnit": {"state": "translated", "value": "Import games from the cloud"}},
        "es": {"stringUnit": {"state": "translated", "value": "Importar juegos de la nube"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Importer les jeux du cloud"}},
        "it": {"stringUnit": {"state": "translated", "value": "Importa i giochi dal cloud"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Importar jogos da nuvem"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "从云端导入游戏"}}
      }
    },
    "Add missing games without downloading their apps.": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Fehlende Spiele hinzufügen, ohne ihre Apps herunterzuladen."}},
        "en": {"stringUnit": {"state": "translated", "value": "Add missing games without downloading their apps."}},
        "es": {"stringUnit": {"state": "translated", "value": "Añade los juegos que faltan sin descargar sus apps."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Ajoutez les jeux manquants sans télécharger leurs apps."}},
        "it": {"stringUnit": {"state": "translated", "value": "Aggiungi i giochi mancanti senza scaricare le app."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Adicione os jogos ausentes sem baixar seus apps."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "添加缺少的游戏，不下载其应用。"}}
      }
    },
    "New cloud games are in your library.": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Neue Spiele aus der Cloud sind in deiner Bibliothek."}},
        "en": {"stringUnit": {"state": "translated", "value": "New cloud games are in your library."}},
        "es": {"stringUnit": {"state": "translated", "value": "Ya tienes nuevos juegos de la nube en tu biblioteca."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les nouveaux jeux du cloud sont dans votre bibliothèque."}},
        "it": {"stringUnit": {"state": "translated", "value": "I nuovi giochi dal cloud sono nella libreria."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Os novos jogos da nuvem estão na sua biblioteca."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "新的云端游戏已添加到游戏库。"}}
      }
    },
    "No new cloud games.": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Keine neuen Spiele in der Cloud."}},
        "en": {"stringUnit": {"state": "translated", "value": "No new cloud games."}},
        "es": {"stringUnit": {"state": "translated", "value": "No hay nuevos juegos en la nube."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Aucun nouveau jeu dans le cloud."}},
        "it": {"stringUnit": {"state": "translated", "value": "Nessun nuovo gioco nel cloud."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Nenhum jogo novo na nuvem."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "没有新的云端游戏。"}}
      }
    },
    "Cloud storage is unavailable. Check rclone and try again.": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Der Cloud-Speicher ist nicht verfügbar. Prüfe rclone und versuche es erneut."}},
        "en": {"stringUnit": {"state": "translated", "value": "Cloud storage is unavailable. Check rclone and try again."}},
        "es": {"stringUnit": {"state": "translated", "value": "El almacenamiento en la nube no está disponible. Comprueba rclone y vuelve a intentarlo."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Le stockage cloud est indisponible. Vérifiez rclone et réessayez."}},
        "it": {"stringUnit": {"state": "translated", "value": "Lo spazio cloud non è disponibile. Controlla rclone e riprova."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "O armazenamento na nuvem está indisponível. Verifique o rclone e tente novamente."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "云端存储不可用。请检查 rclone 后重试。"}}
      }
    },
    "Offline — Google Drive is unreachable.": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Offline – Google Drive ist nicht erreichbar."}},
        "en": {"stringUnit": {"state": "translated", "value": "Offline — Google Drive is unreachable."}},
        "es": {"stringUnit": {"state": "translated", "value": "Sin conexión: no se puede acceder a Google Drive."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Hors ligne : Google Drive est injoignable."}},
        "it": {"stringUnit": {"state": "translated", "value": "Offline: Google Drive non è raggiungibile."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Offline: não foi possível acessar o Google Drive."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "离线：无法连接到 Google Drive。"}}
      }
    },
    "Google Drive sign-in expired or was revoked.": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Die Anmeldung bei Google Drive ist abgelaufen oder wurde widerrufen."}},
        "en": {"stringUnit": {"state": "translated", "value": "Google Drive sign-in expired or was revoked."}},
        "es": {"stringUnit": {"state": "translated", "value": "La sesión de Google Drive ha caducado o se ha revocado."}},
        "fr": {"stringUnit": {"state": "translated", "value": "La connexion à Google Drive a expiré ou a été révoquée."}},
        "it": {"stringUnit": {"state": "translated", "value": "L'accesso a Google Drive è scaduto o è stato revocato."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "O acesso ao Google Drive expirou ou foi revogado."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "Google Drive 登录已过期，或访问权限已被撤销。"}}
      }
    },
    "Cloud folder not found.": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Cloud-Ordner nicht gefunden."}},
        "en": {"stringUnit": {"state": "translated", "value": "Cloud folder not found."}},
        "es": {"stringUnit": {"state": "translated", "value": "No se encuentra la carpeta en la nube."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Dossier cloud introuvable."}},
        "it": {"stringUnit": {"state": "translated", "value": "Cartella cloud non trovata."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Pasta na nuvem não encontrada."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "未找到云端文件夹。"}}
      }
    },
    "Google Drive is full.": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Google Drive ist voll."}},
        "en": {"stringUnit": {"state": "translated", "value": "Google Drive is full."}},
        "es": {"stringUnit": {"state": "translated", "value": "Google Drive está lleno."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Google Drive est plein."}},
        "it": {"stringUnit": {"state": "translated", "value": "Google Drive è pieno."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "O Google Drive está cheio."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "Google Drive 存储空间已满。"}}
      }
    },
    "Not enough space on this Mac.": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Nicht genug Speicherplatz auf diesem Mac."}},
        "en": {"stringUnit": {"state": "translated", "value": "Not enough space on this Mac."}},
        "es": {"stringUnit": {"state": "translated", "value": "No hay espacio suficiente en este Mac."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Espace insuffisant sur ce Mac."}},
        "it": {"stringUnit": {"state": "translated", "value": "Spazio insufficiente su questo Mac."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Não há espaço suficiente neste Mac."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "此 Mac 的可用空间不足。"}}
      }
    },
    "Not enough space on %@.": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Nicht genug Speicherplatz auf %@."}},
        "en": {"stringUnit": {"state": "translated", "value": "Not enough space on %@."}},
        "es": {"stringUnit": {"state": "translated", "value": "No hay espacio suficiente en %@."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Espace insuffisant sur %@."}},
        "it": {"stringUnit": {"state": "translated", "value": "Spazio insufficiente su %@."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Não há espaço suficiente em %@."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "%@ 的可用空间不足。"}}
      }
    },
    "Replace %@ on this Mac with the app from the reference library? The previous app will be kept.": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "%@ auf diesem Mac durch die App aus der Referenzbibliothek ersetzen? Die bisherige App bleibt erhalten."}},
        "en": {"stringUnit": {"state": "translated", "value": "Replace %@ on this Mac with the app from the reference library? The previous app will be kept."}},
        "es": {"stringUnit": {"state": "translated", "value": "¿Reemplazar %@ en este Mac por la app de la biblioteca de referencia? Se conservará la app anterior."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Remplacer %@ sur ce Mac par l’app de la bibliothèque de référence ? L’app précédente sera conservée."}},
        "it": {"stringUnit": {"state": "translated", "value": "Sostituire %@ su questo Mac con l’app della libreria di riferimento? L’app precedente verrà conservata."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Substituir %@ neste Mac pelo app da biblioteca de referência? O app anterior será mantido."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "要使用参考库中的应用替换此 Mac 上的 %@ 吗？原应用将保留。"}}
      }
    },
    "Ambiguous cloud game files: %@.": {"localizations": {
      "en": {"stringUnit": {"state": "translated", "value": "Ambiguous cloud game files: %@."}},
      "it": {"stringUnit": {"state": "translated", "value": "File di gioco ambigui nel cloud: %@."}},
      "fr": {"stringUnit": {"state": "translated", "value": "Fichiers de jeu ambigus dans le cloud : %@."}},
      "de": {"stringUnit": {"state": "translated", "value": "Nicht eindeutig zuordenbare Spieldateien in der Cloud: %@."}},
      "es": {"stringUnit": {"state": "translated", "value": "Archivos de juego ambiguos en la nube: %@."}},
      "pt-BR": {"stringUnit": {"state": "translated", "value": "Arquivos de jogo ambíguos na nuvem: %@."}},
      "zh-Hans": {"stringUnit": {"state": "translated", "value": "以下云端游戏文件无法唯一识别：%@。"}}
    }},
    "Unreadable cloud game files: %@.": {"localizations": {
      "en": {"stringUnit": {"state": "translated", "value": "Unreadable cloud game files: %@."}},
      "it": {"stringUnit": {"state": "translated", "value": "File di gioco illeggibili nel cloud: %@."}},
      "fr": {"stringUnit": {"state": "translated", "value": "Fichiers de jeu illisibles dans le cloud : %@."}},
      "de": {"stringUnit": {"state": "translated", "value": "Nicht lesbare Spieldateien in der Cloud: %@."}},
      "es": {"stringUnit": {"state": "translated", "value": "Archivos de juego ilegibles en la nube: %@."}},
      "pt-BR": {"stringUnit": {"state": "translated", "value": "Arquivos de jogo ilegíveis na nuvem: %@."}},
      "zh-Hans": {"stringUnit": {"state": "translated", "value": "以下云端游戏文件无法读取：%@。"}}
    }},
    "Could not list cloud game files.": {"localizations": {
      "en": {"stringUnit": {"state": "translated", "value": "Could not list cloud game files."}},
      "it": {"stringUnit": {"state": "translated", "value": "Impossibile elencare i file di gioco nel cloud."}},
      "fr": {"stringUnit": {"state": "translated", "value": "Impossible de lister les fichiers de jeu dans le cloud."}},
      "de": {"stringUnit": {"state": "translated", "value": "Spieldateien in der Cloud konnten nicht aufgelistet werden."}},
      "es": {"stringUnit": {"state": "translated", "value": "No se pudieron enumerar los archivos de juego en la nube."}},
      "pt-BR": {"stringUnit": {"state": "translated", "value": "Não foi possível listar os arquivos de jogo na nuvem."}},
      "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法列出云端游戏文件。"}}
    }},
    "Could not read cloud game records for: %@.": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Cloud-Spieleinträge konnten nicht gelesen werden: %@."}},
        "en": {"stringUnit": {"state": "translated", "value": "Could not read cloud game records for: %@."}},
        "es": {"stringUnit": {"state": "translated", "value": "No se pudieron leer los registros de estos juegos en la nube: %@."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Impossible de lire les fiches de jeux dans le cloud : %@."}},
        "it": {"stringUnit": {"state": "translated", "value": "Impossibile leggere le schede dei giochi nel cloud: %@."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Não foi possível ler as fichas dos jogos na nuvem: %@."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法读取以下云端游戏记录：%@。"}}
      }
    },
    "These games were not added from these cloud copies because their information could not be read: %@.": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Diese Spiele wurden aus diesen Cloud-Kopien nicht hinzugefügt, weil ihre Informationen nicht lesbar waren: %@."}},
        "en": {"stringUnit": {"state": "translated", "value": "These games were not added from these cloud copies because their information could not be read: %@."}},
        "es": {"stringUnit": {"state": "translated", "value": "Estos juegos no se añadieron desde estas copias en la nube porque no se pudo leer su información: %@."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Les informations de ces jeux sont illisibles. Ils n’ont pas été ajoutés depuis ces copies cloud : %@."}},
        "it": {"stringUnit": {"state": "translated", "value": "Questi giochi non sono stati aggiunti da queste copie nel cloud perché non è stato possibile leggerne le informazioni: %@."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Estes jogos não foram adicionados a partir destas cópias na nuvem porque não foi possível ler suas informações: %@."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "由于无法读取游戏信息，未从这些云端副本添加以下游戏：%@。"}}
      }
    },
    "Previous destination: %@": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Previous destination: %@"}},
        "it": {"stringUnit": {"state": "translated", "value": "Destinazione precedente: %@"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Destination précédente : %@"}},
        "de": {"stringUnit": {"state": "translated", "value": "Vorheriges Ziel: %@"}},
        "es": {"stringUnit": {"state": "translated", "value": "Destino anterior: %@"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Destino anterior: %@"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "原目标位置：%@"}}
      }
    },
    "Open Cloud library to review and confirm this transfer again.": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Öffne die Cloud-Bibliothek, um diese Übertragung zu prüfen und erneut zu bestätigen."}},
        "en": {"stringUnit": {"state": "translated", "value": "Open Cloud library to review and confirm this transfer again."}},
        "es": {"stringUnit": {"state": "translated", "value": "Abre la biblioteca en la nube para revisar y confirmar de nuevo esta transferencia."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Ouvrez la bibliothèque cloud pour vérifier et confirmer à nouveau ce transfert."}},
        "it": {"stringUnit": {"state": "translated", "value": "Apri la libreria cloud per verificare e confermare di nuovo questo trasferimento."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Abra a biblioteca na nuvem para revisar e confirmar novamente esta transferência."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "打开云端库，检查并重新确认此传输。"}}
      }
    },
    "Open Cloud library to confirm replacing the app on this Mac.": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Öffne die Cloud-Bibliothek, um das Ersetzen der App auf diesem Mac zu bestätigen."}},
        "en": {"stringUnit": {"state": "translated", "value": "Open Cloud library to confirm replacing the app on this Mac."}},
        "es": {"stringUnit": {"state": "translated", "value": "Abre la biblioteca en la nube para confirmar el reemplazo de la app en este Mac."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Ouvrez la bibliothèque cloud pour confirmer le remplacement de l’app sur ce Mac."}},
        "it": {"stringUnit": {"state": "translated", "value": "Apri la libreria cloud per confermare la sostituzione dell’app su questo Mac."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Abra a biblioteca na nuvem para confirmar a substituição do app neste Mac."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "打开云端库，确认替换此 Mac 上的应用。"}}
      }
    },
    "Previous app: %@": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Bisherige App: %@"}},
        "en": {"stringUnit": {"state": "translated", "value": "Previous app: %@"}},
        "es": {"stringUnit": {"state": "translated", "value": "App anterior: %@"}},
        "fr": {"stringUnit": {"state": "translated", "value": "App précédente : %@"}},
        "it": {"stringUnit": {"state": "translated", "value": "App precedente: %@"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "App anterior: %@"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "原应用：%@"}}
      }
    },
    "The cloud queue could not be saved. Transfers continue, but may not resume after quitting.": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Die Cloud-Warteschlange konnte nicht gespeichert werden. Übertragungen laufen weiter, werden nach dem Beenden aber möglicherweise nicht fortgesetzt."}},
        "en": {"stringUnit": {"state": "translated", "value": "The cloud queue could not be saved. Transfers continue, but may not resume after quitting."}},
        "es": {"stringUnit": {"state": "translated", "value": "No se pudo guardar la cola de la nube. Las transferencias siguen, pero quizá no se reanuden al volver a abrir la aplicación."}},
        "fr": {"stringUnit": {"state": "translated", "value": "La file cloud n’a pas pu être enregistrée. Les transferts continuent, mais pourraient ne pas reprendre après avoir quitté Arcane."}},
        "it": {"stringUnit": {"state": "translated", "value": "Impossibile salvare la coda cloud. I trasferimenti continuano, ma potrebbero non riprendere dopo la chiusura."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Não foi possível salvar a fila da nuvem. As transferências continuam, mas talvez não sejam retomadas ao reabrir o app."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法保存云端传输队列。传输会继续，但退出后可能无法恢复。"}}
      }
    },
    "Reconnect": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Erneut anmelden"}},
        "en": {"stringUnit": {"state": "translated", "value": "Reconnect"}},
        "es": {"stringUnit": {"state": "translated", "value": "Volver a conectar"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Se reconnecter"}},
        "it": {"stringUnit": {"state": "translated", "value": "Riconnetti"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Reconectar"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "重新连接"}}
      }
    },
    "Choose a Google Drive connection configured directly in rclone.": {"localizations": {
      "en": {"stringUnit": {"state": "translated", "value": "Choose a Google Drive connection configured directly in rclone."}},
      "it": {"stringUnit": {"state": "translated", "value": "Scegli una connessione Google Drive configurata direttamente in rclone."}},
      "fr": {"stringUnit": {"state": "translated", "value": "Choisissez une connexion Google Drive configurée directement dans rclone."}},
      "de": {"stringUnit": {"state": "translated", "value": "Wähle eine direkt in rclone eingerichtete Google-Drive-Verbindung."}},
      "es": {"stringUnit": {"state": "translated", "value": "Elige una conexión de Google Drive configurada directamente en rclone."}},
      "pt-BR": {"stringUnit": {"state": "translated", "value": "Escolha uma conexão do Google Drive configurada diretamente no rclone."}},
      "zh-Hans": {"stringUnit": {"state": "translated", "value": "请选择直接在 rclone 中配置的 Google 云端硬盘连接。"}}
    }},
    "Choose a folder": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Ordner auswählen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Choose a folder"}},
        "es": {"stringUnit": {"state": "translated", "value": "Elegir una carpeta"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Choisir un dossier"}},
        "it": {"stringUnit": {"state": "translated", "value": "Scegli una cartella"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Escolher uma pasta"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "选择文件夹"}}
      }
    },
    "Manage Google storage": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Google-Speicher verwalten"}},
        "en": {"stringUnit": {"state": "translated", "value": "Manage Google storage"}},
        "es": {"stringUnit": {"state": "translated", "value": "Gestionar el almacenamiento de Google"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Gérer le stockage Google"}},
        "it": {"stringUnit": {"state": "translated", "value": "Gestisci lo spazio Google"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Gerenciar armazenamento do Google"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "管理 Google 存储空间"}}
      }
    },
    "Close the game and wait for other operations to finish.": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Schließe das Spiel und warte, bis andere Vorgänge abgeschlossen sind."}},
        "en": {"stringUnit": {"state": "translated", "value": "Close the game and wait for other operations to finish."}},
        "es": {"stringUnit": {"state": "translated", "value": "Cierra el juego y espera a que terminen las demás operaciones."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Fermez le jeu et attendez la fin des autres opérations."}},
        "it": {"stringUnit": {"state": "translated", "value": "Chiudi il gioco e attendi la fine delle altre operazioni."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Feche o jogo e aguarde o fim das outras operações."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "请关闭游戏，并等待其他操作完成。"}}
      }
    },
    "Not enough free space on the destination drive.": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Nicht genug freier Speicher auf dem Ziellaufwerk."}},
        "en": {"stringUnit": {"state": "translated", "value": "Not enough free space on the destination drive."}},
        "es": {"stringUnit": {"state": "translated", "value": "No hay suficiente espacio libre en el disco de destino."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Espace libre insuffisant sur le disque de destination."}},
        "it": {"stringUnit": {"state": "translated", "value": "Spazio libero insufficiente sul disco di destinazione."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Não há espaço livre suficiente no disco de destino."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "目标磁盘的可用空间不足。"}}
      }
    },
    "The app identity or signature could not be verified.": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Die Identität oder Signatur der App konnte nicht bestätigt werden."}},
        "en": {"stringUnit": {"state": "translated", "value": "The app identity or signature could not be verified."}},
        "es": {"stringUnit": {"state": "translated", "value": "No se pudo verificar la identidad o la firma de la app."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Impossible de vérifier l’identité ou la signature de l’app."}},
        "it": {"stringUnit": {"state": "translated", "value": "Impossibile verificare l’identità o la firma dell’app."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Não foi possível verificar a identidade ou a assinatura do app."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法验证应用的身份或签名。"}}
      }
    },
    "Damaged files or unknown version: download it from Arcane": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Beschädigte Dateien oder unbekannte Version: Lade die App über Arcane herunter"}},
        "en": {"stringUnit": {"state": "translated", "value": "Damaged files or unknown version: download it from Arcane"}},
        "es": {"stringUnit": {"state": "translated", "value": "Archivos dañados o versión desconocida: descárgala desde Arcane"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Fichiers abîmés ou version inconnue : téléchargez l’app depuis Arcane"}},
        "it": {"stringUnit": {"state": "translated", "value": "File danneggiati o versione sconosciuta: scaricala da Arcane"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Arquivos danificados ou versão desconhecida: baixe o app pelo Arcane"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "文件已损坏或版本未知：请通过 Arcane 下载"}}
      }
    },
    "Content not verified": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Inhalt nicht überprüft"}},
        "en": {"stringUnit": {"state": "translated", "value": "Content not verified"}},
        "es": {"stringUnit": {"state": "translated", "value": "Contenido sin verificar"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Contenu non vérifié"}},
        "it": {"stringUnit": {"state": "translated", "value": "Contenuto non verificato"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Conteúdo não verificado"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "内容未经验证"}}
      }
    },
    "This folder contains files that must stay on this Mac.": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Dieser Ordner enthält Dateien, die auf diesem Mac bleiben müssen."}},
        "en": {"stringUnit": {"state": "translated", "value": "This folder contains files that must stay on this Mac."}},
        "es": {"stringUnit": {"state": "translated", "value": "Esta carpeta contiene archivos que deben quedarse en este Mac."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Ce dossier contient des fichiers qui doivent rester sur ce Mac."}},
        "it": {"stringUnit": {"state": "translated", "value": "Questa cartella contiene file che devono restare su questo Mac."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Esta pasta contém arquivos que precisam ficar neste Mac."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "此文件夹包含必须保留在此 Mac 上的文件。"}}
      }
    },
    "The local copy changed. Check it before trying again.": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Die lokale Kopie hat sich geändert. Prüfe sie, bevor du es erneut versuchst."}},
        "en": {"stringUnit": {"state": "translated", "value": "The local copy changed. Check it before trying again."}},
        "es": {"stringUnit": {"state": "translated", "value": "La copia local ha cambiado. Compruébala antes de volver a intentarlo."}},
        "fr": {"stringUnit": {"state": "translated", "value": "La copie locale a changé. Vérifiez-la avant de réessayer."}},
        "it": {"stringUnit": {"state": "translated", "value": "La copia locale è cambiata. Controllala prima di riprovare."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "A cópia local mudou. Verifique-a antes de tentar novamente."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "本机副本已更改。请检查后重试。"}}
      }
    },
    "The app changed during upload (%@). Try again.": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Die App hat sich beim Hochladen geändert (%@). Versuche es erneut."}},
        "en": {"stringUnit": {"state": "translated", "value": "The app changed during upload (%@). Try again."}},
        "es": {"stringUnit": {"state": "translated", "value": "La app cambió durante el envío (%@). Inténtalo de nuevo."}},
        "fr": {"stringUnit": {"state": "translated", "value": "L’app a changé pendant l’envoi (%@). Réessayez."}},
        "it": {"stringUnit": {"state": "translated", "value": "L’app è cambiata durante l’invio (%@). Riprova."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "O app mudou durante o envio (%@). Tente novamente."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "应用在上传期间发生变化（%@）。请重试。"}}
      }
    },
    "The build cache changed during upload (%@). Try again.": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Der Build-Cache hat sich beim Hochladen geändert (%@). Versuche es erneut."}},
        "en": {"stringUnit": {"state": "translated", "value": "The build cache changed during upload (%@). Try again."}},
        "es": {"stringUnit": {"state": "translated", "value": "La caché de compilación cambió durante el envío (%@). Inténtalo de nuevo."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Le cache de compilation a changé pendant l’envoi (%@). Réessayez."}},
        "it": {"stringUnit": {"state": "translated", "value": "La cache di compilazione è cambiata durante l’invio (%@). Riprova."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "O cache de compilação mudou durante o envio (%@). Tente novamente."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "构建缓存在上传期间发生变化（%@）。请重试。"}}
      }
    },
    "A local folder is missing, unavailable or shared with another game.": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Ein lokaler Ordner fehlt, ist nicht verfügbar oder gehört auch zu einem anderen Spiel."}},
        "en": {"stringUnit": {"state": "translated", "value": "A local folder is missing, unavailable or shared with another game."}},
        "es": {"stringUnit": {"state": "translated", "value": "Una carpeta local falta, no está disponible o se comparte con otro juego."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Un dossier local est absent, inaccessible ou partagé avec un autre jeu."}},
        "it": {"stringUnit": {"state": "translated", "value": "Una cartella locale manca, non è disponibile o è condivisa con un altro gioco."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Uma pasta local está ausente, indisponível ou é compartilhada com outro jogo."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "本机文件夹缺失、不可用，或由其他游戏共用。"}}
      }
    },
    "The cloud copy could not be verified.": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Die Cloud-Kopie konnte nicht bestätigt werden."}},
        "en": {"stringUnit": {"state": "translated", "value": "The cloud copy could not be verified."}},
        "es": {"stringUnit": {"state": "translated", "value": "No se pudo verificar la copia en la nube."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Impossible de vérifier la copie cloud."}},
        "it": {"stringUnit": {"state": "translated", "value": "Impossibile verificare la copia nel cloud."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Não foi possível verificar a cópia na nuvem."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法验证云端副本。"}}
      }
    },
    "The cloud operation could not be completed.": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Der Cloud-Vorgang konnte nicht abgeschlossen werden."}},
        "en": {"stringUnit": {"state": "translated", "value": "The cloud operation could not be completed."}},
        "es": {"stringUnit": {"state": "translated", "value": "No se pudo completar la operación en la nube."}},
        "fr": {"stringUnit": {"state": "translated", "value": "L’opération cloud n’a pas pu aboutir."}},
        "it": {"stringUnit": {"state": "translated", "value": "Impossibile completare l’operazione cloud."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Não foi possível concluir a operação na nuvem."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法完成云端操作。"}}
      }
    },
    "Accept": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Annehmen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Accept"}},
        "es": {"stringUnit": {"state": "translated", "value": "Aceptar"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Accepter"}},
        "it": {"stringUnit": {"state": "translated", "value": "Accetta"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Aceitar"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "接受"}}
      }
    },
    "Could not confirm the friend action. Check status before trying again.": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Die Aktion konnte nicht bestätigt werden. Prüfe den Status, bevor du es erneut versuchst."}},
        "en": {"stringUnit": {"state": "translated", "value": "Could not confirm the friend action. Check status before trying again."}},
        "es": {"stringUnit": {"state": "translated", "value": "No se pudo confirmar la acción. Comprueba el estado antes de volver a intentarlo."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Impossible de confirmer l’action. Vérifiez l’état avant de réessayer."}},
        "it": {"stringUnit": {"state": "translated", "value": "Impossibile confermare l’azione. Controlla lo stato prima di riprovare."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Não foi possível confirmar a ação. Verifique o status antes de tentar novamente."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法确认好友操作。请先检查状态再重试。"}}
      }
    },
    "Could not refresh the lists. Use Check status.": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Die Listen konnten nicht aktualisiert werden. Wähle „Status prüfen“."}},
        "en": {"stringUnit": {"state": "translated", "value": "Could not refresh the lists. Use Check status."}},
        "es": {"stringUnit": {"state": "translated", "value": "No se pudieron actualizar las listas. Elige «Comprobar estado»."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Impossible d’actualiser les listes. Sélectionnez « Vérifier l’état »."}},
        "it": {"stringUnit": {"state": "translated", "value": "Impossibile aggiornare gli elenchi. Scegli «Controlla stato»."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Não foi possível atualizar as listas. Selecione «Verificar status»."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法刷新列表。请使用“检查状态”。"}}
      }
    },
    "Decline": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Ablehnen"}},
        "en": {"stringUnit": {"state": "translated", "value": "Decline"}},
        "es": {"stringUnit": {"state": "translated", "value": "Rechazar"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Refuser"}},
        "it": {"stringUnit": {"state": "translated", "value": "Rifiuta"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Recusar"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "拒绝"}}
      }
    },
    "Enter a 12-digit friend code.": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Gib einen zwölfstelligen Freundescode ein."}},
        "en": {"stringUnit": {"state": "translated", "value": "Enter a 12-digit friend code."}},
        "es": {"stringUnit": {"state": "translated", "value": "Introduce un código de amigo de 12 dígitos."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Saisissez un code ami à 12 chiffres."}},
        "it": {"stringUnit": {"state": "translated", "value": "Inserisci un codice amico di 12 cifre."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Digite um código de amigo de 12 dígitos."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "输入 12 位好友代码。"}}
      }
    },
    "Friend code": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Freundescode"}},
        "en": {"stringUnit": {"state": "translated", "value": "Friend code"}},
        "es": {"stringUnit": {"state": "translated", "value": "Código de amigo"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Code ami"}},
        "it": {"stringUnit": {"state": "translated", "value": "Codice amico"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Código de amigo"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "好友代码"}}
      }
    },
    "Friend removed.": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Kontakt entfernt."}},
        "en": {"stringUnit": {"state": "translated", "value": "Friend removed."}},
        "es": {"stringUnit": {"state": "translated", "value": "Amigo eliminado."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Ami retiré."}},
        "it": {"stringUnit": {"state": "translated", "value": "Amico rimosso."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Amigo removido."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "已移除好友。"}}
      }
    },
    "Friend request accepted.": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Freundschaftsanfrage angenommen."}},
        "en": {"stringUnit": {"state": "translated", "value": "Friend request accepted."}},
        "es": {"stringUnit": {"state": "translated", "value": "Solicitud de amistad aceptada."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Demande d’ami acceptée."}},
        "it": {"stringUnit": {"state": "translated", "value": "Richiesta di amicizia accettata."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Solicitação de amizade aceita."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "已接受好友请求。"}}
      }
    },
    "Friend request declined.": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Freundschaftsanfrage abgelehnt."}},
        "en": {"stringUnit": {"state": "translated", "value": "Friend request declined."}},
        "es": {"stringUnit": {"state": "translated", "value": "Solicitud de amistad rechazada."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Demande d’ami refusée."}},
        "it": {"stringUnit": {"state": "translated", "value": "Richiesta di amicizia rifiutata."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Solicitação de amizade recusada."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "已拒绝好友请求。"}}
      }
    },
    "Friend request sent.": {
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Freundschaftsanfrage gesendet."}},
        "en": {"stringUnit": {"state": "translated", "value": "Friend request sent."}},
        "es": {"stringUnit": {"state": "translated", "value": "Solicitud de amistad enviada."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Demande d’ami envoyée."}},
