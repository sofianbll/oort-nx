    "Your Steam files stay where they are. Disabling this source keeps its games and personal choices.": {
      "comment": "Steam source management and native Mac library presentation.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Steam files stay where they are. Disabling this source keeps its games and personal choices."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file di Steam restano al loro posto. Disattivando questa fonte, i giochi e le tue scelte vengono conservati."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos fichiers Steam restent à leur place. Désactiver cette source conserve ses jeux et vos choix personnels."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Steam-Dateien bleiben an ihrem Platz. Beim Deaktivieren dieser Quelle bleiben ihre Spiele und deine Einstellungen erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus archivos de Steam permanecen donde están. Al desactivar esta fuente se conservan sus juegos y tus preferencias."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus arquivos Steam ficam onde estão. Desativar esta fonte mantém seus jogos e suas preferências."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Steam 文件保持原位。停用此来源会保留其游戏和你的个人选择。"
          }
        }
      }
    },
    "Your build has been kept. Retry installs it without porting again.": {
      "comment": "AddGameStepThreeView.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your build has been kept. Retry installs it without porting again."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La compilazione è stata conservata. Con Riprova puoi installarla senza creare di nuovo l’app per Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre compilation a été conservée. Réessayer l’installe sans recréer l’app Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Build bleibt erhalten. Mit „Installation wiederholen“ wird er installiert, ohne die App erneut zu erstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha conservado la compilación. Al reintentar, se instalará sin volver a compilar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
