    "This title already exists. Replace it in the library with a copy of the selected app? The selected app stays where it is.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "This title already exists. Replace it in the library with a copy of the selected app? The selected app stays where it is."}},
        "it": {"stringUnit": {"state": "translated", "value": "Il titolo esiste già. Vuoi sostituirlo in libreria con una copia dell’app selezionata? L’app selezionata resta dov’è."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Ce titre existe déjà. Le remplacer dans la bibliothèque par une copie de l’app sélectionnée ? L’app d’origine reste à sa place."}},
        "de": {"stringUnit": {"state": "translated", "value": "Dieser Titel existiert bereits. Soll ihn eine Kopie der ausgewählten App in der Bibliothek ersetzen? Das Original bleibt unverändert."}},
