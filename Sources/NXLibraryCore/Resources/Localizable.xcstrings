    "Steam could not be refreshed. Your library has been kept.": {
      "comment": "Steam source management and native Mac library presentation.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam could not be refreshed. Your library has been kept."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile aggiornare Steam. La tua libreria è stata conservata."
          }
        },
        "fr": {
          "stringUnit": {
