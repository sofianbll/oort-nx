    "Personal Drive and local copies; the reference library is not changed.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"Personal Drive and local copies; the reference library is not changed."}}, "fr": {"stringUnit":{"state":"translated","value":"Drive personnel et copies locales ; la bibliothèque de référence n’est pas modifiée."}}, "it": {"stringUnit":{"state":"translated","value":"Drive personale e copie locali; la libreria di riferimento non viene modificata."}}, "de": {"stringUnit":{"state":"translated","value":"Persönliches Drive und lokale Kopien; die Referenzbibliothek bleibt unverändert."}}, "es": {"stringUnit":{"state":"translated","value":"Drive personal y copias locales; la biblioteca de referencia no cambia."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Drive pessoal e cópias locais; a biblioteca de referência não é alterada."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"写入个人 Drive 和本地副本，不更改参考库。"}}
    }},
    "Selected files to personal Drive. Google grants full Drive access; Oort NX uses the configured folders.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"Selected files to personal Drive. Google grants full Drive access; Oort NX uses the configured folders."}}, "fr": {"stringUnit":{"state":"translated","value":"Fichiers choisis vers le Drive personnel. Google accorde un accès complet à Drive ; Oort NX utilise les dossiers configurés."}}, "it": {"stringUnit":{"state":"translated","value":"File scelti sul Drive personale. Google concede accesso completo a Drive; Oort NX usa le cartelle configurate."}}, "de": {"stringUnit":{"state":"translated","value":"Ausgewählte Dateien ans persönliche Drive. Google gewährt vollen Drive-Zugriff; Oort NX nutzt die eingestellten Ordner."}}, "es": {"stringUnit":{"state":"translated","value":"Archivos seleccionados al Drive personal. Google concede acceso completo a Drive; Oort NX usa las carpetas configuradas."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Arquivos selecionados para o Drive pessoal. O Google concede acesso total ao Drive; o Oort NX usa as pastas configuradas."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"将选定的文件发送到个人 Drive。Google 授予完整的 Drive 访问权限；Oort NX 使用已配置的文件夹。"}}
