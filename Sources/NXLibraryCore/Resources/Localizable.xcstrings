    }},
    "Each player presses a button in the game to join.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"Each player presses a button in the game to join."}}, "fr": {"stringUnit":{"state":"translated","value":"Dans le jeu, chaque joueur appuie sur un bouton pour rejoindre."}}, "it": {"stringUnit":{"state":"translated","value":"Nel gioco ogni giocatore preme un tasto per unirsi."}}, "de": {"stringUnit":{"state":"translated","value":"Im Spiel drückt jeder Spieler eine Taste, um beizutreten."}}, "es": {"stringUnit":{"state":"translated","value":"Cada jugador pulsa un botón en el juego para unirse."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"No jogo, cada jogador aperta um botão para entrar."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"每位玩家在游戏中按下按钮即可加入。"}}
    }},
