    "%@ The installed app and saves were kept. Rebuilds stay disabled until you attach the sources again.": {
      "comment": "Source removal safety copy. User paths/names remain verbatim.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ The installed app and saves were kept. Rebuilds stay disabled until you attach the sources again."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ L’app installata e i salvataggi sono stati conservati. Non potrai ricompilare finché non colleghi di nuovo le sorgenti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ L’app installée et les sauvegardes ont été conservées. La recompilation reste désactivée jusqu’à ce que vous rattachiez les sources."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Die installierte App und Spielstände wurden behalten. Neue Builds sind erst wieder möglich, wenn du die Quelldateien erneut verknüpfst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Se conservaron la app instalada y las partidas guardadas. No podrás recompilar hasta que vuelvas a vincular los archivos de origen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ O app instalado e os saves foram mantidos. Novas compilações ficam desativadas até você vincular os arquivos de origem novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已安装的 App 和存档均已保留。重新附加源文件之前，无法重新构建。"
          }
        }
      }
    },
