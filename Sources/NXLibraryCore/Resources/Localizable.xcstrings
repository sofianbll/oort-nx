      "es": {"stringUnit":{"state":"translated","value":"Usar la carpeta «%@» (%d juego)"}},
      "pt-BR": {"stringUnit":{"state":"translated","value":"Usar a pasta “%@” (%d jogo)"}},
      "zh-Hans": {"stringUnit":{"state":"translated","value":"使用“%@”文件夹（%d 个游戏）"}}
    }},
    "Use folder “%@” (%d games)": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"Use the folder “%@” (%d games)"}},
      "it": {"stringUnit":{"state":"translated","value":"Usa la cartella «%@» (%d giochi)"}},
      "fr": {"stringUnit":{"state":"translated","value":"Utiliser le dossier « %@ » (%d jeux)"}},
