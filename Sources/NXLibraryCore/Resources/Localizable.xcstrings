    },
    "This backup restores all local users and their registry.": {
      "comment": "NUP program identity or local multiuser save scope; cloud still covers the primary user and device only.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This backup restores all local users and their registry."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo backup ripristina tutti gli utenti locali e il loro registro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette sauvegarde restaure tous les utilisateurs locaux et leur registre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Backup stellt alle lokalen Benutzer und ihre Registrierung wieder her."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta copia restaura todos los usuarios locales y su registro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este backup restaura todos os usuários locais e seu registro."
          }
        },
