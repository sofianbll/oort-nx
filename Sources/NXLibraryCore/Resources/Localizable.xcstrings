    },
    "Some shaders broke in this engine": {
      "comment": "PortingFailureReason.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some shaders broke in this engine"
          }
        },
        "it": {
          "stringUnit": {
