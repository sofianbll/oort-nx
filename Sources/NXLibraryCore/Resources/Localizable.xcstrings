      "en": {"stringUnit":{"state":"translated","value":"Searches to SteamGridDB or IGDB; SteamGridDB key to SteamGridDB and IGDB credentials to Twitch."}}, "fr": {"stringUnit":{"state":"translated","value":"Recherches à SteamGridDB ou IGDB ; clé SteamGridDB à SteamGridDB et identifiants IGDB à Twitch."}}, "it": {"stringUnit":{"state":"translated","value":"Ricerche a SteamGridDB o IGDB; chiave SteamGridDB a SteamGridDB e credenziali IGDB a Twitch."}}, "de": {"stringUnit":{"state":"translated","value":"Suchanfragen an SteamGridDB oder IGDB; SteamGridDB-Schlüssel an SteamGridDB und IGDB-Zugangsdaten an Twitch."}}, "es": {"stringUnit":{"state":"translated","value":"Búsquedas a SteamGridDB o IGDB; clave de SteamGridDB a SteamGridDB y credenciales de IGDB a Twitch."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Pesquisas ao SteamGridDB ou IGDB; chave do SteamGridDB ao SteamGridDB e credenciais do IGDB à Twitch."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"向 SteamGridDB 或 IGDB 发送搜索请求，向 SteamGridDB 发送其密钥，向 Twitch 发送 IGDB 凭据。"}}
