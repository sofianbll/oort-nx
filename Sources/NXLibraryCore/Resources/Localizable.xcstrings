          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il programma selezionato nel NUP non corrisponde più a questo gioco. Scegli di nuovo la sorgente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le programme sélectionné dans le NUP ne correspond plus à ce jeu. Sélectionnez à nouveau la source."
          }
        },
        "de": {
          "stringUnit": {
