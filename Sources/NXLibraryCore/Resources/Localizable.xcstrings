    }},
    "Use four digits.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"Use four digits."}}, "it": {"stringUnit":{"state":"translated","value":"Usa quattro cifre."}}, "fr": {"stringUnit":{"state":"translated","value":"Saisissez quatre chiffres."}}, "de": {"stringUnit":{"state":"translated","value":"Verwende vier Ziffern."}}, "es": {"stringUnit":{"state":"translated","value":"Introduce cuatro dígitos."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Use quatro dígitos."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"请输入四位数字。"}}
    }},
