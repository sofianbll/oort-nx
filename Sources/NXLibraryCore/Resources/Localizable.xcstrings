    "LAN and Local wireless play with devices on the same Wi-Fi network. Nextendo is a community service for online play and requires a separate sign-in.": {
      "comment": "nxnative launcher.json",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "LAN und lokale Drahtlosverbindung verbinden Geräte im selben WLAN. Nextendo ist ein Community-Dienst für Online-Spiele und erfordert eine eigene Anmeldung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LAN and Local wireless play with devices on the same Wi-Fi network. Nextendo is a community service for online play and requires a separate sign-in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La LAN y la conexión inalámbrica local conectan dispositivos de la misma red Wi‑Fi. Nextendo es un servicio comunitario de juego en línea que requiere su propia cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le réseau local et la connexion sans fil locale relient les appareils sur le même Wi‑Fi. Nextendo est un service communautaire de jeu en ligne qui nécessite une connexion distincte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "LAN e connessione wireless locale usano la stessa rete Wi‑Fi. Nextendo è un servizio della comunità per giocare online e richiede un accesso separato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "LAN e conexão local sem fio usam dispositivos na mesma rede Wi‑Fi. O Nextendo é um serviço comunitário para jogar online e exige uma sessão separada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LAN 和本地无线通信可与同一 Wi‑Fi 下的设备一起游玩。Nextendo 是用于联机游玩的社区服务，需要单独登录。"
          }
        }
      }
    },
