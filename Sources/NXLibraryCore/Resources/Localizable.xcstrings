    "Update Arcane: its built-in Python includes zbic from 0.1.3.2. Installing zbic with pip does not reach it.": {
      "comment": "PortingFailureReason.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update Arcane: its built-in Python includes zbic from 0.1.3.2. Installing zbic with pip does not reach it."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiorna Arcane: dalla versione 0.1.3.2 il Python incluso contiene zbic. Installare zbic con pip non lo rende disponibile nell’ambiente incluso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez Arcane à jour : son Python intégré inclut zbic depuis la version 0.1.3.2. Installer zbic avec pip n’a aucun effet sur ce Python."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisiere Arcane: Das integrierte Python enthält zbic ab 0.1.3.2. Eine Installation von zbic mit pip erreicht es nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualiza Arcane: su Python integrado incluye zbic desde la versión 0.1.3.2. Instalar zbic con pip no lo añade a ese Python."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualize o Arcane: seu Python integrado inclui o zbic desde a versão 0.1.3.2. Instalar o zbic com pip não afeta esse Python."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请更新 Arcane：自 0.1.3.2 起，其内置的 Python 已包含 zbic。用 pip 安装 zbic 无法作用于它。"
          }
        }
      }
    },
