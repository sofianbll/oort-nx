    },
    "Arcane checks the copies before moving the originals to Trash. Identical copies already in Game files: %@.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Arcane checks the copies before moving the originals to Trash. Identical copies already in Game files: %@."}},
        "it": {"stringUnit": {"state": "translated", "value": "Arcane verifica le copie prima di spostare gli originali nel Cestino. Copie identiche già nei file di gioco: %@."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Arcane vérifie les copies avant de placer les originaux dans la Corbeille. Copies identiques déjà rangées : %@."}},
        "de": {"stringUnit": {"state": "translated", "value": "Arcane prüft die Kopien, bevor die Originale in den Papierkorb verschoben werden. Bereits vorhandene identische Kopien: %@."}},
        "es": {"stringUnit": {"state": "translated", "value": "Arcane comprueba las copias antes de enviar los originales a la papelera. Copias idénticas ya archivadas: %@."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "O Arcane verifica as cópias antes de mover os originais para o Lixo. Cópias idênticas já organizadas: %@."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "Arcane 验证副本后才会将原文件移到废纸篓。游戏文件夹中已有的相同副本：%@。"}}
      }
    },
    "Sort and move to Trash": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Sort and move to Trash"}},
        "it": {"stringUnit": {"state": "translated", "value": "Ordina e sposta nel Cestino"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Ranger et mettre à la Corbeille"}},
        "de": {"stringUnit": {"state": "translated", "value": "Sortieren und in den Papierkorb verschieben"}},
        "es": {"stringUnit": {"state": "translated", "value": "Ordenar y mover a la papelera"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Organizar e mover para o Lixo"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "整理并移到废纸篓"}}
      }
    },
    "Wait for porting and transfers to finish before sorting.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Wait for porting and transfers to finish before sorting."}},
        "it": {"stringUnit": {"state": "translated", "value": "Attendi la fine del porting e dei trasferimenti prima di ordinare."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Attendez la fin du portage et des transferts avant de ranger."}},
        "de": {"stringUnit": {"state": "translated", "value": "Warte vor dem Sortieren, bis Portierung und Übertragungen abgeschlossen sind."}},
        "es": {"stringUnit": {"state": "translated", "value": "Espera a que terminen la portabilidad y las transferencias antes de ordenar."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Aguarde o fim da portabilidade e das transferências antes de organizar."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "请等待移植和传输完成后再整理。"}}
      }
    },
