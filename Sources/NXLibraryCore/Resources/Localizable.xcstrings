    },
    "The engine here is at %@, not the %@ this version of Arcane is tested with. Switch moves it to %@. Games you built keep playing.": {
      "comment": "SetupCheck.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The engine here is at %@, not the %@ this version of Arcane is tested with. Switch moves it to %@. Games you built keep playing."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il motore qui è al commit %@, diverso da %@ con cui è testata questa versione di Arcane. Con Cambia lo porti a %@. I giochi già compilati continuano a funzionare."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur présent est au commit %@, et non au commit %@ avec lequel cette version d’Arcane a été testée. Changer le fait passer au commit %@. Les jeux déjà compilés restent jouables."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Engine hier steht auf %@ statt auf %@, womit diese Arcane-Version getestet wurde. „Wechseln“ setzt sie auf %@. Bereits erstellte Spiele bleiben spielbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El motor local está en %@, en lugar de %@, con el que se ha probado este Arcane. Cambiar lo mueve a %@. Los juegos ya compilados siguen funcionando."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A engine aqui está em %@, e não em %@, com o qual este Arcane foi testado. Trocar a move para %@. Seus jogos compilados continuam funcionando."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此处的引擎版本是 %@，而不是此版本 Arcane 测试所用的 %@。“切换”会将其移到 %@。你已构建的游戏仍可游玩。"
