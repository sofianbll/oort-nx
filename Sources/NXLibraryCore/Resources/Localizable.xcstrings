    "Play time is tracked only for launches from Arcane. Not affiliated with Nintendo.": {
      "comment": "SettingsAboutSection.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play time is tracked only for launches from Arcane. Not affiliated with Nintendo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tempo di gioco viene registrato solo per gli avvii da Arcane. Non affiliata a Nintendo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le temps de jeu est comptabilisé uniquement pour les lancements depuis Arcane. Sans affiliation avec Nintendo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spielzeit wird nur bei Starts über Arcane erfasst. Keine Verbindung zu Nintendo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tiempo de juego solo se registra al iniciar desde Arcane. Sin afiliación con Nintendo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tempo de jogo é registrado apenas quando o jogo é aberto pelo Arcane. Sem afiliação com a Nintendo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅记录从 Arcane 启动的游戏时间。与 Nintendo 无关。"
          }
        }
      }
    },
    "Plays Joy-Con 2 and Pro Controller 2 over Bluetooth: hold Sync on one during the game to pair it. macOS asks once for Bluetooth access.": {
      "comment": "Engine game setting presentation; never translate env keys or values.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plays Joy-Con 2 and Pro Controller 2 over Bluetooth: hold Sync on one during the game to pair it. macOS asks once for Bluetooth access."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consente di giocare con Joy-Con 2 e Pro Controller 2 via Bluetooth: tieni premuto Sync su uno di essi durante il gioco per abbinarlo. macOS chiede una sola volta l’accesso al Bluetooth."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet de jouer avec les Joy-Con 2 et la Pro Controller 2 en Bluetooth : maintenez Sync sur l’une de ces manettes pendant le jeu pour l’appairer. macOS demande une seule fois l’accès au Bluetooth."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterstützt Joy-Con 2 und Pro Controller 2 über Bluetooth: Halte während des Spiels die Sync-Taste am Controller gedrückt, um ihn zu koppeln. macOS fragt einmal nach Bluetooth-Zugriff."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite jugar con Joy-Con 2 y Pro Controller 2 por Bluetooth: mantén pulsado Sync en uno durante el juego para enlazarlo. macOS pide acceso a Bluetooth una sola vez."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite jogar com Joy-Con 2 e Pro Controller 2 via Bluetooth: mantenha Sync pressionado em um deles durante o jogo para emparelhar. O macOS pede acesso ao Bluetooth uma vez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过蓝牙使用 Joy-Con 2 和 Pro 手柄 2：在游戏中按住其中一个的同步键即可配对。macOS 会询问一次蓝牙访问权限。"
          }
        }
      }
    },
    "Plays a short sound when you move, select, go back or launch a game.": {
      "comment": "SettingsCatalog.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plays a short sound when you move, select, go back or launch a game."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riproduce un breve suono quando ti sposti, selezioni, torni indietro o avvii un gioco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Émet un son bref lorsque vous naviguez, sélectionnez, revenez en arrière ou lancez un jeu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spielt einen kurzen Ton beim Navigieren, Auswählen, Zurückgehen oder Starten eines Spiels."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduce un sonido breve al moverte, seleccionar, volver atrás o iniciar un juego."
          }
        },
        "pt-BR": {
          "stringUnit": {
