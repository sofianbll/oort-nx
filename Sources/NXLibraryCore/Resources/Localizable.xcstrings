    }},
    "The codes do not match.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"The codes do not match."}}, "it": {"stringUnit":{"state":"translated","value":"I codici non coincidono."}}, "fr": {"stringUnit":{"state":"translated","value":"Les codes ne correspondent pas."}}, "de": {"stringUnit":{"state":"translated","value":"Die Codes stimmen nicht überein."}}, "es": {"stringUnit":{"state":"translated","value":"Los códigos no coinciden."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Os códigos não coincidem."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"两次输入的密码不一致。"}}
    }},
    "Touch ID": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"Touch ID"}}, "it": {"stringUnit":{"state":"translated","value":"Touch ID"}}, "fr": {"stringUnit":{"state":"translated","value":"Touch ID"}}, "de": {"stringUnit":{"state":"translated","value":"Touch ID"}}, "es": {"stringUnit":{"state":"translated","value":"Touch ID"}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Touch ID"}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"触控 ID"}}
    }},
    "A file or folder changed. Refresh and review the proposal again.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "A file or folder changed. Refresh and review the proposal again."}},
        "it": {"stringUnit": {"state": "translated", "value": "Un file o una cartella è cambiato. Aggiorna e controlla di nuovo."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Un fichier ou un dossier a changé. Actualisez et vérifiez à nouveau."}},
        "de": {"stringUnit": {"state": "translated", "value": "Eine Datei oder ein Ordner wurde geändert. Aktualisiere und prüfe erneut."}},
        "es": {"stringUnit": {"state": "translated", "value": "Cambió un archivo o una carpeta. Actualiza y vuelve a revisar."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Um arquivo ou pasta mudou. Atualize e confira novamente."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "文件或文件夹已更改。请刷新并重新检查。"}}
      }
    },
    "Arcane did not discover the copy. The original was kept.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Arcane did not discover the copy. The original was kept."}},
        "it": {"stringUnit": {"state": "translated", "value": "Arcane non ha trovato la copia. L'originale è stato conservato."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Arcane n’a pas trouvé la copie. L’original a été conservé."}},
        "de": {"stringUnit": {"state": "translated", "value": "Arcane hat die Kopie nicht gefunden. Das Original wurde behalten."}},
        "es": {"stringUnit": {"state": "translated", "value": "Arcane no encontró la copia. Se conservó el original."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "O Arcane não encontrou a cópia. O original foi mantido."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "Arcane 未找到副本。原文件已保留。"}}
      }
    },
    "Not a supported incoming file.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Not a supported incoming file."}},
        "it": {"stringUnit": {"state": "translated", "value": "File in arrivo non supportato."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Ce fichier reçu n’est pas pris en charge."}},
        "de": {"stringUnit": {"state": "translated", "value": "Diese eingehende Datei wird nicht unterstützt."}},
        "es": {"stringUnit": {"state": "translated", "value": "Este archivo recibido no es compatible."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Este arquivo recebido não é compatível."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "不支持此收到的文件。"}}
      }
    },
    "No single verified title, kind and version.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "No single verified title, kind and version."}},
        "it": {"stringUnit": {"state": "translated", "value": "Non è possibile verificare un solo titolo, tipo e versione."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Impossible de confirmer un titre, un type et une version uniques."}},
        "de": {"stringUnit": {"state": "translated", "value": "Titel, Typ und Version lassen sich nicht eindeutig bestätigen."}},
        "es": {"stringUnit": {"state": "translated", "value": "No se pudo confirmar un solo título, tipo y versión."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Não foi possível confirmar um único título, tipo e versão."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法验证唯一的游戏、类型和版本。"}}
      }
    },
    "No unambiguous game name or destination.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "No unambiguous game name or destination."}},
        "it": {"stringUnit": {"state": "translated", "value": "Nome del gioco o destinazione non univoci."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Le nom du jeu ou sa destination ne sont pas certains."}},
        "de": {"stringUnit": {"state": "translated", "value": "Spielname oder Ziel sind nicht eindeutig."}},
        "es": {"stringUnit": {"state": "translated", "value": "El nombre del juego o su destino no son inequívocos."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Não foi possível determinar o nome do jogo ou o destino."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法确定游戏名称或目标位置。"}}
      }
    },
    "No verified DLC name.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "No verified DLC name."}},
        "it": {"stringUnit": {"state": "translated", "value": "Nome del DLC non verificato."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Le nom du DLC n’a pas pu être confirmé."}},
        "de": {"stringUnit": {"state": "translated", "value": "Der DLC-Name konnte nicht bestätigt werden."}},
        "es": {"stringUnit": {"state": "translated", "value": "No se pudo confirmar el nombre del DLC."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Não foi possível confirmar o nome do DLC."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法确认 DLC 名称。"}}
      }
    },
    "The proposed name is too long.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "The proposed name is too long."}},
        "it": {"stringUnit": {"state": "translated", "value": "Il nome proposto è troppo lungo."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Le nom proposé est trop long."}},
        "de": {"stringUnit": {"state": "translated", "value": "Der vorgeschlagene Name ist zu lang."}},
        "es": {"stringUnit": {"state": "translated", "value": "El nombre propuesto es demasiado largo."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "O nome proposto é longo demais."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "建议的名称过长。"}}
      }
    },
    "A different file already occupies the destination.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "A different file already occupies the destination."}},
        "it": {"stringUnit": {"state": "translated", "value": "Un altro file occupa già la destinazione."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Un autre fichier occupe déjà la destination."}},
        "de": {"stringUnit": {"state": "translated", "value": "Am Ziel liegt bereits eine andere Datei."}},
        "es": {"stringUnit": {"state": "translated", "value": "Ya hay otro archivo en el destino."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Já há outro arquivo no destino."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "目标位置已有其他文件。"}}
      }
    },
    "Multiple incoming files have the same destination.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Multiple incoming files have the same destination."}},
        "it": {"stringUnit": {"state": "translated", "value": "Più file in arrivo hanno la stessa destinazione."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Plusieurs fichiers reçus ont la même destination."}},
        "de": {"stringUnit": {"state": "translated", "value": "Mehrere eingehende Dateien haben dasselbe Ziel."}},
        "es": {"stringUnit": {"state": "translated", "value": "Varios archivos recibidos tienen el mismo destino."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Vários arquivos recebidos têm o mesmo destino."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "多个收到的文件指向同一目标位置。"}}
      }
    },
    "Change Game files?": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Change Game files?"}},
        "it": {"stringUnit": {"state": "translated", "value": "Cambiare la cartella File di gioco?"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Changer le dossier Fichiers de jeu ?"}},
        "de": {"stringUnit": {"state": "translated", "value": "Ordner für Spieldateien ändern?"}},
