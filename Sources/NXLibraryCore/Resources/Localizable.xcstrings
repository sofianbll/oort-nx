          "stringUnit": {
            "state": "translated",
            "value": "Steam 可能需要你操作。请查看 Steam，之后游戏就会启动。"
          }
        }
      }
    },
    "Steam starts quietly when possible and comes forward if it needs you.": {
      "comment": "SettingsSourcesSection.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam starts quietly when possible and comes forward if it needs you."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam si avvia in background quando possibile e viene in primo piano se serve il tuo intervento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam démarre en arrière-plan si possible et passe au premier plan si votre intervention est nécessaire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam startet wenn möglich im Hintergrund und kommt nach vorne, wenn deine Eingabe nötig ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam se inicia en segundo plano cuando es posible y pasa al primer plano si necesita tu intervención."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Steam inicia em segundo plano quando possível e vem para a frente se precisar da sua atenção."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam 会尽量在后台静默启动，需要你操作时才会显示在前台。"
          }
        }
      }
