    }},
    "Add a shortcut to an app on this Mac. The app stays where it is.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"Add a shortcut to an app on this Mac. The app stays where it is."}}, "it": {"stringUnit":{"state":"translated","value":"Aggiungi un collegamento a un’app di questo Mac. L’app resta dove si trova."}}, "fr": {"stringUnit":{"state":"translated","value":"Ajoute un raccourci vers une app de ce Mac. L’app reste à sa place."}}, "de": {"stringUnit":{"state":"translated","value":"Verknüpfe eine App auf diesem Mac. Die App bleibt an ihrem Ort."}}, "es": {"stringUnit":{"state":"translated","value":"Añade un acceso directo a una app de este Mac. La app no se mueve."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Adicione um atalho para um app neste Mac. O app fica onde está."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"为这台 Mac 上的应用添加快捷方式。应用不会被移动。"}}
    }},
    "Choose an app to add a tile. The app stays where it is.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"Choose an app to add a tile. The app stays where it is."}}, "it": {"stringUnit":{"state":"translated","value":"Scegli un’app per aggiungere una tessera. L’app resta dove si trova."}}, "fr": {"stringUnit":{"state":"translated","value":"Choisissez une app pour ajouter une tuile. L’app reste à sa place."}}, "de": {"stringUnit":{"state":"translated","value":"Wähle eine App für die Kachel. Die App bleibt an ihrem Ort."}}, "es": {"stringUnit":{"state":"translated","value":"Elige una app para añadir una ficha. La app no se mueve."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Escolha um app para adicionar um bloco. O app fica onde está."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"选择一个应用以添加磁贴。应用不会被移动。"}}
    }},
    "Choose the original app at its new location.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"Choose the original app at its new location."}}, "it": {"stringUnit":{"state":"translated","value":"Scegli l’app originale nella nuova posizione."}}, "fr": {"stringUnit":{"state":"translated","value":"Choisissez l’app d’origine à son nouvel emplacement."}}, "de": {"stringUnit":{"state":"translated","value":"Wähle die ursprüngliche App an ihrem neuen Ort."}}, "es": {"stringUnit":{"state":"translated","value":"Elige la app original en su nueva ubicación."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Escolha o app original no novo local."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"在新位置选择原来的应用。"}}
    }},
    "Choose a valid Mac app (.app).": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"Choose a valid Mac app (.app)."}}, "it": {"stringUnit":{"state":"translated","value":"Scegli un’app Mac valida (.app)."}}, "fr": {"stringUnit":{"state":"translated","value":"Choisissez une app Mac valide (.app)."}}, "de": {"stringUnit":{"state":"translated","value":"Wähle eine gültige Mac-App (.app)."}}, "es": {"stringUnit":{"state":"translated","value":"Elige una app de Mac válida (.app)."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Escolha um app válido do Mac (.app)."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"请选择有效的 Mac 应用（.app）。"}}
    }},
    "This is not the app linked to this tile. Choose the original app.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"This is not the app linked to this tile. Choose the original app."}}, "it": {"stringUnit":{"state":"translated","value":"Questa non è l’app collegata alla tessera. Scegli l’app originale."}}, "fr": {"stringUnit":{"state":"translated","value":"Cette app ne correspond pas à la tuile. Choisissez l’app d’origine."}}, "de": {"stringUnit":{"state":"translated","value":"Diese App gehört nicht zu dieser Kachel. Wähle die ursprüngliche App."}}, "es": {"stringUnit":{"state":"translated","value":"Esta app no está vinculada a esta ficha. Elige la app original."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Este não é o app vinculado ao bloco. Escolha o app original."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"这不是此磁贴关联的应用。请选择原来的应用。"}}
    }},
    "That location is already linked to another tile.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"That location is already linked to another tile."}}, "it": {"stringUnit":{"state":"translated","value":"Questa posizione è già collegata a un’altra tessera."}}, "fr": {"stringUnit":{"state":"translated","value":"Cet emplacement est déjà lié à une autre tuile."}}, "de": {"stringUnit":{"state":"translated","value":"Dieser Ort ist schon mit einer anderen Kachel verknüpft."}}, "es": {"stringUnit":{"state":"translated","value":"Esa ubicación ya está vinculada a otra ficha."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Esse local já está vinculado a outro bloco."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"此位置已关联到另一块磁贴。"}}
    }},
    "Switch to a regular profile to open Mac apps from the library.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"Switch to a regular profile to open Mac apps from the library."}}, "it": {"stringUnit":{"state":"translated","value":"Passa a un profilo normale per aprire le app Mac dalla libreria."}}, "fr": {"stringUnit":{"state":"translated","value":"Quitte le profil invité pour ouvrir des apps Mac depuis la bibliothèque."}}, "de": {"stringUnit":{"state":"translated","value":"Wechsle zu einem normalen Profil, um Mac-Apps aus der Bibliothek zu öffnen."}}, "es": {"stringUnit":{"state":"translated","value":"Cambia a un perfil normal para abrir apps de Mac desde la biblioteca."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Mude para um perfil normal para abrir apps do Mac pela biblioteca."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"切换到普通个人资料，才能从资料库打开 Mac 应用。"}}
    }},
    "Mac app not found": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"Mac app not found"}}, "it": {"stringUnit":{"state":"translated","value":"App Mac non trovata"}}, "fr": {"stringUnit":{"state":"translated","value":"App Mac introuvable"}}, "de": {"stringUnit":{"state":"translated","value":"Mac-App nicht gefunden"}}, "es": {"stringUnit":{"state":"translated","value":"No se encuentra la app de Mac"}}, "pt-BR": {"stringUnit":{"state":"translated","value":"App do Mac não encontrado"}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"找不到 Mac 应用"}}
    }},
    "The app has moved or no longer matches this tile. Choose the original app again.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"The app has moved or no longer matches this tile. Choose the original app again."}}, "it": {"stringUnit":{"state":"translated","value":"L’app è stata spostata o non corrisponde più alla tessera. Scegli di nuovo l’app originale."}}, "fr": {"stringUnit":{"state":"translated","value":"L’app a été déplacée ou ne correspond plus à la tuile. Choisissez à nouveau l’app d’origine."}}, "de": {"stringUnit":{"state":"translated","value":"Die App wurde verschoben oder gehört nicht mehr zu dieser Kachel. Wähle erneut die ursprüngliche App."}}, "es": {"stringUnit":{"state":"translated","value":"La app se ha movido o ya no coincide con esta ficha. Vuelve a elegir la app original."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"O app foi movido ou não corresponde mais ao bloco. Escolha o app original novamente."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"应用已移动或不再与此磁贴匹配。请重新选择原来的应用。"}}
