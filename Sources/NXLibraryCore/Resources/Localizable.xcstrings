        "en": {"stringUnit": {"state": "translated", "value": "File mods"}},
        "es": {"stringUnit": {"state": "translated", "value": "Mods de archivos"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Mods de fichiers"}},
        "it": {"stringUnit": {"state": "translated", "value": "Mod di file"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Mods de arquivos"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "文件模组"}}
      }
    },
    "Code mods can't build in a path containing a comma, colon or line break.": {
      "comment": "BuildService.swift",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Code-Mods lassen sich nicht in einem Pfad mit Komma, Doppelpunkt oder Zeilenumbruch bauen."}},
        "en": {"stringUnit": {"state": "translated", "value": "Code mods can't build in a path containing a comma, colon or line break."}},
        "es": {"stringUnit": {"state": "translated", "value": "No se pueden compilar mods de código en una ruta con comas, dos puntos o saltos de línea."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Impossible de compiler des mods de code dans un chemin contenant une virgule, deux-points ou un saut de ligne."}},
        "it": {"stringUnit": {"state": "translated", "value": "Non puoi compilare le mod di codice in un percorso con virgole, due punti o ritorni a capo."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Não é possível compilar mods de código em um caminho com vírgula, dois-pontos ou quebra de linha."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "路径中包含逗号、冒号或换行符时，无法构建代码模组。"}}
      }
    },
    "File and code mods both use the folder name %@. Rename one folder.": {
      "comment": "ModStore: two roots share one record name",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Datei- und Code-Mods verwenden beide den Ordnernamen %@. Benenne einen der Ordner um."}},
        "en": {"stringUnit": {"state": "translated", "value": "File and code mods both use the folder name %@. Rename one folder."}},
        "es": {"stringUnit": {"state": "translated", "value": "Los mods de archivos y de código usan el mismo nombre de carpeta: %@. Cambia el nombre de una carpeta."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Un mod de fichiers et un mod de code ont le même nom de dossier : %@. Renommez l’un des dossiers."}},
        "it": {"stringUnit": {"state": "translated", "value": "Una mod di file e una mod di codice usano lo stesso nome di cartella: %@. Rinomina una cartella."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Um mod de arquivos e um mod de código usam o mesmo nome de pasta: %@. Renomeie uma das pastas."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "文件模组和代码模组使用了同一个文件夹名称 %@。请重命名其中一个文件夹。"}}
      }
    },
    "Copy a folder with exefs patches. The original stays in place.": {
      "comment": "ModsPanel.swift",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Einen Ordner mit ExeFS-Patches kopieren. Das Original bleibt erhalten."}},
        "en": {"stringUnit": {"state": "translated", "value": "Copy a folder with exefs patches. The original stays in place."}},
        "es": {"stringUnit": {"state": "translated", "value": "Copia una carpeta con parches exefs. La original se conserva."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Copiez un dossier contenant des correctifs exefs. L’original reste en place."}},
        "it": {"stringUnit": {"state": "translated", "value": "Copia una cartella con patch exefs. L’originale resta al suo posto."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Copia uma pasta com patches exefs. A original fica no lugar."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "复制包含 exefs 补丁的文件夹。原文件夹保留在原处。"}}
      }
    },
    "Rebuild the game after making changes. Turning off all code mods or re-enabling the entire built set needs no rebuild. Inactive online (Nextendo).": {
      "comment": "ModsPanel.swift: ExeFS section subtitle",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Baue das Spiel nach Änderungen neu. Alle Code-Mods auszuschalten oder den gesamten eingebauten Satz wieder zu aktivieren, erfordert keinen Neubau. Online inaktiv (Nextendo)."}},
        "en": {"stringUnit": {"state": "translated", "value": "Rebuild the game after making changes. Turning off all code mods or re-enabling the entire built set needs no rebuild. Inactive online (Nextendo)."}},
        "es": {"stringUnit": {"state": "translated", "value": "Recompila el juego después de hacer cambios. Desactivar todos los mods de código o reactivar todo el conjunto compilado no requiere recompilar. Inactivos en línea (Nextendo)."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Recompilez le jeu après toute modification. Il n’est pas nécessaire de le recompiler pour désactiver tous les mods de code ou réactiver tout le lot compilé. Ils sont inactifs en ligne (Nextendo)."}},
        "it": {"stringUnit": {"state": "translated", "value": "Ricompila il gioco dopo una modifica. Non serve ricompilare per disattivare tutte le mod di codice o riattivare l’intero gruppo compilato. Inattive online (Nextendo)."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Recompile o jogo após fazer alterações. Desativar todos os mods de código ou reativar todo o conjunto compilado não exige recompilação. Inativos online (Nextendo)."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "修改后请重新构建。关闭全部代码模组，或重新启用已构建的整组模组，不需要重新构建。联机时（Nextendo）不生效。"}}
      }
    },
