    "Use ZeroTier in Local communication, LAN, or Automatic with VPN on. Nextendo is not affected.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Use ZeroTier in Local communication, LAN, or Automatic with VPN on. Nextendo is not affected."}},
