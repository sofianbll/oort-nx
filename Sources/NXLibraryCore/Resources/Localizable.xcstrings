    "Build anyway, recorded as untested. Corrupted graphics are a known risk.": {
      "comment": "SettingsEngineSection.swift:236",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build anyway, recorded as untested. Corrupted graphics are a known risk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Compila comunque, registrando la compilazione come non testata. Gli errori grafici sono un rischio noto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compiler quand même, avec enregistrement comme non testé. Des erreurs graphiques sont un risque connu."
