    },
    "The selected update is played as the whole game. If the game stops on missing files, add the base game’s dump (base/exefs and base/romfs).": {
      "comment": "AddGameView+Rows.swift:72",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected update is played as the whole game. If the game stops on missing files, add the base game’s dump (base/exefs and base/romfs)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’aggiornamento selezionato viene eseguito come gioco completo. Se il gioco si interrompe perché mancano dei file, aggiungi il dump del gioco base (base/exefs e base/romfs)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mise à jour sélectionnée est exécutée comme le jeu complet. Si le jeu s’arrête en raison de fichiers manquants, ajoutez la copie extraite du jeu de base (base/exefs et base/romfs)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ausgewählte Update wird als vollständiges Spiel ausgeführt. Falls das Spiel wegen fehlender Dateien abbricht, füge den Dump des Basisspiels hinzu (base/exefs und base/romfs)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La actualización seleccionada se ejecuta como el juego completo. Si el juego se detiene por falta de archivos, añade el volcado del juego base (base/exefs y base/romfs)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A atualização selecionada é usada como jogo completo. Se o jogo parar por falta de arquivos, adicione a cópia extraída do jogo base (base/exefs e base/romfs)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选更新会作为完整游戏运行。如果游戏因缺少文件而停止，请添加本体游戏的转储（base/exefs 和 base/romfs）。"
          }
        }
      }
    },
    "The selected update is played as the whole game. If the game stops on missing files, use a NUP that includes the base game.": {
      "comment": "AddGameView+Rows.swift:73",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected update is played as the whole game. If the game stops on missing files, use a NUP that includes the base game."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’aggiornamento selezionato viene eseguito come gioco completo. Se il gioco si interrompe perché mancano dei file, usa un NUP che includa il gioco base."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mise à jour sélectionnée est exécutée comme le jeu complet. Si le jeu s’arrête en raison de fichiers manquants, utilisez un NUP qui inclut le jeu de base."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ausgewählte Update wird als vollständiges Spiel ausgeführt. Falls das Spiel wegen fehlender Dateien abbricht, verwende eine NUP-Datei, die das Basisspiel enthält."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La actualización seleccionada se ejecuta como el juego completo. Si el juego se detiene por falta de archivos, usa un NUP que incluya el juego base."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A atualização selecionada é usada como jogo completo. Se o jogo parar por falta de arquivos, use um NUP que inclua o jogo base."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选更新会作为完整游戏运行。如果游戏因缺少文件而停止，请使用包含本体游戏的 NUP。"
          }
        }
      }
    },
