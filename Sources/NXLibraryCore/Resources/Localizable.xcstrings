    }},
    "Choose offline or local play to use this name.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"Choose offline or local play to use this name."}}, "fr": {"stringUnit":{"state":"translated","value":"Choisissez le jeu hors ligne ou local pour utiliser ce nom."}}, "it": {"stringUnit":{"state":"translated","value":"Scegli il gioco offline o locale per usare questo nome."}}, "de": {"stringUnit":{"state":"translated","value":"Wähle Offline- oder lokales Spiel, um diesen Namen zu verwenden."}}, "es": {"stringUnit":{"state":"translated","value":"Elige jugar sin conexión o en local para usar este nombre."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Escolha jogar offline ou localmente para usar esse nome."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"选择离线或本地游戏才能使用此名称。"}}
    }},
