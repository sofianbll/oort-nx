    "The build result is kept for this session. Free space if needed, then retry saving before closing Arcane.": {
      "comment": "Catalog activation and recovery",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The build result is kept for this session. Free space if needed, then retry saving before closing Arcane."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il risultato della build viene conservato per questa sessione. Libera spazio se necessario, poi ritenta il salvataggio prima di chiudere Arcane."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le résultat de la compilation est conservé pour cette session. Libérez de l’espace si nécessaire, puis réessayez d’enregistrer avant de fermer Arcane."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Build-Ergebnis bleibt für diese Sitzung erhalten. Gib bei Bedarf Speicherplatz frei und versuche das Speichern erneut, bevor du Arcane schließt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El resultado de la compilación se conserva durante esta sesión. Libera espacio si es necesario y vuelve a guardarlo antes de cerrar Arcane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O resultado da compilação será mantido nesta sessão. Libere espaço se necessário e tente salvar novamente antes de fechar o Arcane."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "构建结果在本次会话中保留。如有需要请释放空间，然后在关闭 Arcane 前重试保存。"
          }
        }
      }
    },
