          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attenzione allo spazio: questa build richiede circa %@ liberi (il doppio delle sorgenti selezionate più 10 GB), ma sono disponibili solo %@. Libera almeno %@ prima di avviarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attention au stockage : il faut environ %@ libres pour compiler (deux fois les sources sélectionnées plus 10 Go), mais seulement %@ sont disponibles. Libérez au moins %@ avant de compiler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speicherwarnung: Dieser Build benötigt etwa %@ freien Speicher (das Doppelte der ausgewählten Quelldateien plus 10 GB), aber nur %@ sind verfügbar. Gib vor dem Build mindestens %@ frei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Advertencia de espacio: esta compilación necesita unos %@ libres (el doble de los archivos seleccionados más 10 GB), pero solo hay %@ disponibles. Libera al menos %@ antes de compilar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aviso de espaço: esta compilação precisa de cerca de %@ livres (o dobro dos arquivos selecionados mais 10 GB), mas só há %@ disponíveis. Libere pelo menos %@ antes de compilar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
