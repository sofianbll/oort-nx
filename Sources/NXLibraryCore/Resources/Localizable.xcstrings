        "es": {"stringUnit": {"state": "translated", "value": "Adaptador de red"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Adaptador de rede"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "网络适配器"}}
      }
    },
    "Choose how your ported games connect to other players.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Choose how your ported games connect to other players."}},
        "it": {"stringUnit": {"state": "translated", "value": "Scegli come connettere i giochi portati agli altri giocatori."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Choisissez comment vos jeux portés se connectent aux autres joueurs."}},
        "de": {"stringUnit": {"state": "translated", "value": "Wähle, wie sich portierte Spiele mit anderen Spielern verbinden."}},
        "es": {"stringUnit": {"state": "translated", "value": "Elige cómo se conectan tus juegos portados con otros jugadores."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Escolha como seus jogos portados se conectam a outros jogadores."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "选择移植游戏连接其他玩家的方式。"}}
      }
    },
    "Use ZeroTier, Tailscale or NetBird for local play away from home.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Use ZeroTier, Tailscale or NetBird for local play away from home."}},
        "it": {"stringUnit": {"state": "translated", "value": "Usa ZeroTier, Tailscale o NetBird per giocare in locale a distanza."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Utilisez ZeroTier, Tailscale ou NetBird pour jouer en local à distance."}},
        "de": {"stringUnit": {"state": "translated", "value": "Nutze ZeroTier, Tailscale oder NetBird für lokales Spielen aus der Ferne."}},
        "es": {"stringUnit": {"state": "translated", "value": "Usa ZeroTier, Tailscale o NetBird para jugar en local a distancia."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Use ZeroTier, Tailscale ou NetBird para jogar em rede local a distância."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "通过 ZeroTier、Tailscale 或 NetBird 远程进行本地联机。"}}
      }
    },
    "Applies to games without their own multiplayer choice.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Applies to games without their own multiplayer choice."}},
        "it": {"stringUnit": {"state": "translated", "value": "Vale per i giochi senza una scelta specifica per il multigiocatore."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Pour les jeux sans choix multijoueur propre."}},
        "de": {"stringUnit": {"state": "translated", "value": "Gilt für Spiele ohne eigene Mehrspieler-Einstellung."}},
        "es": {"stringUnit": {"state": "translated", "value": "Se aplica a juegos sin un modo multijugador propio."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Vale para jogos sem um modo multijogador escolhido."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "适用于未单独设置多人模式的游戏。"}}
      }
    },
    "Force LAN or local wireless instead of letting the game choose.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Force LAN or local wireless instead of letting the game choose."}},
        "it": {"stringUnit": {"state": "translated", "value": "Forza LAN o comunicazione locale invece di far scegliere al gioco."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Forcez le LAN ou le sans-fil local au lieu de laisser le jeu choisir."}},
        "de": {"stringUnit": {"state": "translated", "value": "Erzwinge LAN oder lokales Drahtlosspiel, statt das Spiel wählen zu lassen."}},
        "es": {"stringUnit": {"state": "translated", "value": "Fuerza LAN o comunicación local en vez de dejar que el juego elija."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Force LAN ou comunicação local em vez de deixar o jogo escolher."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "强制使用局域网或本地无线，不由游戏选择。"}}
      }
    },
    "Select an interface manually if Arcane cannot identify your VPN.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Select an interface manually if Arcane cannot identify your VPN."}},
        "it": {"stringUnit": {"state": "translated", "value": "Scegli l’interfaccia a mano se Arcane non riconosce la VPN."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Choisissez l’interface à la main si Arcane ne reconnaît pas votre VPN."}},
        "de": {"stringUnit": {"state": "translated", "value": "Wähle die Schnittstelle manuell, wenn Arcane dein VPN nicht erkennt."}},
        "es": {"stringUnit": {"state": "translated", "value": "Elige la interfaz manualmente si Arcane no reconoce tu VPN."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Escolha a interface manualmente se o Arcane não reconhecer sua VPN."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "如果 Arcane 无法识别 VPN，请手动选择网络接口。"}}
      }
    },
    "Choose the network adapter in Advanced.": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Choose the network adapter in Advanced."}},
        "it": {"stringUnit": {"state": "translated", "value": "Scegli la scheda di rete nelle impostazioni avanzate."}},
