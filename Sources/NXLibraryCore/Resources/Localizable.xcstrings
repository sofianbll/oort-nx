    "This rclone uses a separate configuration. Choose a copy that uses your existing Drive settings.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"This rclone uses a separate configuration. Choose a copy that uses your existing Drive settings."}}, "fr": {"stringUnit":{"state":"translated","value":"Ce rclone utilise une configuration distincte. Choisissez une copie qui reprend vos réglages Drive actuels."}}, "it": {"stringUnit":{"state":"translated","value":"Questo rclone usa una configurazione separata. Scegli una copia che usi le impostazioni Drive esistenti."}}, "de": {"stringUnit":{"state":"translated","value":"Dieses rclone hat eine eigene Konfiguration. Wähle eine Kopie mit deinen bisherigen Drive-Einstellungen."}}, "es": {"stringUnit":{"state":"translated","value":"Este rclone usa una configuración distinta. Elige una copia que use tus ajustes de Drive actuales."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Este rclone usa uma configuração separada. Escolha uma cópia que use suas configurações atuais do Drive."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"此 rclone 使用独立配置。请选择使用你现有 Drive 设置的副本。"}}
    }},
    "Download rclone": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"Download rclone"}}, "fr": {"stringUnit":{"state":"translated","value":"Télécharger rclone"}}, "it": {"stringUnit":{"state":"translated","value":"Scarica rclone"}}, "de": {"stringUnit":{"state":"translated","value":"rclone herunterladen"}}, "es": {"stringUnit":{"state":"translated","value":"Descargar rclone"}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Baixar o rclone"}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"下载 rclone"}}
    }},
    "Oort NX will download rclone %@ from %@ (%@ MB, MIT licence).": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"Oort NX will download rclone %@ from %@ (%@ MB, MIT licence)."}}, "fr": {"stringUnit":{"state":"translated","value":"Oort NX téléchargera rclone %@ depuis %@ (%@ Mo, licence MIT)."}}, "it": {"stringUnit":{"state":"translated","value":"Oort NX scaricherà rclone %@ da %@ (%@ MB, licenza MIT)."}}, "de": {"stringUnit":{"state":"translated","value":"Oort NX lädt rclone %@ von %@ herunter (%@ MB, MIT-Lizenz)."}}, "es": {"stringUnit":{"state":"translated","value":"Oort NX descargará rclone %@ desde %@ (%@ MB, licencia MIT)."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Oort NX baixará o rclone %@ de %@ (%@ MB, licença MIT)."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"Oort NX 将从 %2$@ 下载 rclone %1$@（%3$@ MB，MIT 许可）。"}}
    }},
    "rclone is the open-source tool that reads and writes files in your own Google Drive; nothing is sent to Oort NX.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"rclone is the open-source tool that reads and writes files in your own Google Drive; nothing is sent to Oort NX."}},
      "fr": {"stringUnit":{"state":"translated","value":"rclone est l’outil libre qui lit et écrit des fichiers dans votre propre Google Drive ; rien n’est envoyé à Oort NX."}},
      "it": {"stringUnit":{"state":"translated","value":"rclone è lo strumento open source che legge e scrive file nel tuo Google Drive; nulla viene inviato a Oort NX."}},
      "de": {"stringUnit":{"state":"translated","value":"rclone ist das Open-Source-Werkzeug, das Dateien in deinem eigenen Google Drive liest und schreibt; an Oort NX wird nichts gesendet."}},
      "es": {"stringUnit":{"state":"translated","value":"rclone es la herramienta de código abierto que lee y escribe archivos en tu propio Google Drive; no se envía nada a Oort NX."}},
      "pt-BR": {"stringUnit":{"state":"translated","value":"O rclone é a ferramenta de código aberto que lê e grava arquivos no seu próprio Google Drive; nada é enviado ao Oort NX."}},
      "zh-Hans": {"stringUnit":{"state":"translated","value":"rclone 是在你自己的 Google 云端硬盘中读写文件的开源工具，不会向 Oort NX 发送任何内容。"}}
    }},
    "Use the rclone already on this Mac to reconnect to the same cloud library without moving your files?": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"Use the rclone already on this Mac to reconnect to the same cloud library without moving your files?"}}, "fr": {"stringUnit":{"state":"translated","value":"Utiliser le rclone déjà présent sur ce Mac pour retrouver la même bibliothèque cloud sans déplacer vos fichiers ?"}}, "it": {"stringUnit":{"state":"translated","value":"Usare rclone già presente su questo Mac per riconnettersi alla stessa libreria cloud senza spostare i file?"}}, "de": {"stringUnit":{"state":"translated","value":"Das vorhandene rclone nutzen, um dieselbe Cloud-Bibliothek zu verbinden, ohne Dateien zu verschieben?"}}, "es": {"stringUnit":{"state":"translated","value":"¿Usar el rclone de este Mac para reconectar la misma biblioteca en la nube sin mover tus archivos?"}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Usar o rclone deste Mac para reconectar a mesma biblioteca na nuvem sem mover seus arquivos?"}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"使用此 Mac 上已有的 rclone 重新连接到原来的云游戏库，不移动文件吗？"}}
    }},
    "Use existing rclone": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"Use existing rclone"}}, "fr": {"stringUnit":{"state":"translated","value":"Utiliser le rclone déjà présent"}}, "it": {"stringUnit":{"state":"translated","value":"Usa rclone esistente"}}, "de": {"stringUnit":{"state":"translated","value":"Vorhandenes rclone nutzen"}}, "es": {"stringUnit":{"state":"translated","value":"Usar el rclone disponible"}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Usar o rclone existente"}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"使用已有的 rclone"}}
    }},
    "Choose your own rclone or let Oort NX download it when you turn on Drive.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"Choose your own rclone or let Oort NX download it when you turn on Drive."}}, "fr": {"stringUnit":{"state":"translated","value":"Choisissez votre rclone ou laissez Oort NX le télécharger à l’activation de Drive."}}, "it": {"stringUnit":{"state":"translated","value":"Scegli il tuo rclone o lascia che Oort NX lo scarichi quando attivi Drive."}}, "de": {"stringUnit":{"state":"translated","value":"Wähle dein rclone oder lass es beim Einschalten von Drive durch Oort NX herunterladen."}}, "es": {"stringUnit":{"state":"translated","value":"Elige tu rclone o deja que Oort NX lo descargue al activar Drive."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Escolha seu rclone ou deixe o Oort NX baixá-lo ao ativar o Drive."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"选择自己的 rclone，或让 Oort NX 在启用 Drive 时下载。"}}
    }},
    "Downloading rclone…": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"Downloading rclone…"}}, "fr": {"stringUnit":{"state":"translated","value":"Téléchargement de rclone…"}}, "it": {"stringUnit":{"state":"translated","value":"Scaricamento di rclone…"}}, "de": {"stringUnit":{"state":"translated","value":"rclone wird heruntergeladen…"}}, "es": {"stringUnit":{"state":"translated","value":"Descargando rclone…"}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Baixando o rclone…"}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"正在下载 rclone…"}}
    }},
    "Drive is waiting for rclone.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"Drive is waiting for rclone."}}, "fr": {"stringUnit":{"state":"translated","value":"Drive attend rclone."}}, "it": {"stringUnit":{"state":"translated","value":"Drive è in attesa di rclone."}}, "de": {"stringUnit":{"state":"translated","value":"Drive wartet auf rclone."}}, "es": {"stringUnit":{"state":"translated","value":"Drive está esperando a rclone."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"O Drive está aguardando o rclone."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"Drive 正在等待 rclone。"}}
    }},
    "Oort NX’s copy of rclone": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"Oort NX’s copy of rclone"}}, "fr": {"stringUnit":{"state":"translated","value":"Copie de rclone d’Oort NX"}}, "it": {"stringUnit":{"state":"translated","value":"Copia di rclone di Oort NX"}}, "de": {"stringUnit":{"state":"translated","value":"rclone-Kopie von Oort NX"}}, "es": {"stringUnit":{"state":"translated","value":"Copia de rclone de Oort NX"}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Cópia do rclone do Oort NX"}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"Oort NX 的 rclone 副本"}}
    }},
    "Only Oort NX’s download is moved to the Trash; other copies stay in place.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"Only Oort NX’s download is moved to the Trash; other copies stay in place."}}, "fr": {"stringUnit":{"state":"translated","value":"Seule la copie téléchargée par Oort NX va à la Corbeille ; les autres restent en place."}}, "it": {"stringUnit":{"state":"translated","value":"Solo la copia scaricata da Oort NX finisce nel Cestino; le altre restano dove sono."}}, "de": {"stringUnit":{"state":"translated","value":"Nur der Download von Oort NX landet im Papierkorb; andere Kopien bleiben erhalten."}}, "es": {"stringUnit":{"state":"translated","value":"Solo la copia descargada por Oort NX va a la papelera; las demás se conservan."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Só o download do Oort NX vai para o Lixo; as outras cópias permanecem no lugar."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"只将 Oort NX 下载的副本移到废纸篓，其他副本保留在原处。"}}
    }},
    "Turn off and trash": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"Turn off and trash"}}, "fr": {"stringUnit":{"state":"translated","value":"Désactiver et mettre à la Corbeille"}}, "it": {"stringUnit":{"state":"translated","value":"Disattiva e cestina"}}, "de": {"stringUnit":{"state":"translated","value":"Ausschalten und in den Papierkorb"}}, "es": {"stringUnit":{"state":"translated","value":"Desactivar y enviar a la papelera"}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Desativar e mover para o Lixo"}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"关闭并移到废纸篓"}}
    }},
    "Could not reach the rclone download server. Check your connection and retry.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"Could not reach the rclone download server. Check your connection and retry."}}, "fr": {"stringUnit":{"state":"translated","value":"Serveur de téléchargement de rclone inaccessible. Vérifiez votre connexion et réessayez."}}, "it": {"stringUnit":{"state":"translated","value":"Server di download di rclone non raggiungibile. Controlla la connessione e riprova."}}, "de": {"stringUnit":{"state":"translated","value":"Der Downloadserver von rclone ist nicht erreichbar. Prüfe deine Verbindung und versuche es erneut."}}, "es": {"stringUnit":{"state":"translated","value":"No se pudo contactar con el servidor de descarga de rclone. Revisa tu conexión y vuelve a intentarlo."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Não foi possível acessar o servidor de download do rclone. Verifique a conexão e tente novamente."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"无法连接到 rclone 下载服务器。请检查网络连接后重试。"}}
    }},
    "The official rclone download did not complete. Retry.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"The official rclone download did not complete. Retry."}}, "fr": {"stringUnit":{"state":"translated","value":"Le téléchargement officiel de rclone n’a pas abouti. Réessayez."}}, "it": {"stringUnit":{"state":"translated","value":"Download ufficiale di rclone non completato. Riprova."}}, "de": {"stringUnit":{"state":"translated","value":"Der offizielle rclone-Download wurde nicht abgeschlossen. Versuche es erneut."}}, "es": {"stringUnit":{"state":"translated","value":"La descarga oficial de rclone no se completó. Vuelve a intentarlo."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"O download oficial do rclone não foi concluído. Tente novamente."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"rclone 官方下载未完成，请重试。"}}
    }},
    "The rclone download could not be verified. Nothing was installed.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"The rclone download could not be verified. Nothing was installed."}}, "fr": {"stringUnit":{"state":"translated","value":"Le téléchargement de rclone n’a pas pu être vérifié. Rien n’a été installé."}}, "it": {"stringUnit":{"state":"translated","value":"Impossibile verificare il download di rclone. Non è stato installato nulla."}}, "de": {"stringUnit":{"state":"translated","value":"Der rclone-Download konnte nicht geprüft werden. Es wurde nichts installiert."}}, "es": {"stringUnit":{"state":"translated","value":"No se pudo verificar la descarga de rclone. No se instaló nada."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Não foi possível verificar o download do rclone. Nada foi instalado."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"无法验证下载的 rclone，未安装任何内容。"}}
    }},
    "There is not enough space on this Mac to install rclone.": {"localizations": {
      "en": {"stringUnit":{"state":"translated","value":"There is not enough space on this Mac to install rclone."}}, "fr": {"stringUnit":{"state":"translated","value":"Ce Mac n’a pas assez d’espace pour installer rclone."}}, "it": {"stringUnit":{"state":"translated","value":"Su questo Mac non c’è spazio sufficiente per installare rclone."}}, "de": {"stringUnit":{"state":"translated","value":"Auf diesem Mac ist nicht genug Speicherplatz für rclone."}}, "es": {"stringUnit":{"state":"translated","value":"No hay espacio suficiente en este Mac para instalar rclone."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Não há espaço suficiente neste Mac para instalar o rclone."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"此 Mac 上没有足够的空间来安装 rclone。"}}
    }},
