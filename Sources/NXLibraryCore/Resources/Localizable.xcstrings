    },
    "The source files are missing. Attach or locate the original base, update and DLC files first.": {
      "comment": "NXLibraryError.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source files are missing. Attach or locate the original base, update and DLC files first."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file sorgente non sono disponibili. Prima collega o individua i file originali del gioco base, degli aggiornamenti e dei DLC."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers sources sont introuvables. Associez ou localisez d’abord les fichiers d’origine du jeu de base, des mises à jour et des DLC."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Quelldateien fehlen. Ordne zuerst die ursprünglichen Dateien für Basisspiel, Update und DLC zu oder suche sie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Faltan los archivos de origen. Primero vincula o localiza los archivos originales del juego base, las actualizaciones y los DLC."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos de origem não foram encontrados. Primeiro, vincule ou localize os arquivos originais do jogo base, das atualizações e dos DLCs."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "源文件缺失。请先附加或找到原始的本体、更新和 DLC 文件。"
          }
        }
      }
    },
    "Could not remove the original game files. %@": {
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Could not remove the original game files. %@"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Impossible de retirer les fichiers d’origine du jeu. %@"}},
