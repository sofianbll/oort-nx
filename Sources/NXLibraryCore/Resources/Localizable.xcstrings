    "Nintendo Switch cryptographic keys required to decrypt game packages (NSP/XCI). Arcane stores a private copy with mode 0600 permissions; key values are never displayed or logged.": {
      "comment": "SettingsEngineSection.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nintendo Switch cryptographic keys required to decrypt game packages (NSP/XCI). Arcane stores a private copy with mode 0600 permissions; key values are never displayed or logged."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiavi crittografiche Nintendo Switch necessarie per decrittare i pacchetti di gioco (NSP/XCI). Arcane ne conserva una copia privata con permessi 0600; i valori delle chiavi non vengono mai mostrati né registrati nei log."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clés cryptographiques Nintendo Switch nécessaires au déchiffrement des paquets de jeu (NSP/XCI). Arcane en conserve une copie privée avec des permissions 0600 ; les valeurs des clés ne sont jamais affichées ni inscrites dans les journaux."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kryptografische Nintendo Switch-Schlüssel zum Entschlüsseln von Spielpaketen (NSP/XCI). Arcane speichert eine private Kopie mit Zugriffsrechten 0600; Schlüsselwerte werden nie angezeigt oder protokolliert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Claves criptográficas de Nintendo Switch necesarias para descifrar paquetes de juegos (NSP/XCI). Arcane guarda una copia privada con permisos 0600; los valores de las claves nunca se muestran ni se escriben en los registros."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaves criptográficas do Nintendo Switch necessárias para descriptografar pacotes de jogos (NSP/XCI). O Arcane armazena uma cópia privada com permissões 0600; os valores das chaves nunca são exibidos nem registrados em logs."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解密游戏包（NSP/XCI）所需的 Nintendo Switch 加密密钥。Arcane 以 0600 权限保存一份私有副本；密钥值绝不会显示或写入日志。"
          }
        }
      }
    },
