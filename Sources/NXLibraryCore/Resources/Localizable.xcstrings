      "en": {"stringUnit":{"state":"translated","value":"Could not change Oort NX’s copy of rclone. Retry."}}, "fr": {"stringUnit":{"state":"translated","value":"Impossible de modifier la copie de rclone d’Oort NX. Réessayez."}}, "it": {"stringUnit":{"state":"translated","value":"Impossibile modificare la copia di rclone di Oort NX. Riprova."}}, "de": {"stringUnit":{"state":"translated","value":"Die rclone-Kopie von Oort NX konnte nicht geändert werden. Versuche es erneut."}}, "es": {"stringUnit":{"state":"translated","value":"No se pudo modificar la copia de rclone de Oort NX. Vuelve a intentarlo."}}, "pt-BR": {"stringUnit":{"state":"translated","value":"Não foi possível alterar a cópia do rclone do Oort NX. Tente novamente."}}, "zh-Hans": {"stringUnit":{"state":"translated","value":"无法更改 Oort NX 的 rclone 副本，请重试。"}}
