    "Some games tie their physics, animation speeds, or game loops to 30 FPS. If gameplay runs twice as fast or audio desyncs, keep this at 30.": {
      "comment": "SettingsGamesSection.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some games tie their physics, animation speeds, or game loops to 30 FPS. If gameplay runs twice as fast or audio desyncs, keep this at 30."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcuni giochi legano fisica, velocità delle animazioni o cicli di gioco ai 30 FPS. Se il gioco gira al doppio della velocità o l’audio perde la sincronizzazione, mantieni il valore a 30."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains jeux lient leur physique, la vitesse des animations ou leurs boucles de jeu à 30 FPS. Si le jeu tourne deux fois trop vite ou si le son se décale, conservez 30."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei manchen Spielen sind Physik, Animationsgeschwindigkeit oder Spielablauf an 30 FPS gebunden. Wenn das Spiel doppelt so schnell läuft oder der Ton nicht synchron ist, belasse den Wert bei 30."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos juegos vinculan la física, la velocidad de las animaciones o sus ciclos a 30 FPS. Si el juego va al doble de velocidad o el audio se desincroniza, mantenlo en 30."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns jogos vinculam a física, a velocidade das animações ou os ciclos do jogo a 30 FPS. Se o jogo rodar duas vezes mais rápido ou o áudio perder a sincronia, mantenha em 30."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有些游戏的物理、动画速度或游戏循环与 30 FPS 绑定。如果游戏运行速度翻倍或音频不同步，请保持 30。"
          }
        }
      }
    },
    "Some installations could not be checked. Your library has been kept.": {
      "comment": "Steam source management and native Mac library presentation.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some installations could not be checked. Your library has been kept."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile controllare alcune installazioni. La tua libreria è stata conservata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines installations n’ont pas pu être vérifiées. Votre bibliothèque a été conservée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Installationen konnten nicht geprüft werden. Deine Bibliothek bleibt erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron revisar algunas instalaciones. Tu biblioteca se ha conservado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas instalações não puderam ser verificadas. Sua biblioteca foi mantida."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分安装无法检查。你的游戏库已保留。"
          }
        }
      }
    },
    "Some launcher data could not be read. The original data has not been changed.": {
