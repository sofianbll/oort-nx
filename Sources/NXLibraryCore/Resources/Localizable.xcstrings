    "Nextendo online mode: Code mods don't load. Set Network to Offline to use them.": {
      "comment": "ModsPanel.swift: notice when a code mod is enabled in Nextendo online mode",
      "localizations": {
        "de": {"stringUnit": {"state": "translated", "value": "Nextendo-Online-Modus: Code-Mods werden nicht geladen. Stelle Netzwerk auf Offline, um sie zu verwenden."}},
        "en": {"stringUnit": {"state": "translated", "value": "Nextendo online mode: Code mods don't load. Set Network to Offline to use them."}},
        "es": {"stringUnit": {"state": "translated", "value": "Modo en línea de Nextendo: los mods de código no se cargan. Cambia Red a Sin conexión para usarlos."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Mode en ligne Nextendo : les mods de code ne se chargent pas. Passez le réseau en Hors ligne pour les utiliser."}},
        "it": {"stringUnit": {"state": "translated", "value": "Modalità online Nextendo: le mod di codice non vengono caricate. Imposta Rete su Offline per usarle."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Modo online do Nextendo: os mods de código não são carregados. Defina a Rede como Offline para usá-los."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "Nextendo 联机模式不会加载代码模组。若要使用，请将网络设为“离线”。"}}
