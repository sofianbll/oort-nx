    "Use the app's own folder?" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Use the app's own folder?" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Revenir au dossier de l’app ?" } }
      }
    },
    "Oort NX stops reading the folder you chose for this game. Nothing is deleted." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Oort NX stops reading the folder you chose for this game. Nothing is deleted." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Oort NX ne lit plus le dossier choisi pour ce jeu. Rien n’est supprimé." } }
      }
    },
    "Oort NX stops reading the folder you chose for every game. Nothing is deleted." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Oort NX stops reading the folder you chose for every game. Nothing is deleted." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Oort NX ne lit plus le dossier choisi pour tous les jeux. Rien n’est supprimé." } }
      }
    },
    "Stop following the folder?" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Stop following the folder?" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ne plus suivre le dossier ?" } }
      }
    },
    "Your saves stay on this device and in the folder. They no longer follow each other." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your saves stay on this device and in the folder. They no longer follow each other." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Tes sauvegardes restent sur cet appareil et dans le dossier. Elles ne se suivent plus." } }
      }
    },
    "Back to the buttons as printed?" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Back to the buttons as printed?" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Revenir aux boutons tels qu’imprimés ?" } }
      }
    },
    "Your changes to these buttons are lost." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your changes to these buttons are lost." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Tes changements sur ces boutons sont perdus." } }
      }
    },
    "This game's code could not be loaded. Build it again on your Mac, then add it again." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "This game's code could not be loaded. Build it again on your Mac, then add it again." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le code de ce jeu n’a pas pu être chargé. Recompile-le sur ton Mac, puis ajoute-le à nouveau." } }
      }
    },
    "This is an early version: Oort NX for Mac does not build games for iPhone and iPad yet." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "This is an early version: Oort NX for Mac does not build games for iPhone and iPad yet." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "C’est une première version : Oort NX pour Mac ne compile pas encore de jeu pour iPhone et iPad." } }
      }
    },
    "Matthew Silva, MIT. The theme Oort NX's look and sounds grew from." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Matthew Silva, MIT. The theme Oort NX's look and sounds grew from." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Matthew Silva, MIT. Le thème dont viennent l’allure et les sons d’Oort NX." } }
      }
    },
    "Every notice, in full" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Every notice, in full" } },
