views {
  view index {
    title "1 · Écosystème"
    description '''
      Traits pleins : intégré. Pointillés : cible ou essai sur une autre branche.
      Ouvrir Mac ou [[view:applications|les applications]] pour voir les modules.
    '''
    include oort with { navigateTo applications }
    include oort.* where kind is app
    include oort.mac with { navigateTo applications }
    include nxnative, ryujinx, drive
    rank same { nxnative, drive, ryujinx }
    autoLayout TopBottom 50 28
  }

  dynamic view applications {
    title "2 · Qui parle au moteur ?"
    description '''
      Givre : Oort · Or : interface et cœur moteur · Gris : moteurs externes · Pointillés : prévu.
      [[view:index|Écosystème]] · [[view:jouer|Jouer sur Mac]]
    '''
    include oort.mac with { title "Oort sur Mac"; summary "Intégré"; color givre }
    include oort.desktop with { title "Oort sur PC"; summary "Intégration Windows prévue"; color givre }
    include oort.OortCore.engineInterface with { summary "Lecture de l’état sur Mac"; color amber; navigateTo domains }
    include nxnative with { summary "Moteur Switch sur Mac" }
    include ryujinx with { title "Ryujinx (prévu)"; summary "Moteur Switch visé sur PC" }
    oort.mac -> oort.OortCore.engineInterface "Demande"
    oort.OortCore.engineInterface -> nxnative "Lit l’état" { technology "via l’adaptateur nxnative" }
    oort.desktop -[prevu]-> oort.OortCore.engineInterface "Demande"
    oort.OortCore.engineInterface -[prevu]-> ryujinx "Lance"
    autoLayout LeftRight 75 35
  }

  view domains of oort {
    title "3 · Qui possède quoi ?"
    description '''
      Givre : Oort · Or : interface et cœur moteur · Gris : moteurs externes · Pointillés : prévu.
      [[view:applications|Qui parle au moteur ?]]
    '''
    include oort.NXLibraryCore with { title "Lanceur Oort"; color givre }
    include oort.NXLibraryCore.* where kind is domain with { color givre }
    include oort.OortCore.engine with { title "Cœur moteur"; color amber }
    include oort.mac.ArcanePorting.saves with { title "Sauvegardes Switch"; summary "Copie et restauration · ArcanePorting"; color givre }
    exclude * -> *
    include oort.NXLibraryCore.cloud -> oort.NXLibraryCore.library with { title "Alimente" }
    include oort.NXLibraryCore.play -> oort.NXLibraryCore.library with { title "Associe les parties" }
    exclude oort, oort.OortCore, oort.mac, oort.mac.ArcanePorting
    autoLayout LeftRight 40 25
  }

  dynamic view jouer {
    variant sequence
    title "Jouer sur Mac"
    description '''
      Jeu Switch déjà préparé. La remise du jeu ne prouve pas qu’une partie a été observée.
      [[view:domains|Domaines]]
    '''
    oort.mac.NXLibrary -> oort.mac.ArcanePorting.nxAdapter "Demande de jouer"
    oort.mac.NXLibrary <- oort.mac.ArcanePorting.nxAdapter "Résultat de la remise" { line dashed }
    oort.mac.NXLibrary -> oort.NXLibraryCore.play "Si observée : enregistre la partie"
  }
}
