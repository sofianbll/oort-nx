// The repository's folders, declared once. scripts/check_structure.py reads every `path` and the root `files`
// and refuses a first- or second-level folder, or a root file, that is not declared here. A folder marked
// `markdown "yes"` may hold documentation; scripts/check_docs.py refuses a .md file anywhere else.
// Update this model in the same change as the folders.
specification {
  element repository { style { color slate; border dashed; opacity 8% } }
  element folder { style { color slate; size sm } }
}

model {
  repo = repository "oort-nx" {
    summary "What main holds today"
    metadata {
      files "AGENTS.md CHANGELOG.md CODE_OF_CONDUCT.md CONTRIBUTING.md DESIGN.md GLOSSARY.md LICENSE NOTICE PLAYER-GUIDE.fr.md PLAYER-GUIDE.md PRODUCT.md Package.swift README.fr.md README.md SECURITY.md VERSION .gitattributes .gitignore"
      markdown "yes"
    }


    core = folder "core/" {
      summary "The core: states, rules and screen descriptions, in Swift"
      metadata { path "core" }
      coreOortCore = folder "OortCore/" { metadata { path "core/OortCore" } }
      coreLibrary = folder "OortLibrary/" { metadata { path "core/OortLibrary" } }
      coreTests = folder "Tests/" { metadata { path "core/Tests" } }
    }

    engines = folder "engines/" {
      summary "One adapter per engine, behind the engine interface of the core"
      metadata { path "engines" }
      engineNxnative = folder "nxnative/" { metadata { path "engines/nxnative" } }
    }

    apps = folder "apps/" {
      summary "The apps: the shell of each system"
      metadata { path "apps" }
      appMac = folder "mac/" { metadata { path "apps/mac" } }
    }

    tests = folder "Tests/" {
      summary "Swift tests, app probes, Python checks"
      metadata { path "Tests" }
      testUIRules = folder "UIRulesChecks/" { metadata { path "Tests/UIRulesChecks" } }
    }

    resources = folder "Resources/" {
      summary "Icons, brands, Selene media, sounds, third-party licences"
      metadata {
        path "Resources"
        markdown "yes"
      }
      resIcon = folder "AppIcon.icon/" { metadata { path "Resources/AppIcon.icon" } }
      resIconParticles = folder "AppIconParticles.icon/" { metadata { path "Resources/AppIconParticles.icon" } }
      resBrands = folder "Brands/" { metadata { path "Resources/Brands" } }
      resSelene = folder "Selene/" { metadata { path "Resources/Selene" } }
      resSounds = folder "SoundPacks/" { metadata { path "Resources/SoundPacks" } }
      resLicences = folder "ThirdPartyLicenses/" { metadata { path "Resources/ThirdPartyLicenses" } }
    }

    design = folder "design/" {
      summary "Tokens, vocabulary, credits"
      metadata { path "design" }
    }

    docs = folder "docs/" {
      summary "Public documentation, guides, history"
      metadata {
        path "docs"
        markdown "yes"
      }
      docAdr = folder "adr/" { metadata { path "docs/adr" } }
      docGuides = folder "guides/" { metadata { path "docs/guides" } }
      docHistory = folder "history/" { metadata { path "docs/history" } }
      docHowItWorks = folder "how-it-works/" { metadata { path "docs/how-it-works" } }
      docMedia = folder "media/" { metadata { path "docs/media" } }
      docWorkingOnIt = folder "working-on-it/" { metadata { path "docs/working-on-it" } }
    }

    architecture = folder "architecture/" {
      summary "This model"
      metadata { path "architecture" }
    }

    scripts = folder "scripts/" {
      summary "check, generate and the scripts they run"
      metadata { path "scripts" }
      scriptTests = folder "tests/" { metadata { path "scripts/tests" } }
    }

    github = folder ".github/" {
      summary "CI, issue forms"
      metadata {
        path ".github"
        markdown "yes"
      }
      ghTemplates = folder "ISSUE_TEMPLATE/" { metadata { path ".github/ISSUE_TEMPLATE" } }
      ghWorkflows = folder "workflows/" { metadata { path ".github/workflows" } }
    }

    agents = folder ".agents/" {
      summary "Repository skills"
      metadata {
        path ".agents"
        markdown "yes"
      }
      agentSkills = folder "skills/" { metadata { path ".agents/skills" } }
    }
  }
}

views {
  view structure of repo {
    title "4 · Le dépôt aujourd’hui"
    description '''
      Every first-level folder of main. A folder or root file missing here fails scripts/check (R1).
      [[view:index|Écosystème]]
    '''
    include repo, repo.*
    autoLayout TopBottom 50 30
  }
}
